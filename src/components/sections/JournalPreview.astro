---
/**
 * JOURNAL — horizontal filmstrip of guide covers.
 *
 * The gallery used to be a GSAP-pinned filmstrip and was removed because it
 * swallowed ~4,700px of vertical scroll and the page felt stuck. This one does
 * not repeat that: it is a native overflow-x container on the shared
 * .carousel-track convention from global.css. Vertical scroll is never touched
 * — the page passes it at normal speed and the strip moves only on a horizontal
 * gesture, a drag, the arrows, or arrow keys.
 *
 * Palette, radii and type are the ones the other homepage sections already use
 * (#E8B86D / #F3D5A0 / #F0F0F6 / #9DA0B8 / #8288A5 / #06060A, 4px, hairlines at
 * rgba(255,255,255,.08)). global.css defines tokens but no section in this layer
 * consumes them, so converting only this file would make it the odd one out.
 *
 * Order is editorial, not chronological: `featured` exists in the schema for
 * this and ArticleNav already honours it, while five articles share one publish
 * date. The blog index stays chronological.
 */
import { t, type Lang } from '../../i18n/ui';
import { getBlogPosts } from '../../lib/content';
interface Props { lang: Lang; limit?: number; }
const { lang, limit = 6 } = Astro.props;
const tr = (k: string) => t(lang, k as any);
const en = lang === 'en';

const posts = (await getBlogPosts(lang))
  .sort((a, b) =>
    (b.data.featured ?? 0) - (a.data.featured ?? 0) ||
    new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime()
  )
  .slice(0, limit);

const fmtDate = (d: string) =>
  new Date(d).toLocaleDateString(en ? 'en-GB' : 'ru-RU', { day: 'numeric', month: 'short', year: 'numeric' });

const postHref = (slug: string) => en ? `/en/blog/${slug}` : `/ru/blog/${slug}`;

/* One topic chip per card. tags[0] printed "строительство" on most of them —
   every guide here is about building, so the shared tag says nothing. Take the
   first tag no earlier card has claimed: цены, налоги, энергоэффективность. */
const seen = new Set<string>();
const topics = posts.map(p => {
  const tag = (p.data.tags ?? []).find(x => !seen.has(x)) ?? p.data.tags?.[0] ?? '';
  if (tag) seen.add(tag);
  return tag;
});
---

<section id="journal" class="jp-section">
  <div class="container-wide">
    <div class="jp-head">
      <div>
        <p class="cine-label" data-reveal>
          <span class="cine-label__index">{en ? 'The journal' : 'Журнал'}</span>
          {en ? 'Guides & costs' : 'Гайды и цены'}
        </p>
        <h2 class="cine-display jp-title" data-words>
          {en
            ? <>Know before <em>you build.</em></>
            : <>Знайте <em>до стройки.</em></>}
        </h2>
      </div>

      <div class="jp-controls" data-reveal>
        <button type="button" class="jp-arrow" data-jp-prev
                aria-label={en ? 'Previous guides' : 'Предыдущие материалы'}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" d="M19 12H5M12 19l-7-7 7-7"/></svg>
        </button>
        <button type="button" class="jp-arrow" data-jp-next
                aria-label={en ? 'More guides' : 'Следующие материалы'}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
        <a href={en ? '/en/blog' : '/ru/blog'} class="jp-all">
          {tr('blog.allPosts')}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>

    <div
      class="carousel-track jp-track"
      data-jp-track
      data-lenis-prevent
      tabindex="0"
      role="region"
      aria-label={en ? 'Guides, horizontal list' : 'Материалы журнала, горизонтальный список'}
    >
      {posts.map((post, i) => (
        <a href={postHref(post.slug)} class="jp-card">
          <span class="jp-card-img cine-scene">
            {post.data.ogImage && (
              <img src={post.data.ogImage} alt={post.data.title} width="480" height="640" loading="lazy" decoding="async" />
            )}
            <span class="jp-card-scrim" aria-hidden="true"></span>
            {topics[i] && <span class="jp-chip">{topics[i]}</span>}
            <span class="jp-card-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </span>
          <span class="jp-card-title">{post.data.title}</span>
          <span class="jp-card-meta">
            <time datetime={post.data.publishedDate}>{fmtDate(post.data.publishedDate)}</time>
            {post.data.minuteRead && <span>· {post.data.minuteRead} {tr('blog.minRead')}</span>}
          </span>
        </a>
      ))}
      <span class="jp-tail" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
.jp-section {
  padding: 6.5rem 0;
  background: #06060A;
  border-bottom: 1px solid rgba(255,255,255,.06);
  overflow: hidden; /* contains the right-edge bleed below */
}
.jp-head {
  display: flex; align-items: flex-end; justify-content: space-between;
  gap: 2rem; flex-wrap: wrap; margin-bottom: 2.6rem;
}
.jp-title { margin: 1.2rem 0 0; font-size: clamp(2rem, 4.2vw, 3.6rem); }

.jp-controls { display: inline-flex; align-items: center; gap: .6rem; }
.jp-arrow {
  display: inline-flex; align-items: center; justify-content: center;
  width: 2.6rem; height: 2.6rem;
  color: #E8B86D; background: transparent;
  border: 1px solid rgba(232,184,109,.28); border-radius: 4px;
  cursor: pointer;
  transition: background .2s ease, border-color .2s ease, color .2s ease, opacity .2s ease;
}
.jp-arrow:hover:not(:disabled) { background: rgba(232,184,109,.08); border-color: #E8B86D; color: #F3D5A0; }
.jp-arrow:disabled { opacity: .28; cursor: default; }
.jp-all {
  display: inline-flex; align-items: center; gap: .55rem;
  font-family: 'Jost Variable', system-ui, sans-serif;
  font-size: .95rem; font-weight: 400; text-transform: lowercase;
  color: #E8B86D; text-decoration: none;
  border: 1px solid #E8B86D; border-radius: 4px;
  padding: .6rem 1.3rem; margin-left: .4rem;
}
.jp-all svg { transition: transform .25s cubic-bezier(.16,1,.3,1); }
.jp-all:hover { background: rgba(232,184,109,.08); color: #F3D5A0; }
.jp-all:hover svg { transform: translateX(3px); }

/* ── The strip ──
   Bleeds to the viewport's right edge so the row reads as continuing past the
   fold; the left edge stays on the container grid with everything else. */
.jp-track {
  margin-right: calc(50% - 50vw);
  padding-right: 8vw;
  scroll-padding-left: 0;
  cursor: grab;
}
.jp-track.is-dragging { cursor: grabbing; scroll-snap-type: none; }
.jp-track.is-dragging a { pointer-events: none; }
.jp-track:focus-visible { outline: 1px solid rgba(232,184,109,.5); outline-offset: 6px; }
/* Keeps the final card clear of the bleed padding when it snaps. */
.jp-tail { flex: 0 0 1px; }

/* ── Card ── */
.jp-card {
  display: flex; flex-direction: column; gap: .85rem;
  width: clamp(228px, 23vw, 292px);
  text-decoration: none;
}
.jp-card-img {
  display: block; aspect-ratio: 3 / 4;
  border-radius: 4px; border: 1px solid rgba(255,255,255,.08);
}
.jp-card-img img {
  filter: saturate(.9) brightness(.92);
  transition: transform .7s cubic-bezier(.16,1,.3,1), filter .35s ease;
}
.jp-card:hover .jp-card-img img { transform: scale(1.04); filter: none; }
/* The covers run light at the top and bottom; the chip and the number need
   their own ground to stay legible over them. */
.jp-card-scrim {
  position: absolute; inset: 0; pointer-events: none;
  background: linear-gradient(180deg, rgba(6,6,10,.62) 0%, rgba(6,6,10,0) 38%, rgba(6,6,10,.10) 100%);
}
.jp-chip {
  position: absolute; top: .85rem; left: .85rem;
  display: inline-flex; align-items: center;
  font-family: 'Jost Variable', system-ui, sans-serif;
  font-size: .68rem; letter-spacing: .12em; text-transform: uppercase;
  color: #F3D5A0;
  border: 1px solid rgba(232,184,109,.28); border-radius: 2px;
  padding: .18rem .45rem;
  background: rgba(6,6,10,.45);
}
.jp-card-n {
  position: absolute; top: .8rem; right: .95rem;
  font-family: 'Spectral', Georgia, serif; font-weight: 300;
  font-size: 1rem; color: rgba(232,184,109,.65);
  font-variant-numeric: tabular-nums;
}

.jp-card-title {
  font-family: 'Spectral', Georgia, serif; font-weight: 400;
  font-size: 1.12rem; line-height: 1.28; letter-spacing: -.01em;
  color: #F0F0F6;
  transition: color .18s ease;
  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
  overflow: hidden;
}
.jp-card:hover .jp-card-title { color: #E8B86D; }
.jp-card-meta {
  font-family: 'Jost Variable', system-ui, sans-serif;
  font-size: .78rem; color: #8288A5; text-transform: lowercase;
  font-variant-numeric: tabular-nums;
  margin-top: auto;
  padding-top: .55rem;
  border-top: 1px solid rgba(255,255,255,.08);
}

@media (max-width: 760px) {
  .jp-section { padding: 4rem 0; }
  .jp-head { margin-bottom: 1.8rem; gap: 1.2rem; }
  .jp-controls { width: 100%; }
  .jp-all { margin-left: auto; }
  .jp-track { padding-right: 12vw; }
  .jp-card { width: 70vw; max-width: 300px; }
}
@media (prefers-reduced-motion: reduce) {
  .jp-card:hover .jp-card-img img { transform: none; }
}
</style>

<script>
  /* Arrows, drag-to-scroll and the disabled states for the strip. Native
     horizontal wheel/touch gestures already work through overflow-x, so this
     only adds the mouse affordances a desktop visitor expects. */
  function initJournalStrip() {
    document.querySelectorAll<HTMLElement>('[data-jp-track]').forEach(track => {
      if (track.dataset.jpReady) return;
      track.dataset.jpReady = '1';

      const root = track.closest('section');
      const prev = root?.querySelector<HTMLButtonElement>('[data-jp-prev]');
      const next = root?.querySelector<HTMLButtonElement>('[data-jp-next]');
      const card = track.querySelector<HTMLElement>('.jp-card');

      const step = () => {
        const w = card?.getBoundingClientRect().width ?? 260;
        const gap = parseFloat(getComputedStyle(track).columnGap || '24') || 24;
        return w + gap;
      };

      const sync = () => {
        const max = track.scrollWidth - track.clientWidth - 2;
        if (prev) prev.disabled = track.scrollLeft <= 2;
        if (next) next.disabled = track.scrollLeft >= max;
      };

      /* The glide is animated here rather than handed to
         scrollBy({behavior:'smooth'}): Lenis drives smooth scrolling on this
         page, and keeping the tween local means the arrows behave the same
         whether or not it is running. Honouring reduced-motion is also ours
         to decide this way. */
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let raf = 0;
      const glide = (delta: number) => {
        cancelAnimationFrame(raf);
        const from = track.scrollLeft;
        const max = track.scrollWidth - track.clientWidth;
        const to = Math.max(0, Math.min(max, from + delta));
        if (reduced) { track.scrollLeft = to; sync(); return; }
        const t0 = performance.now(), dur = 460;
        const tick = (now: number) => {
          const p = Math.min(1, (now - t0) / dur);
          const e = 1 - Math.pow(1 - p, 3);
          track.scrollLeft = from + (to - from) * e;
          if (p < 1) raf = requestAnimationFrame(tick); else sync();
        };
        raf = requestAnimationFrame(tick);
      };

      prev?.addEventListener('click', () => glide(-step()));
      next?.addEventListener('click', () => glide(step()));
      track.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();

      /* Drag to scroll. The 4px threshold lets a plain click through to the
         article — without it every card press became a drag and no link fired. */
      let down = false, startX = 0, startLeft = 0, moved = false;
      track.addEventListener('pointerdown', e => {
        if (e.pointerType === 'touch') return;
        down = true; moved = false;
        startX = e.clientX; startLeft = track.scrollLeft;
      });
      track.addEventListener('pointermove', e => {
        if (!down) return;
        const dx = e.clientX - startX;
        if (!moved && Math.abs(dx) < 4) return;
        if (!moved) { moved = true; track.classList.add('is-dragging'); track.setPointerCapture(e.pointerId); }
        track.scrollLeft = startLeft - dx;
      });
      const end = () => { down = false; if (moved) requestAnimationFrame(() => track.classList.remove('is-dragging')); };
      track.addEventListener('pointerup', end);
      track.addEventListener('pointercancel', end);
      track.addEventListener('pointerleave', end);
    });
  }

  initJournalStrip();
  document.addEventListener('astro:page-load', initJournalStrip);
</script>
