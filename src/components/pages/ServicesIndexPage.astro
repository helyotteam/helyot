---
/**
 * SERVICES INDEX — shared by /en/services and /ru/uslugi.
 *
 * Rebuilt in the site's editorial language: no glass cards, no per-category
 * accent colours, no pill badges, no blur blobs. Rows and hairlines, Spectral
 * for display, Jost lowercase for UI, 4px radius everywhere.
 *
 * The catalogue rows are also written to be quotable by answer engines: each
 * row states the service, what it starts from and how long it takes in one
 * scannable line, and the page ships ItemList + Service structured data.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../shared/Header.astro';
import Footer from '../shared/Footer.astro';
import CineHero from '../shared/CineHero.astro';
import BookingForm from '../sections/BookingForm.astro';
import CookieConsent from '../ui/CookieConsent.astro';
import FloatingContactBar from '../ui/FloatingContactBar.astro';
import { services } from '../../lib/servicesData';
import { locations } from '../../lib/citiesData';
import { type Lang } from '../../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const en = lang === 'en';
const svcHref = (slug: string) => en ? `/en/services/${slug}` : `/ru/uslugi/${slug}`;
const hubHref = (slug: string) => en ? `/en/renovation/${slug}` : `/ru/remont/${slug}`;

const categories = en ? [
  { key: 'spaces',     label: 'Residential',        desc: 'Apartments, villas, kitchens, bathrooms and outdoor space.' },
  { key: 'commercial', label: 'Commercial',         desc: 'Offices, hotels, retail and restaurant fit-outs.' },
  { key: 'specialist', label: 'Design & specialist', desc: 'Interior design, energy modernisation and smart home.' },
  { key: 'trades',     label: 'Trades & works',     desc: 'Flooring, painting, electrics, plumbing and more.' },
] : [
  { key: 'spaces',     label: 'Жильё',              desc: 'Квартиры, виллы, кухни, санузлы и внешние зоны.' },
  { key: 'commercial', label: 'Коммерция',          desc: 'Офисы, отели, магазины и рестораны под ключ.' },
  { key: 'specialist', label: 'Проект и спецработы', desc: 'Дизайн интерьера, энергомодернизация, умный дом.' },
  { key: 'trades',     label: 'Виды работ',         desc: 'Полы, покраска, электрика, сантехника и другое.' },
];

const featured = en ? [
  { slug: 'apartment-renovation', photo: '/images/projects/germasogeia-apt.webp',
    title: 'Apartment renovation', tag: 'most requested', price: 'from €170/m²',
    desc: 'Full gut-out to finished handover. Every trade in-house, one fixed price, 5-year warranty.' },
  { slug: 'villa-renovation', photo: '/images/projects/agios-villa.webp',
    title: 'Villa renovation', tag: 'premium', price: 'from €190/m²',
    desc: 'Structural works, interior, pool and terrace — coordinated by one project manager.' },
  { slug: 'bathroom-renovation', photo: '/images/projects/spa-bathroom.webp',
    title: 'Bathrooms & wet rooms', tag: 'fast turnaround', price: 'from €2,000',
    desc: '10-year waterproofing guarantee. Any tile format. Steam rooms and hammams a speciality.' },
] : [
  { slug: 'apartment-renovation', photo: '/images/projects/germasogeia-apt.webp',
    title: 'Ремонт квартир', tag: 'заказывают чаще всего', price: 'от €170/м²',
    desc: 'От полного демонтажа до сдачи. Все работы штатной бригадой, одна фиксированная цена, гарантия 5 лет.' },
  { slug: 'villa-renovation', photo: '/images/projects/agios-villa.webp',
    title: 'Ремонт вилл', tag: 'премиум', price: 'от €190/м²',
    desc: 'Конструктив, интерьер, бассейн и терраса — всё ведёт один прораб.' },
  { slug: 'bathroom-renovation', photo: '/images/projects/spa-bathroom.webp',
    title: 'Санузлы и мокрые зоны', tag: 'быстрый срок', price: 'от €2 000',
    desc: 'Гарантия на гидроизоляцию 10 лет. Плитка любого формата. Хаммамы и парные — наша специализация.' },
];

const prices = en ? [
  { service: 'Apartment renovation',  from: '€170',    unit: '/m²',   note: '80 m² typical ≈ €28,000' },
  { service: 'Villa renovation',      from: '€190',    unit: '/m²',   note: '250 m² typical ≈ €72,000' },
  { service: 'Bathroom renovation',   from: '€2,000',  unit: 'per room', note: 'Strip-out to finished' },
  { service: 'Kitchen renovation',    from: '€5,000',  unit: 'per room', note: 'Cabinetry, services and tiling' },
  { service: 'Office fit-out',        from: '€150',    unit: '/m²',   note: 'Open plan including services' },
  { service: 'Flooring',              from: '€20',     unit: '/m²',   note: 'Porcelain, wood or vinyl' },
  { service: 'Painting & plastering', from: '€11',     unit: '/m²',   note: 'Primer plus two coats' },
  { service: 'Energy renovation',     from: 'Grant',   unit: '',      note: 'Up to €6,000 EU subsidy' },
] : [
  { service: 'Ремонт квартиры',       from: '€170',    unit: '/м²',   note: '80 м² обычно ≈ €28 000' },
  { service: 'Ремонт виллы',          from: '€190',    unit: '/м²',   note: '250 м² обычно ≈ €72 000' },
  { service: 'Ремонт санузла',        from: '€2 000',  unit: 'за помещение', note: 'От демонтажа до отделки' },
  { service: 'Ремонт кухни',          from: '€5 000',  unit: 'за помещение', note: 'Мебель, инженерия и плитка' },
  { service: 'Отделка офиса',         from: '€150',    unit: '/м²',   note: 'Open space с инженерией' },
  { service: 'Полы',                  from: '€20',     unit: '/м²',   note: 'Керамогранит, дерево, винил' },
  { service: 'Штукатурка и покраска', from: '€11',     unit: '/м²',   note: 'Грунт плюс два слоя' },
  { service: 'Энергомодернизация',    from: 'Субсидия', unit: '',     note: 'До €6 000 от ЕС' },
];

const why = en ? [
  { n: '01', title: 'Fixed price, always',   body: 'The figure you sign is the figure you pay. No variation goes ahead without your written approval.' },
  { n: '02', title: '35 in-house specialists', body: 'Every trade employed directly — plastering, electrics, plumbing, tiling, carpentry. No subcontractors.' },
  { n: '03', title: 'Free site visit in 48h', body: 'We come to your property, measure it and give you an honest assessment of scope and cost. No obligation.' },
  { n: '04', title: '5-year warranty',       body: 'A written structural warranty handed over on the final day, plus 10 years on wet-room waterproofing.' },
] : [
  { n: '01', title: 'Фиксированная цена',    body: 'Сумма, под которой вы подписались, — это сумма, которую вы платите. Ни одно изменение не идёт в работу без вашего письменного согласия.' },
  { n: '02', title: '35 штатных специалистов', body: 'Все работы — своими сотрудниками: штукатурка, электрика, сантехника, плитка, столярка. Субподряда нет.' },
  { n: '03', title: 'Бесплатный выезд за 48ч', body: 'Приезжаем на объект, делаем замеры и честно оцениваем объём и стоимость. Без обязательств.' },
  { n: '04', title: 'Гарантия 5 лет',        body: 'Письменная гарантия на конструктив передаётся в день сдачи, плюс 10 лет на гидроизоляцию мокрых зон.' },
];

/* Pricing detail. The section used to be one sentence and a table of starting
   figures — which answers "how much" and none of the questions that actually
   stop someone from enquiring: what is inside that number, what is not, what
   makes it move, and when the money is due. */
const priceIncl = en ? [
  'Labour by our own specialists, no subcontractors',
  'Standard materials — plaster, primer, adhesives, fixings, consumables',
  'Site protection, daily clean-down and waste removal',
  'Project management and a named site foreman',
  'Snagging and any corrections in the five days after handover',
] : [
  'Работа наших штатных специалистов, без субподряда',
  'Стандартные материалы — штукатурка, грунт, клеи, крепёж, расходники',
  'Защита объекта, ежедневная уборка и вывоз мусора',
  'Ведение проекта и назначенный прораб',
  'Приёмка и устранение замечаний в течение пяти дней после сдачи',
];
const priceExcl = en ? [
  'Finishes you choose yourself — tiles, sanitary ware, flooring, kitchens. We fit anything you supply at no labour surcharge, or buy it at the trade price we pay.',
  'Municipal permit fees, passed on at cost with the receipt.',
  'Structural engineering where a wall is load-bearing — quoted separately once the survey is in.',
  'Furniture, appliances and decorative lighting.',
] : [
  'Отделочные материалы вашего выбора — плитка, сантехника, полы, кухни. Монтируем всё, что вы купили, без наценки за работу, либо закупаем по своей цене поставщика.',
  'Пошлины муниципалитета — передаём по факту с квитанцией.',
  'Расчёт конструктива, если стена несущая, — считается отдельно после обследования.',
  'Мебель, техника и декоративный свет.',
];
const priceDrivers = en ? [
  { k: 'Condition',  v: 'Sound surfaces, or damp, cracks and old wiring that has to come out first.' },
  { k: 'Level',      v: 'Standard, mid or premium specification — the same room can differ by half again.' },
  { k: 'Access',     v: 'Ground floor with parking, or a fifth floor with no lift and a narrow stair.' },
  { k: 'Occupied',   v: 'An empty property, or a home lived in throughout, worked room by room.' },
  { k: 'Services',   v: 'Keeping the existing electrics and plumbing, or replacing both.' },
  { k: 'Consents',   v: 'Cosmetic work, or layout changes that need municipal approval.' },
] : [
  { k: 'Состояние',  v: 'Крепкие поверхности — или сырость, трещины и старая проводка, которую сначала надо убрать.' },
  { k: 'Уровень',    v: 'Базовый, стандарт или премиум — одно и то же помещение отличается в полтора раза.' },
  { k: 'Доступ',     v: 'Первый этаж с парковкой — или пятый без лифта и с узкой лестницей.' },
  { k: 'Проживание', v: 'Пустая квартира — или жилой дом, где работаем по помещениям.' },
  { k: 'Инженерия',  v: 'Оставляем существующие электрику и сантехнику — или меняем обе.' },
  { k: 'Согласования', v: 'Косметика — или перепланировка, которую надо согласовать с муниципалитетом.' },
];
const priceStages = en ? [
  { n: '30%', t: 'On signing',            d: 'Start date locked, materials ordered.' },
  { n: '30%', t: 'At structural stage',   d: 'Demolition, services and plastering complete.' },
  { n: '30%', t: 'At second fix',         d: 'Tiling, flooring and joinery in place.' },
  { n: '10%', t: 'After snagging',        d: 'Paid once the punch list is cleared, not before.' },
] : [
  { n: '30%', t: 'При подписании',   d: 'Дата старта зафиксирована, материалы заказаны.' },
  { n: '30%', t: 'На конструктиве',  d: 'Демонтаж, инженерия и штукатурка закончены.' },
  { n: '30%', t: 'На чистовой',      d: 'Плитка, полы и столярка на месте.' },
  { n: '10%', t: 'После приёмки',    d: 'Платится, когда список замечаний закрыт, не раньше.' },
];

const c = en ? {
  metaTitle: 'All Services — Renovation in Cyprus | Helyot',
  metaDesc: (n: number) => `${n} renovation services in Limassol, Larnaca, Paphos and Nicosia — apartments, villas, offices, kitchens, bathrooms and specialist works. Fixed price, free site visit, 5-year warranty.`,
  heroIndex: 'Renovation services', heroEyebrow: 'Limassol · Cyprus',
  heroTitle: `Every trade. One firm. <em>Price fixed before we start.</em>`,
  heroSub: (n: number) => `${n} services, from a full villa renovation to a single bathroom, delivered by 35 in-house specialists. One fixed-price contract, one project manager, a 5-year structural warranty on every job.`,
  crumbHome: 'Home', crumbSelf: 'Services', homeHref: '/',
  heroCta: (n: number) => `All ${n} services`, heroCta2: 'Free estimate',
  mSvc: 'Services', mSpec: 'Specialists', mWar: 'Warranty', mWarVal: '5 yr',
  popLabel: 'Most requested', popTitle: 'Where projects start', popHeadline: 'Three ways in.',
  learnMore: 'Learn more', viewAll: 'Full catalogue',
  dirLabel: 'Full catalogue', dirTitle: (n: number) => `${n} services, grouped by the kind of work.`,
  dirSub: 'Every price is a starting point confirmed after a free site visit, and every timeline assumes our own team on site. Pick the closest match — we will tell you at the visit if a different one fits better.',
  colWork: 'Service', colTime: 'Timeline', colFrom: 'From',
  filterAll: 'all',
  priceLabel: 'Pricing', priceTitle: 'What things start from',
  priceNote: 'All prices include labour, standard materials and waste removal. Your fixed price is confirmed in writing after a free site visit.',
  colService: 'Service', colFrom: 'From', colNote: 'Typical scope',
  whyLabel: 'Why Helyot', whyTitle: 'What is different here',
  whyProof: 'See it on finished projects',
  whyProofNote: 'Four claims are easy to print. Every project below has the before shot next to the after one.',
  locLabel: 'Coverage', locTitle: 'Where we work',
  locSub: 'Our own crews work in Limassol and its districts. Larnaca, Paphos and Nicosia are regular ground, with crews travelling from here. The far east coast we take selectively, on scope that justifies the distance. Every location below has its own page with local pricing and project examples.',
  locCities: 'Cities', locDistricts: 'Limassol districts',
  ctaLabel: 'Not sure where to start?', ctaTitle: `Tell us what you're planning. <em>We'll work out the rest.</em>`,
  ctaSub: 'Free site visit · fixed quote in five days · no obligation until you sign',
} : {
  metaTitle: 'Все услуги — ремонт на Кипре | Helyot',
  metaDesc: (n: number) => `${n} услуг по ремонту в Лимасоле, Ларнаке, Пафосе и Никосии — квартиры, виллы, офисы, кухни, санузлы и специальные работы. Фиксированная цена, бесплатный выезд, гарантия 5 лет.`,
  heroIndex: 'Услуги по ремонту', heroEyebrow: 'Лимасол · Кипр',
  heroTitle: `Все работы. Один подрядчик. <em>Цена фиксируется до старта.</em>`,
  heroSub: (n: number) => `${n} услуг — от ремонта виллы под ключ до одного санузла — выполняют 35 штатных специалистов. Один договор с фиксированной ценой, один прораб, гарантия 5 лет на конструктив.`,
  crumbHome: 'Главная', crumbSelf: 'Услуги', homeHref: '/ru',
  heroCta: (n: number) => `Все ${n} услуг`, heroCta2: 'Бесплатная смета',
  mSvc: 'Услуг', mSpec: 'Специалистов', mWar: 'Гарантия', mWarVal: '5 лет',
  popLabel: 'Чаще всего', popTitle: 'С чего начинают', popHeadline: 'Три главных направления.',
  learnMore: 'Подробнее', viewAll: 'Весь каталог',
  dirLabel: 'Что мы делаем',
  dirTitle: (_n: number) => `Найдите свою работу.`,
  dirJump: 'Все услуги по типам работ',
  dirNav: 'Перейти к разделу',
  dirSub: 'Каждая цена — стартовая, точная сумма фиксируется после бесплатного выезда, и каждый срок указан при работе нашей бригадой. Выберите ближайшее — на выезде скажем, если подходит другое.',
  colWork: 'Услуга', colTime: 'Срок', colFrom: 'От',
  filterAll: 'все',
  priceLabel: 'Цены', priceTitle: 'От чего стартуют цены',
  priceInclKey: 'Входит в любую цену', priceExclKey: 'Считается отдельно',
  priceDriversKey: 'Что двигает сумму', priceStagesKey: 'Как платится',
  priceFig: 'Смета собирается по чертежу и замеру, а не по телефону.',
  priceFoot: 'Стартовая цена — это нижняя граница по объекту в нормальном состоянии со стандартной отделкой. На выезде мы называем не «примерно столько же», а конкретную сумму по вашему объекту, и она уже не меняется.',
  priceNote: 'Все цены включают работу, стандартные материалы и вывоз мусора. Ваша фиксированная цена подтверждается письменно после бесплатного выезда.',
  colService: 'Услуга', colFrom: 'От', colNote: 'Типичный объём',
  whyLabel: 'Почему Helyot', whyTitle: 'В чём здесь разница',
  whyProof: 'Проверить на готовых объектах',
  whyProofNote: 'Четыре обещания легко напечатать. У каждого проекта в галерее кадр «до» стоит рядом с кадром «после».',
  locLabel: 'География', locTitle: 'Где мы работаем',
  locSub: 'Свои бригады работают в Лимасоле и его районах. Ларнака, Пафос и Никосия — регулярная территория, бригады выезжают отсюда. Дальний восток берём выборочно, под объём, который оправдывает дорогу. У каждой локации ниже своя страница с местными ценами и примерами работ.',
  locCities: 'Города', locDistricts: 'Районы Лимасола',
  ctaLabel: 'Не знаете, с чего начать?', ctaTitle: `Расскажите, что задумали. <em>Остальное — наша забота.</em>`,
  ctaSub: 'Бесплатный выезд · фиксированная смета за пять дней · без обязательств до подписания',
};

const byCategory = (key: string) => services.filter(s => s.category === key);
const total = services.length;

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: c.metaTitle,
  numberOfItems: total,
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: en ? s.titleEn : s.titleRu,
      description: en ? s.seoDescEn : s.seoDescRu,
      url: `https://helyot.com${svcHref(s.slug)}`,
      areaServed: { '@type': 'Country', name: 'Cyprus' },
      provider: { '@type': 'LocalBusiness', name: 'Helyot' },
    },
  })),
};
---

<BaseLayout lang={lang} title={c.metaTitle} description={c.metaDesc(total)}>
<Header lang={lang}/>
<script is:inline type="application/ld+json" set:html={JSON.stringify(listSchema)} />

<main style="background:#08080E;color:#F0F0F6;overflow-x:hidden;">

<CineHero
  lang={lang}
  photo="/images/projects/marina-penthouse.webp"
  index={c.heroIndex}
  eyebrow={c.heroEyebrow}
  titleHtml={c.heroTitle}
  subtitle={c.heroSub(total)}
  breadcrumb={[{ label: c.crumbHome, href: c.homeHref }, { label: c.crumbSelf }]}
  cta={{ label: c.heroCta(total), href: '#all-services' }}
  ctaSecondary={{ label: c.heroCta2, href: '#booking' }}
  meta={[
    { label: c.mSvc,  value: String(total) },
    { label: c.mSpec, value: '35' },
    { label: c.mWar,  value: c.mWarVal },
  ]}
/>

<!-- ══ FEATURED ════════════════════════════════════════════ -->
<section class="sx-sec sx-sec--alt">
  <div class="container-wide">
    <div class="sx-head">
      <div>
        <p class="cine-label" data-reveal><span class="cine-label__index">{c.popLabel}</span>{c.popTitle}</p>
        <h2 class="cine-display sx-h2" data-words>{c.popHeadline}</h2>
      </div>
      <a href="#all-services" class="sx-link" data-reveal>{c.viewAll}</a>
    </div>

    <div class="sx-feat" data-stagger-group>
      {featured.map(f => (
        <a href={svcHref(f.slug)} class="sx-feat-item" data-stagger-item>
          <span class="sx-feat-frame">
            <img src={f.photo} alt={f.title} width="800" height="600" loading="lazy" decoding="async" />
            <span class="sx-feat-tag">{f.tag}</span>
          </span>
          <span class="sx-feat-body">
            <span class="sx-feat-top">
              <span class="sx-feat-title">{f.title}</span>
              <span class="sx-feat-price">{f.price}</span>
            </span>
            <span class="sx-feat-desc">{f.desc}</span>
            <span class="sx-more">{c.learnMore}
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ══ CATALOGUE ═══════════════════════════════════════════ -->
<section id="all-services" class="sx-sec">
  <div class="container-wide">
    <div class="sx-cat-top">
      <div>
        <p class="cine-label" data-reveal><span class="cine-label__index">{c.dirLabel}</span>{c.dirJump}</p>
        <h2 class="cine-display sx-h2" data-words>{c.dirTitle(total)}</h2>
      </div>
      <p class="sx-sub" data-reveal>{c.dirSub}</p>
    </div>

    <nav class="sx-jump" aria-label={c.dirNav} data-reveal>
      {categories.map(cat => (
        <a href={`#cat-${cat.key}`}>
          {cat.label}<i>{byCategory(cat.key).length}</i>
        </a>
      ))}
    </nav>

    {categories.map((cat, ci) => (
      <div class="sx-group" id={`cat-${cat.key}`}>
        <div class="sx-group-head">
          <span class="sx-group-n" aria-hidden="true">{String(ci + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="sx-group-title">{cat.label}</h3>
            <p class="sx-group-desc">{cat.desc}</p>
          </div>
          <span class="sx-group-count">{byCategory(cat.key).length}</span>
        </div>

        <ul class="sx-cards">
          {byCategory(cat.key).map(svc => (
            <li>
              <a href={svcHref(svc.slug)} class="sx-card">
                <span class="sx-card-title">{en ? svc.titleEn : svc.titleRu}</span>
                <span class="sx-card-sub">{en ? svc.heroSubEn : svc.heroSubRu}</span>
                <span class="sx-card-foot">
