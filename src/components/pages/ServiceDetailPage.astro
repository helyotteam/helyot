---
/**
 * SERVICE DETAIL — shared by /en/services/[slug] and /ru/uslugi/[slug].
 *
 * Two 280-line near-duplicates used to sit in the route files and had already
 * drifted apart. One component, both languages.
 *
 * WRITTEN TO BE QUOTED. Answer engines lift short, self-contained statements
 * that name the thing, the place, the number and the unit in one sentence, so:
 *   - the page opens with a direct-answer paragraph, not a marketing line;
 *   - the key facts are a labelled table, not prose;
 *   - every heading below is a question someone actually types;
 *   - Service + Offer + FAQPage + HowTo are all emitted as structured data.
 * Nothing here is invented: prices come from pricingData, scope and FAQs from
 * servicesData, and the standards named are the ones the site already claims.
 */
import CineHero from '../shared/CineHero.astro';
import BookingForm from '../sections/BookingForm.astro';
import { type ServiceData, getRelatedServices } from '../../lib/servicesData';
import { priceRowsBySlug } from '../../lib/pricingData';
import { categoryHero, categoryBand } from '../../lib/servicePhotos';
import { matrixLocations } from '../../lib/citiesData';
import { type Lang } from '../../i18n/ui';

interface Props { lang: Lang; svc: ServiceData; }
const { lang, svc } = Astro.props;
const en = lang === 'en';

const title    = en ? svc.titleEn : svc.titleRu;
const heroSub  = en ? svc.heroSubEn : svc.heroSubRu;
const priceLbl = en ? svc.priceLabelEn : svc.priceLabelRu;
const timeline = en ? svc.timelineEn : svc.timelineRu;
const includes = en ? svc.includesEn : svc.includesRu;
const faqs     = en ? svc.faqsEn : svc.faqsRu;

const related    = getRelatedServices(svc.relatedSlugs).slice(0, 4);
const heroPhoto  = categoryHero[svc.category];
const bandPhoto  = categoryBand[svc.category];
const priceRows  = priceRowsBySlug[svc.slug] ?? [];
const svcBase    = en ? '/en/services' : '/ru/uslugi';
// Only locations the service × location matrix actually generates.
const topLocations = matrixLocations;

const catLabel = en
  ? { spaces: 'Residential', commercial: 'Commercial', specialist: 'Specialist', trades: 'Trades & works' }
  : { spaces: 'Жильё', commercial: 'Коммерция', specialist: 'Спецработы', trades: 'Виды работ' };

/* ── The direct answer. First thing a reader or a model sees. ───────────── */
/* Titles are a mix of singular, plural and coordinate phrases ("Окна и двери",
   "Bathroom & Wet Rooms"), so the opening clause is dash-joined rather than
   verb-joined — a template with a conjugated verb disagrees with half of them. */
const answer = en
  ? `${title} in Limassol — from ${svc.priceLabelEn.replace(/^from /, '')}, typically ${svc.timelineEn.toLowerCase()}. Helyot quotes it as a single fixed-price contract covering labour, standard materials and waste removal, delivered by 35 in-house specialists with no subcontractors, and hands over a 5-year structural warranty on the final day. The site visit and the quote are free.`
  : `${title} в Лимасоле — от ${svc.priceLabelRu.replace(/^от /, '')}, срок обычно ${svc.timelineRu.toLowerCase()}. Helyot оформляет это одним договором с фиксированной ценой — работа, стандартные материалы и вывоз мусора включены, выполняют 35 штатных специалистов без субподряда, а в день сдачи вы получаете гарантию 5 лет на конструктив. Выезд и смета бесплатны.`;

const facts = en ? [
  { k: 'Starting price', v: svc.priceLabelEn },
  { k: 'Typical duration', v: svc.timelineEn },
  { k: 'Price type', v: 'Fixed in the contract' },
  { k: 'Warranty', v: '5 years structural · 10 years wet-room waterproofing' },
  { k: 'Who does the work', v: '35 in-house specialists, no subcontractors' },
  { k: 'Permits', v: 'Prepared and filed by us where required' },
  { k: 'Area served', v: 'Limassol, Paphos, Larnaca, Nicosia, free Famagusta area' },
  { k: 'Site visit', v: 'Free, usually within 48 hours' },
] : [
  { k: 'Стартовая цена', v: svc.priceLabelRu },
  { k: 'Типичный срок', v: svc.timelineRu },
  { k: 'Тип цены', v: 'Фиксируется в договоре' },
  { k: 'Гарантия', v: '5 лет на конструктив · 10 лет на гидроизоляцию' },
  { k: 'Кто выполняет', v: '35 штатных специалистов, без субподряда' },
  { k: 'Разрешения', v: 'Готовим и подаём сами, если требуются' },
  { k: 'География', v: 'Лимасол, Пафос, Ларнака, Никосия, свободная зона Фамагусты' },
  { k: 'Выезд', v: 'Бесплатно, обычно в течение 48 часов' },
];

/* What the fixed price does NOT cover. Stated plainly because the question
   gets asked on every project and a vague answer is what erodes trust. */
const excluded = en ? [
  'Sanitary ware, tiles and flooring you choose yourself — we fit them at no extra labour cost',
  'Loose furniture, appliances and window dressings',
  'Structural surprises found once walls are opened — priced as a written variation before any work',
  'Municipal permit fees themselves, which are paid at cost with the receipt attached',
] : [
  'Сантехника, плитка и напольные покрытия, которые вы выбираете сами — монтируем без доплаты за работу',
  'Мебель, техника и текстиль',
  'Скрытые конструктивные проблемы, вскрывшиеся после демонтажа — оформляются письменным допсоглашением до работ',
  'Сами пошлины муниципалитета — оплачиваются по факту с приложением квитанции',
];

/* Documents handed over. Every item here already exists elsewhere on the site;
   nothing is a placeholder for a certificate we do not actually issue. */
const documents = en ? [
  { t: 'Fixed-price contract', d: 'Scope, total, start date and handover date in one document.' },
  { t: 'Itemised quote', d: 'Line by line, so you can see what each part of the job costs.' },
  { t: 'Project schedule', d: 'Milestones your payments are tied to, not calendar dates.' },
  { t: 'CERA electrical certificate', d: 'Issued on any job involving electrical installation.' },
  { t: 'Municipal permits', d: 'Filed by us and handed over with the approvals attached.' },
  { t: '5-year warranty document', d: 'Signed and handed to you on the final walkthrough.' },
] : [
  { t: 'Договор с фиксированной ценой', d: 'Объём, сумма, дата старта и дата сдачи в одном документе.' },
  { t: 'Постатейная смета', d: 'Построчно — видно, сколько стоит каждая часть работ.' },
  { t: 'График проекта', d: 'Контрольные точки, к которым привязаны платежи, а не даты в календаре.' },
  { t: 'Сертификат CERA', d: 'Выдаётся на любых работах с электромонтажом.' },
  { t: 'Разрешения муниципалитета', d: 'Подаём мы, передаём вам вместе с согласованиями.' },
  { t: 'Гарантийный документ на 5 лет', d: 'Подписывается и передаётся на финальной приёмке.' },
];

const standards = en ? [
  { t: 'EN 14891', d: 'The European standard for liquid-applied waterproofing. Used under every wet room and terrace we build.' },
  { t: 'CERA registration', d: 'Cyprus electrical authority registration — required for a legal installation certificate.' },
  { t: 'European supply', d: 'Materials sourced directly from German, Italian and Spanish manufacturers at trade rates, passed on at cost.' },
] : [
  { t: 'EN 14891', d: 'Европейский стандарт наливной гидроизоляции. Применяем под каждой мокрой зоной и террасой.' },
  { t: 'Регистрация CERA', d: 'Регистрация в электротехническом органе Кипра — без неё не выдаётся легальный сертификат на электрику.' },
  { t: 'Европейские поставки', d: 'Материалы напрямую от производителей Германии, Италии и Испании по оптовым ценам, которые передаём вам.' },
];

const whyUs: Record<string, { title: string; body: string }[]> = en ? {
  spaces: [
    { title: 'One fixed price, no surprises', body: 'Quoted as a fixed-price contract. Material price rises and labour overruns are ours to absorb, not yours.' },
    { title: 'In-house team, no subcontracting', body: 'Electricians, plumbers, plasterers and tilers are permanent Helyot employees — the same standard on every trade.' },
    { title: '5-year structural warranty', body: 'Written and handed over at completion, with wet rooms covered for ten.' },
  ],
  commercial: [
    { title: 'Phased around your operations', body: 'Noisy works scheduled for evenings and weekends so the business keeps trading through the project.' },
    { title: 'One project manager', body: 'A single contact who handles commercial deadlines and multi-trade coordination.' },
    { title: 'Completion date in the contract', body: 'The handover date is contractual, not aspirational.' },
  ],
  specialist: [
    { title: 'Certified, not just experienced', body: 'Current certification across each discipline: CERA electrical, EN 14891 waterproofing, energy works.' },
    { title: 'European supplier network', body: 'Materials direct from Germany, Italy and Spain at the rates we buy them for.' },
    { title: 'Design and build under one roof', body: 'Designers and site team in the same office — no handover gap between drawing and build.' },
  ],
  trades: [
    { title: 'Certified applicators', body: 'Manufacturer-certified painters, waterproofers and flooring installers, not generalists.' },
    { title: 'Trade pricing passed on', body: 'We buy materials at trade rates and give you the discount. Our margin is on labour.' },
    { title: 'Clean site, every day', body: 'Surfaces protected before work starts, cleared at the end of each day, full waste removal at completion.' },
  ],
} : {
  spaces: [
    { title: 'Одна фиксированная цена', body: 'Договор с фиксированной суммой. Подорожание материалов и перерасход по работам — наша проблема, не ваша.' },
    { title: 'Штатная бригада, без субподряда', body: 'Электрики, сантехники, штукатуры и плиточники — постоянные сотрудники Helyot. Один стандарт на всех работах.' },
    { title: 'Гарантия 5 лет на конструктив', body: 'Письменная, передаётся при сдаче. На мокрые зоны — десять лет.' },
  ],
  commercial: [
    { title: 'Подстраиваемся под работу бизнеса', body: 'Шумные работы — вечером и в выходные, чтобы бизнес продолжал работать всё время ремонта.' },
    { title: 'Один прораб', body: 'Один контакт, который держит коммерческие сроки и координирует все бригады.' },
    { title: 'Дата сдачи в договоре', body: 'Дата передачи объекта — договорная, а не «ориентировочная».' },
  ],
  specialist: [
    { title: 'Сертификация, а не только опыт', body: 'Действующая сертификация по каждому направлению: электрика CERA, гидроизоляция EN 14891, энергоработы.' },
    { title: 'Европейские поставщики', body: 'Материалы напрямую из Германии, Италии и Испании по нашим закупочным ценам.' },
    { title: 'Проект и стройка в одних руках', body: 'Дизайнеры и стройка в одном офисе — между чертежом и объектом ничего не теряется.' },
  ],
  trades: [
    { title: 'Сертифицированные исполнители', body: 'Маляры, гидроизолировщики и укладчики с сертификацией производителей, а не универсалы.' },
    { title: 'Оптовые цены — вам', body: 'Покупаем материалы по оптовым ценам и отдаём скидку вам. Зарабатываем на работе.' },
    { title: 'Чистый объект каждый день', body: 'Поверхности защищаем до начала, убираем в конце каждого дня, мусор вывозим при сдаче.' },
  ],
};

const process = en ? [
  { n: '01', title: 'Free site visit', body: 'We come to your property, usually within 48 hours. We measure, photograph the existing condition and ask the questions that change the price.' },
  { n: '02', title: 'Fixed-price quote', body: 'A written quote with a line-by-line breakdown and a fixed total. No provisional sums, no "subject to survey".' },
  { n: '03', title: 'Work starts on the agreed date', body: 'Your project manager arrives with the in-house team on the date in the contract. One contact throughout.' },
  { n: '04', title: 'Handover and sign-off', body: 'We walk through together. Snagging is cleared within five working days at our cost, then documents and keys.' },
] : [
  { n: '01', title: 'Бесплатный выезд', body: 'Приезжаем в течение 48 часов. Замеряем и фотографируем состояние.' },
  { n: '02', title: 'Фиксированная смета', body: 'Построчная разбивка, сумма зафиксирована. Без резервных статей.' },
  { n: '03', title: 'Старт в согласованную дату', body: 'Штатная бригада выходит в дату из договора. Один контакт на проект.' },
  { n: '04', title: 'Сдача и приёмка', body: 'Обход вместе. Замечания — пять дней за наш счёт. Затем ключи.' },
];

const c = en ? {
  eyebrow: 'Service', crumbHome: 'Home', crumbSvc: 'Services', homeHref: '/',
  ctaMain: 'Free estimate', ctaAlt: 'WhatsApp',
  mPrice: 'From', mTime: 'Timeline', mWar: 'Warranty', mWarVal: '5 yr',
  answerLabel: 'In short', answerTitle: (t: string) => `What does ${t.toLowerCase()} in Limassol involve?`,
  factsTitle: 'Key facts',
  incLabel: 'Scope', incTitle: 'What the price includes',
  excTitle: 'What it does not include',
  priceLabel: 'Pricing', priceTitle: (t: string) => `How much does ${t.toLowerCase()} cost?`,
  colWork: 'Work', colPrice: 'From',
  priceNote: 'Baseline rates for the Republic of Cyprus: labour plus standard materials, waste removal included. Your written quote is fixed after a free survey.',
  stdLabel: 'Standards', stdTitle: 'What we build to',
  docLabel: 'Paperwork', docTitle: 'What you receive in writing',
  whyLabel: 'Difference', whyTitle: 'Why owners here choose Helyot',
  procLabel: 'Process', procTitle: 'How the job runs',
  procMore: 'The full process',
  faqLabel: 'Questions', faqTitle: (t: string) => `${t} — questions we get asked`,
  locTitle: (t: string) => `${t} by location`,
  relTitle: 'Related services',
  area: 'Helyot operates across the government-controlled areas of the Republic of Cyprus — Limassol, Paphos, Larnaca, Nicosia and the free Famagusta area. We do not undertake projects in the occupied northern areas.',
} : {
  eyebrow: 'Услуга', crumbHome: 'Главная', crumbSvc: 'Услуги', homeHref: '/ru',
  ctaMain: 'Бесплатная смета', ctaAlt: 'WhatsApp',
  mPrice: 'От', mTime: 'Срок', mWar: 'Гарантия', mWarVal: '5 лет',
  answerLabel: 'Коротко', answerTitle: (t: string) => `Что включает ${t.toLowerCase()} в Лимасоле?`,
  factsTitle: 'Главные факты',
  incLabel: 'Объём', incTitle: 'Что входит в цену',
  excTitle: 'Что в неё не входит',
  priceLabel: 'Цены', priceTitle: (t: string) => `Сколько стоит ${t.toLowerCase()}?`,
  colWork: 'Работа', colPrice: 'От',
  priceNote: 'Базовые ставки для Республики Кипр: работа плюс стандартные материалы, вывоз мусора включён. Ваша смета фиксируется письменно после бесплатного выезда.',
  stdLabel: 'Стандарты', stdTitle: 'По каким нормам работаем',
  docLabel: 'Документы', docTitle: 'Что вы получаете письменно',
  whyLabel: 'Разница', whyTitle: 'Почему выбирают Helyot',
  procLabel: 'Процесс', procTitle: 'Как идёт работа',
  procMore: 'Весь процесс',
  faqLabel: 'Вопросы', faqTitle: (t: string) => `${t} — что спрашивают чаще всего`,
  locTitle: (t: string) => `${t} по локациям`,
  relTitle: 'Смежные услуги',
  area: 'Helyot работает на подконтрольной правительству территории Республики Кипр — Лимасол, Пафос, Ларнака, Никосия и свободная зона Фамагусты. На оккупированных северных территориях мы не работаем.',
};

const processHref = en ? '/en/process' : '/ru/process';

const schema: any[] = [{
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: title,
  description: en ? svc.seoDescEn : svc.seoDescRu,
  serviceType: title,
  provider: {
    '@type': 'LocalBusiness', name: 'Helyot',
    address: { '@type': 'PostalAddress', addressLocality: 'Limassol', addressCountry: 'CY' },
  },
  areaServed: { '@type': 'Country', name: 'Cyprus' },
  ...(svc.priceFrom ? {
    offers: {
      '@type': 'Offer', priceCurrency: 'EUR',
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: svc.priceFrom, priceCurrency: 'EUR',
        unitText: svc.priceUnit === 'sqm' ? 'square metre' : 'project',
      },
    },
  } : {}),
}, {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: c.procTitle,
  step: process.map((p, i) => ({
    '@type': 'HowToStep', position: i + 1, name: p.title, text: p.body,
  })),
}];
if (faqs.length > 0) {
  schema.push({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({
      '@type': 'Question', name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

/* Deep-dive content: only painting carries it so far; every block below
   renders only when the service actually has the data. */
const deep = en ? svc.deepEn : svc.deepRu;
---

{schema.map(s => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

{deep && <div class="pt-page-flag" aria-hidden="true"></div>}

<CineHero
  lang={lang}
  photo={heroPhoto}
  index={catLabel[svc.category]}
  eyebrow={c.eyebrow}
  titleHtml={en ? `${svc.titleEn} <em>in Limassol.</em>` : `${svc.titleRu} <em>в Лимасоле.</em>`}
  subtitle={heroSub}
  breadcrumb={[
    { label: c.crumbHome, href: c.homeHref },
    { label: c.crumbSvc, href: svcBase },
    { label: title },
  ]}
  meta={[
    { label: c.mPrice, value: priceLbl.replace(/^(from |от )/, '') },
    { label: c.mWar,   value: c.mWarVal },
  ]}
  cta={{ label: c.ctaMain, href: '#booking' }}
  ctaSecondary={{ label: c.ctaAlt, href: 'https://wa.me/35797499231' }}
/>

<!-- ══ DIRECT ANSWER + FACTS ═══════════════════════════════ -->
{!deep && (
<section class="sd-sec">
  <div class="container-wide">
    <div class="sd-split">
      <div>
        <p class="cine-label" data-reveal><span class="cine-label__index">{c.answerLabel}</span>{catLabel[svc.category]}</p>
        <h2 class="cine-display sd-h2" data-words>{c.answerTitle(title)}</h2>
        <p class="sd-answer" data-reveal>{answer}</p>
      </div>

      <dl class="sd-facts" data-reveal>
        <p class="sd-facts-key">{c.factsTitle}</p>
        {facts.map(f => (
          <div class="sd-fact">
            <dt>{f.k}</dt>
            <dd>{f.v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

)}
<!-- ══ SCOPE ═══════════════════════════════════════════════ -->
{!deep && (
<section class="sd-sec sd-sec--alt">
  <div class="container-wide">
    <p class="cine-label" data-reveal><span class="cine-label__index">{c.incLabel}</span>{c.incTitle}</p>
    <h2 class="cine-display sd-h2" data-words>
      {en ? <>Everything below is <em>in the price.</em></> : <>Всё перечисленное <em>уже в цене.</em></>}
    </h2>

    <div class="sd-inc" data-stagger-group>
      {includes.map((item, i) => (
        <div class="sd-inc-item" data-stagger-item>
          <span class="sd-inc-n">{String(i + 1).padStart(2, '0')}</span>
          <span>{item}</span>
        </div>
      ))}
    </div>

    <div class="sd-exc">
      <h3>{c.excTitle}</h3>
      <ul>{excluded.map(e => <li>{e}</li>)}</ul>
    </div>
  </div>
</section>

)}
<!-- ══ BAND ════════════════════════════════════════════════ -->
{!deep && (
<div class="sd-band cine-scene" aria-hidden="true">
  <img src={bandPhoto} alt="" loading="lazy" decoding="async" width="1600" height="900" data-parallax="0.18" />
  <div class="sd-band-cap">
    <span>{title}</span><span class="sd-band-rule"></span><span>{en ? 'Limassol · Cyprus' : 'Лимасол · Кипр'}</span>
  </div>
</div>

)}
<!-- ══ PRICES ══════════════════════════════════════════════ -->
{!deep && priceRows.length > 0 && (
  <section class="sd-sec">
    <div class="container-wide">
      <div class="sd-split">
        <div>
          <p class="cine-label" data-reveal><span class="cine-label__index">{c.priceLabel}</span>{priceLbl}</p>
          <h2 class="cine-display sd-h2" data-words>{c.priceTitle(title)}</h2>
          <p class="sd-lead" data-reveal>{c.priceNote}</p>
        </div>

        <div class="sd-tbl">
          <div class="sd-tbl-head"><span>{c.colWork}</span><span>{c.colPrice}</span></div>
          {priceRows.map(row => (
            <div class="sd-tbl-row" data-reveal>
              <p>{en ? row.en : row.ru}</p>
              <span>{en ? row.priceEn : row.priceRu}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
)}

<!-- ══ STANDARDS + DOCUMENTS ═══════════════════════════════ -->
{!deep && (
<section class="sd-sec sd-sec--alt">
  <div class="container-wide">
    <p class="cine-label" data-reveal><span class="cine-label__index">{c.stdLabel}</span>{c.stdTitle}</p>
    <h2 class="cine-display sd-h2" data-words>
      {en ? <>Named standards, <em>not adjectives.</em></> : <>Конкретные нормы, <em>а не прилагательные.</em></>}
    </h2>

    <div class="sd-std" data-stagger-group>
      {standards.map(s => (
        <div class="sd-std-item" data-stagger-item>
          <h3>{s.t}</h3>
          <p>{s.d}</p>
        </div>
      ))}
    </div>

    <div class="sd-docs">
      <p class="sd-docs-key">{c.docTitle}</p>
      <div class="sd-docs-grid">
        {documents.map(d => (
          <div class="sd-doc">
            <h4>{d.t}</h4>
            <p>{d.d}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

)}
<!-- ══ WHY ═════════════════════════════════════════════════ -->
