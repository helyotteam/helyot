}
.pt-cli-prob, .pt-cli-sol { display: flex; flex-direction: column; }
.pt-cli-prob { padding-bottom: 1.1rem; }
.pt-cli-sol { margin-top: auto; padding-top: 1.1rem; border-top: 1px solid rgba(232,184,109,.3); }
.pt-cli-prob span, .pt-cli-sol span {
  font-family: 'Jost Variable', system-ui, sans-serif; font-size: .74rem;
