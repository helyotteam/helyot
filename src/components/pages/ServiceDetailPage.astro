/* ── 05 · split screen with one continuous spine ── */
.pt-vs { position: relative; margin-top: 3.5rem; }
.pt-vs::before {
  content: ''; position: absolute; top: 0; bottom: 0;
  left: calc(18% + ((100% - 18%) / 2)); width: 1px;
  background: linear-gradient(180deg, rgba(232,184,109,.5), rgba(232,184,109,.12));
}
.pt-vs-head, .pt-vs-row {
  display: grid; grid-template-columns: 18% 1fr 1fr; gap: 0 2.2rem; align-items: start;
}
.pt-vs-head { padding-bottom: .9rem; border-bottom: 1px solid rgba(232,184,109,.28); }
.pt-vs-head span {
  font-family: 'Jost Variable', system-ui, sans-serif; font-size: .78rem;
  letter-spacing: .18em; text-transform: uppercase;
}
.pt-vs-head .pt-vs-basic { color: #8288A5; }
.pt-vs-head .pt-vs-us { color: #E8B86D; padding-left: 2.2rem; }
.pt-vs-row { padding: 1.5rem 0; border-bottom: 1px solid rgba(255,255,255,.07); }
.pt-vs-row .pt-vs-stage {
  font-family: 'Spectral', Georgia, serif; font-weight: 400; font-size: 1.02rem; color: #F0F0F6;
}
.pt-vs-row .pt-vs-basic { font-size: .93rem; line-height: 1.6; color: #8288A5; }
.pt-vs-row .pt-vs-us   { font-size: .95rem; line-height: 1.6; color: #F0F0F6; padding-left: 2.2rem; }

/* ── 06 · three problem/solution cards ──
   This was a centred spine with the cards alternating sides. A zigzag needs a
   run of items to read as rhythm; on three it put two cards left, one right
   and ran a 1,232px rule down the middle of an empty column. Three equal
   cards read as a set, which is what they are. Each one splits into what goes
   wrong and what we do about it, divided by a gold hairline. */
.pt-cli { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; margin-top: 3.4rem; }
.pt-cli-card {
  display: flex; flex-direction: column;
  padding: 1.8rem 1.6rem;
  background: #0E0E1A;
  border: 1px solid rgba(255,255,255,.08); border-radius: 4px;
  transition: border-color .35s ease, transform .35s cubic-bezier(.22,1,.36,1);
}
.pt-cli-card:hover { border-color: rgba(232,184,109,.4); transform: translateY(-3px); }
.pt-cli-n {
  font-family: 'Spectral', Georgia, serif; font-weight: 300; font-size: 2.2rem;
  line-height: 1; color: transparent; -webkit-text-stroke: 1px rgba(232,184,109,.45);
  font-variant-numeric: tabular-nums; margin-bottom: .9rem;
}
