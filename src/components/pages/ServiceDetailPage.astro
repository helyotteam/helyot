/* ══ PAINTING DEEP BLOCKS ══════════════════════════════════════════════════
   Six sections used to share one shape — container, heading, grid of cards —
   which read as a single grey column however good the copy was. Each block
   now has its own spatial logic: a sticky split, a full-bleed zigzag, a price
   ladder, a split screen and a spine. The palette and the two typefaces are
   the site's; only the composition changed.
   Motion stays on transform/opacity, ease-out, under 300ms.             */

.pt-sec { padding: 7rem 0; background: #08080E; }
.pt-sec--alt { background: #06060A; }
.pt-h2 { margin: 1.2rem 0 0; font-size: clamp(1.9rem, 3.4vw, 3rem); }
.pt-h2--wide { max-width: 18ch; }
.pt-lead { margin: 1.4rem 0 0; font-size: 1rem; line-height: 1.75; color: #9DA0B8; max-width: 46ch; }
.pt-lead--right { margin-top: 0; align-self: end; }
.pt-head-wide { display: grid; grid-template-columns: 1.1fr .9fr; gap: 3rem; align-items: end; }

/* ── 02 · sticky split with hanging numerals ── */
/* ── 02 · card grid ──
   This was a horizontal accordion. It looked good and it cost too much: 83
   words of copy across six panels, 17 of them visible, five hover actions to
   read the rest — and on touch it collapsed to a plain list, so the effect
   only ever existed on a desktop. Six labels of a dozen words each want to be
   scanned, not opened. Everything is on screen now; the photograph, the gold
   frame on hover and the numeral carry the richness instead.
   Removing it also took away six tabindex divs that had no role and gave
   keyboard users six anonymous stops. */
.pt-scope-head { display: grid; grid-template-columns: 1.05fr .95fr; gap: 3rem; align-items: end; margin-bottom: 3.2rem; }
.pt-scope .pt-h2 { font-size: clamp(2.1rem, 4vw, 3.3rem); }
.pt-scope .pt-lead { margin: 0; max-width: 46ch; }

.pt-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.4rem 2rem; }
.pt-card {
  display: flex; flex-direction: column;
  padding-top: 1.2rem;
  border-top: 1px solid rgba(255,255,255,.09);
  transition: transform .35s cubic-bezier(.22,1,.36,1);
}
.pt-card:hover { transform: translateY(-4px); }
.pt-card-img {
  display: block; aspect-ratio: 16 / 10; margin-bottom: 1.1rem;
  border-radius: 4px; border: 1px solid rgba(255,255,255,.08);
  box-shadow: inset 0 0 0 0 rgba(232,184,109,0);
  transition: box-shadow .4s ease, border-color .4s ease;
}
.pt-card:hover .pt-card-img { border-color: rgba(232,184,109,.42); }
.pt-card-img img {
  filter: saturate(.85) brightness(.72);
  transition: filter .5s ease, transform .9s cubic-bezier(.22,1,.36,1);
}
.pt-card:hover .pt-card-img img { filter: saturate(1) brightness(.92); transform: scale(1.04); }
.pt-card-n {
  position: absolute; left: .85rem; top: .7rem; z-index: 1;
  font-family: 'Spectral', Georgia, serif; font-weight: 300; font-size: 1.6rem;
  line-height: 1; color: transparent;
  -webkit-text-stroke: 1px rgba(243,213,160,.75);
  font-variant-numeric: tabular-nums;
  text-shadow: 0 1px 12px rgba(4,4,8,.8);
  transition: color .4s ease;
}
.pt-card:hover .pt-card-n { color: rgba(232,184,109,.28); }
.pt-card h3 {
  font-family: 'Spectral', Georgia, serif; font-weight: 400; font-size: 1.2rem;
  color: #F0F0F6; margin: 0 0 .5rem; line-height: 1.28;
  transition: color .25s ease;
}
.pt-card:hover h3 { color: #E8B86D; }
.pt-card p { margin: 0; font-size: .94rem; line-height: 1.66; color: #9DA0B8; }

@media (max-width: 1000px) {
  .pt-scope-head { grid-template-columns: 1fr; gap: 1.4rem; align-items: start; }
  .pt-grid { grid-template-columns: repeat(2, 1fr); gap: 2rem 1.6rem; }
}
@media (max-width: 640px) {
  .pt-grid { grid-template-columns: 1fr; gap: 1.8rem; }
}
@media (prefers-reduced-motion: reduce) {
  .pt-card:hover { transform: none; }
  .pt-card:hover .pt-card-img img { transform: none; }
}

/* ── 03 · zigzag, image bleeding to the viewport edge ── */
/* Images were half the row at 5:4 and dwarfed the copy. The picture column is
   now the smaller of the two and less tall; the zigzag and the bleed stay. */
.pt-zag {
  display: grid; grid-template-columns: .78fr 1.22fr; align-items: center;
  gap: 0 4rem; margin-top: 4.5rem;
}
.pt-zag--rev { grid-template-columns: 1.22fr .78fr; }
.pt-zag-img { display: block; aspect-ratio: 4 / 3; }
.pt-zag-img img { filter: saturate(.88) brightness(.86); transition: transform .8s cubic-bezier(.16,1,.3,1), filter .3s ease; }
.pt-zag:hover .pt-zag-img img { transform: scale(1.04); filter: none; }
/* The rows used to sit outside .container-wide so the pictures bled to the
   viewport edge. Measured at 1440: photos landed on 0 and 1440 while the copy
   stopped 363px short of the page grid — the images looked stuck to the glass
   and the text looked adrift. Both columns now live on the same grid as every
   other section. */
.pt-zag-body { padding: 0; }
.pt-zag--rev .pt-zag-body { order: -1; padding: 0; }
.pt-zag-n {
  display: block; font-family: 'Spectral', Georgia, serif; font-weight: 300;
  font-size: 3.4rem; line-height: 1; color: transparent;
  -webkit-text-stroke: 1px rgba(232,184,109,.4); margin-bottom: .6rem;
}
.pt-zag-body h3 {
  font-family: 'Spectral', Georgia, serif; font-weight: 300;
  font-size: clamp(1.7rem, 2.6vw, 2.3rem); letter-spacing: -.02em;
  color: #F0F0F6; margin: 0 0 1.6rem; line-height: 1.15;
}
/* No label column. Three gold uppercase captions per card, nine on screen,
   turned the block into a spec sheet — and that caps/gold treatment belongs to
   .cine-label, once per section. The copy carries its own hierarchy instead:
   the job in display type, the detail in body, the audience as a footnote. */
.pt-zag-lead {
  margin: 0 0 .9rem; max-width: 34ch;
  font-family: 'Spectral', Georgia, serif; font-weight: 300;
  font-size: 1.24rem; line-height: 1.45; color: #F0F0F6;
}
.pt-zag-focus { margin: 0 0 1.5rem; max-width: none; font-size: .97rem; line-height: 1.68; color: #9DA0B8; }
.pt-zag-who {
  margin: 0; padding-top: 1.1rem; max-width: none;
  border-top: 1px solid rgba(255,255,255,.09);
  font-size: .88rem; line-height: 1.55; color: #8288A5;
}

/* ── 04 · price ladder ── */
.pt-ladder { list-style: none; margin: 3.5rem 0 0; padding: 0; }
.pt-rung {
  display: grid; grid-template-columns: minmax(11rem, .8fr) 1.6fr auto;
  gap: 1rem 2.5rem; align-items: baseline;
  padding: 2.1rem 0; border-top: 1px solid rgba(255,255,255,.09);
  transition: transform .28s cubic-bezier(.16,1,.3,1);
}
.pt-rung:last-child { border-bottom: 1px solid rgba(255,255,255,.09); }
.pt-rung:hover { transform: translateX(6px); }
.pt-rung-price {
  font-family: 'Spectral', Georgia, serif; font-weight: 300;
  font-size: clamp(1.7rem, 2.7vw, 2.5rem); line-height: 1; letter-spacing: -.025em;
  color: #E8B86D; font-variant-numeric: tabular-nums; white-space: nowrap;
}
.pt-rung-body h3 {
  font-family: 'Spectral', Georgia, serif; font-weight: 400; font-size: 1.2rem;
  color: #F0F0F6; margin: 0 0 .45rem; line-height: 1.3;
}
.pt-rung-body p { margin: 0; font-size: .93rem; line-height: 1.65; color: #9DA0B8; }
.pt-rung-dur {
  font-family: 'Jost Variable', system-ui, sans-serif; font-size: .8rem;
  color: #8288A5; text-transform: lowercase; white-space: nowrap;
}

.pt-factors { margin-top: 4.5rem; }
.pt-factors-key {
  font-family: 'Jost Variable', system-ui, sans-serif; font-size: .74rem;
  letter-spacing: .18em; text-transform: uppercase; color: #8288A5;
  margin: 0 0 1.6rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(232,184,109,.28);
}
.pt-factors-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.8rem 2.6rem; }
.pt-factor span {
  font-family: 'Spectral', Georgia, serif; font-size: .9rem;
  color: rgba(232,184,109,.55); font-variant-numeric: tabular-nums;
}
.pt-factor h4 {
  font-family: 'Spectral', Georgia, serif; font-weight: 400; font-size: 1.02rem;
  color: #F0F0F6; margin: .25rem 0 .35rem;
}
