}
.pt-cli-prob span { color: #8288A5; }
.pt-cli-sol span { color: #E8B86D; }
.pt-cli-prob p { margin: 0; font-size: .92rem; line-height: 1.64; color: #8288A5; }
.pt-cli-sol p  { margin: 0; font-size: .93rem; line-height: 1.64; color: #B8B8CC; }

