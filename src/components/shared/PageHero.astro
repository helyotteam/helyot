---
import { type Lang } from '../../i18n/ui';

interface Props {
  lang:          Lang;
  eyebrow?:      string;
  title:         string;
  subtitle?:     string;
  breadcrumb?:   { label: string; href: string }[];
  cta?:          { label: string; href: string };
  ctaSecondary?: { label: string; href: string };
  stats?:        { num: string; label: string }[];
}
const { eyebrow, title, subtitle, breadcrumb, cta, ctaSecondary, stats } = Astro.props;
---

<section style="background-color:#08080E;min-height:auto;position:relative;overflow:hidden;">
  <!-- Dot grid -->
  <div class="absolute inset-0 grid-overlay pointer-events-none" aria-hidden="true"></div>
  <!-- Gold gradient -->
  <div class="absolute top-0 right-0 w-96 h-96 pointer-events-none" aria-hidden="true"
       style="background:radial-gradient(ellipse at top right,rgba(232,184,109,0.06) 0%,transparent 70%);"></div>

  <div class="container-wide relative z-10 py-16 md:py-20">
    {/* Trail ships as structured data only — the visible row sat immediately
        above the eyebrow and read as a second breadcrumb line. */}
    {breadcrumb && breadcrumb.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumb.map((crumb, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: crumb.label,
          ...(crumb.href ? { item: `https://helyot.com${crumb.href}` } : {}),
        })),
      })} />
    )}

    <div class="max-w-3xl">
      {eyebrow && (
        <span class="section-label mb-5 block">{eyebrow}</span>
      )}
      <h1 class="font-display font-normal text-[#F0F0F6] leading-tight mb-4"
          style="font-size:clamp(2.2rem,5vw,3.5rem);letter-spacing:-0.02em;">{title}</h1>
      {subtitle && <p class="text-[#8288A5] text-lg leading-relaxed mb-8 max-w-2xl">{subtitle}</p>}

      {(cta || ctaSecondary) && (
        <div class="flex flex-wrap gap-4">
          {cta && (
            <a href={cta.href} class="btn-gold">
              {cta.label}
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
              </svg>
            </a>
          )}
          {ctaSecondary && (
            <a href={ctaSecondary.href} class="btn-outline">{ctaSecondary.label}</a>
          )}
        </div>
      )}
    </div>

    {stats && stats.length > 0 && (
      <div class="flex flex-wrap gap-8 mt-12 pt-10" style="border-top:1px solid rgba(255,255,255,0.07);">
        {stats.map((s) => (
          <div>
            <p class="font-display font-light text-3xl text-[#E8B86D]">{s.num}</p>
            <p class="text-[#8288A5] text-xs mt-0.5">{s.label}</p>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
