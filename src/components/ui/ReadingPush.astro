---
/**
 * READING PUSH — subscription offer for people who are actually reading.
 *
 * The newsletter used to sit inline at the foot of every article, directly
 * above the enquiry CTA: two asks stacked back to back, which reads as pushy
 * and converts worse than either alone. It now surfaces once, quietly, after
 * three minutes of *active* reading.
 *
 * "Active" matters. A wall clock counts a tab left open overnight; this counts
 * only seconds where the tab is visible AND the reader has scrolled or moved in
 * the last 30 seconds. Someone who opened and walked away never sees it.
 *
 * Shows at most once per reader — dismissal and subscription are both
 * remembered — and never on the same visit as the enquiry form being used.
 */
import { type Lang } from '../../i18n/ui';

interface Props { lang: Lang; /** Seconds of active reading before it appears. */ after?: number; }
const { lang, after = 180 } = Astro.props;
const en = lang === 'en';

const c = en ? {
  eyebrow: 'Keep reading',
  title: 'New guides, when there are new guides.',
  body: 'Cost updates, permit changes and the mistakes we get called in to fix. Roughly once a month.',
  placeholder: 'your@email.com',
  submit: 'Subscribe', sending: '…',
  done: 'Confirmed. The next guide comes to this address.',
  err: 'Check the address.',
  close: 'Close', note: 'One email a month at most. Unsubscribe in one click.',
  readers: 'Join 5,000 readers',
} : {
  eyebrow: 'Читаете дальше',
  title: 'Новые гайды — когда они появляются.',
  body: 'Изменения цен, новые правила согласований и ошибки, которые нас зовут исправлять. Примерно раз в месяц.',
  placeholder: 'your@email.com',
  submit: 'Подписаться', sending: '…',
  done: 'Готово. Следующий гайд придёт на этот адрес.',
  err: 'Проверьте адрес.',
  close: 'Закрыть', note: 'Не чаще одного письма в месяц. Отписка в один клик.',
  readers: 'Уже 5 000 читателей',
};
---

<aside class="rpush" id="rpush" hidden aria-live="polite">
  <button type="button" class="rpush-x" id="rpush-x" aria-label={c.close}>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" d="M18 6 6 18M6 6l12 12"/></svg>
  </button>

  <p class="rpush-eyebrow">{c.eyebrow}</p>
  <p class="rpush-title">{c.title}</p>
  <p class="rpush-body">{c.body}</p>
  <p class="rpush-readers"><span class="rpush-dot" aria-hidden="true"></span>{c.readers}</p>

  <form class="rpush-form" id="rpush-form" novalidate>
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="rpush-hp" aria-hidden="true" />
    <label class="rpush-sr" for="rpush-email">Email</label>
    <input type="email" id="rpush-email" name="email" required autocomplete="email"
      placeholder={c.placeholder} class="rpush-input" />
    <button type="submit" class="rpush-submit" data-label={c.submit} data-sending={c.sending}>{c.submit}</button>
  </form>

  <p class="rpush-note">{c.note}</p>
  <p class="rpush-msg rpush-msg--err" id="rpush-err" hidden>{c.err}</p>
  <p class="rpush-msg rpush-msg--ok"  id="rpush-ok"  hidden>{c.done}</p>
</aside>

<script is:inline define:vars={{ afterSeconds: after }}>
(function () {
  var el = document.getElementById('rpush');
  if (!el) return;

  var KEY = 'helyot:newsletter';
  try { if (localStorage.getItem(KEY)) return; } catch (e) { /* private mode */ }

  var active = 0;                 // seconds of genuine reading
  var lastMove = Date.now();
  var shown = false;

  function markActivity() { lastMove = Date.now(); }
  ['scroll', 'mousemove', 'keydown', 'touchstart', 'pointerdown'].forEach(function (ev) {
    window.addEventListener(ev, markActivity, { passive: true });
  });

  var timer = setInterval(function () {
    if (document.hidden) return;                       // tab in the background
    if (Date.now() - lastMove > 30000) return;         // walked away
    active++;
    if (active >= afterSeconds && !shown) { show(); }
  }, 1000);

  function show() {
    shown = true;
    clearInterval(timer);
    el.hidden = false;
    // next frame so the transition has a starting state to animate from
    requestAnimationFrame(function () { el.classList.add('on'); });
  }

  function close(remember) {
    el.classList.remove('on');
    setTimeout(function () { el.hidden = true; }, 300);
    if (remember) { try { localStorage.setItem(KEY, '1'); } catch (e) {} }
  }

  document.getElementById('rpush-x').addEventListener('click', function () { close(true); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !el.hidden) close(true);
  });

  var form = document.getElementById('rpush-form');
  var err = document.getElementById('rpush-err');
  var ok = document.getElementById('rpush-ok');
  var btn = form.querySelector('.rpush-submit');

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (form.querySelector('[name="_gotcha"]').value) return;
    var v = form.querySelector('[name="email"]').value.trim();
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(v)) { err.hidden = false; return; }
    err.hidden = true;

    btn.disabled = true;
    btn.textContent = btn.dataset.sending;

    var fd = new FormData();
    fd.append('type', 'newsletter');
    fd.append('email', v);
    fd.append('page', location.pathname);
    fd.append('source', 'reading-push');

    fetch('/.netlify/functions/send-lead', { method: 'POST', body: fd })
      .catch(function () {})
      .then(function () {
        form.hidden = true;
        ok.hidden = false;
        btn.disabled = false;
        btn.textContent = btn.dataset.label;
        try { localStorage.setItem(KEY, '1'); } catch (e) {}
        setTimeout(function () { close(false); }, 4000);
      });
  });
})();
</script>

<style>
.rpush {
  position: fixed;
  left: 1.5rem; bottom: 1.5rem; z-index: 50;
  width: min(23rem, calc(100vw - 3rem));
  padding: 1.4rem 1.5rem 1.3rem;
  background: rgba(10, 10, 16, .92);
  backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 4px;
  box-shadow: 0 24px 60px rgba(0,0,0,.55);
  /* Starts just below its resting place and fades up — one small move, no bounce */
  opacity: 0; transform: translateY(12px);
  transition: opacity .32s ease, transform .32s cubic-bezier(.16,1,.3,1);
}
.rpush.on { opacity: 1; transform: none; }
.rpush[hidden] { display: none; }

.rpush-x {
  position: absolute; top: .7rem; right: .7rem;
  display: grid; place-items: center;
  width: 32px; height: 32px; border-radius: 4px;
  background: transparent; border: none; color: #8288A5; cursor: pointer;
  transition: color .15s, background .15s;
}
.rpush-x:hover { color: #E4E4F0; background: rgba(255,255,255,.06); }
.rpush-x:focus-visible { outline: 2px solid #E8B86D; outline-offset: 2px; }

.rpush-eyebrow {
  font-family: 'Jost Variable', system-ui, sans-serif;
  font-size: 0.72rem; text-transform: lowercase; letter-spacing: .06em;
  color: #E8B86D; margin: 0 2rem .5rem 0;
}
.rpush-title {
  font-family: 'Spectral', Georgia, serif; font-weight: 400;
  font-size: 1.08rem; line-height: 1.3; color: #F0F0F6; margin: 0 0 .5rem;
}
.rpush-body { font-size: .84rem; line-height: 1.6; color: #9DA0B8; margin: 0 0 1rem; max-width: 42ch; }

.rpush-form { display: flex; gap: .5rem; }
.rpush-form[hidden] { display: none; }
.rpush-hp { position: absolute; left: -9999px; }
.rpush-sr {
  position: absolute; width: 1px; height: 1px; overflow: hidden;
  clip: rect(0 0 0 0); white-space: nowrap;
}
.rpush-input {
  flex: 1; min-width: 0;
  background: transparent; border: 1px solid rgba(255,255,255,.16); border-radius: 4px;
  padding: .6rem .8rem;
  font-family: 'Jost Variable', system-ui, sans-serif; font-size: .9rem; color: #F0F0F6;
  transition: border-color .2s ease;
}
.rpush-input::placeholder { color: #8288A5; }
.rpush-input:focus { outline: none; border-color: rgba(232,184,109,.55); }
.rpush-submit {
  flex-shrink: 0;
  font-family: 'Jost Variable', system-ui, sans-serif;
  font-size: 0.9rem; text-transform: lowercase;
  color: #E8B86D; background: transparent;
  border: 1px solid #E8B86D; border-radius: 4px;
  padding: .6rem 1rem; cursor: pointer;
  transition: background .2s ease, color .2s ease;
}
.rpush-submit:hover { background: rgba(232,184,109,.1); color: #F3D5A0; }
.rpush-submit:focus-visible { outline: 2px solid #E8B86D; outline-offset: 2px; }
.rpush-submit[disabled] { opacity: .55; cursor: default; }

.rpush-note { font-size: 0.72rem; line-height: 1.5; color: #8288A5; margin: .7rem 0 0; }
.rpush-msg { font-size: 0.84rem; margin: .5rem 0 0; }
.rpush-msg--err { color: #E88D6D; }
.rpush-msg--ok  { color: #6EDB85; }

@media (max-width: 700px) {
  /* Clear of the floating contact bar, which owns the bottom-right corner. */
  .rpush {
    left: .9rem; right: .9rem; width: auto;
    bottom: calc(4.5rem + env(safe-area-inset-bottom));
  }
}
@media (prefers-reduced-motion: reduce) {
  .rpush { transition: opacity .2s ease; transform: none; }
  .rpush.on { transform: none; }
}
</style>
