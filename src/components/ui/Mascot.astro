---
interface Props {
  variant?: 'form' | 'empty' | '404';
  lang?:    'en' | 'ru';
  class?:   string;
}
const { variant = 'form', lang = 'en', class: className = '' } = Astro.props;

const captions = {
  form: { en: 'We\'ll reply within 15 minutes!', ru: 'Ответим в течение 15 минут!' },
  empty: { en: 'No results? Write to us!', ru: 'Нет результатов? Напишите нам!' },
  '404': { en: 'Oops! Let\'s find the right page.', ru: 'Упс! Давайте найдём нужную страницу.' },
};
const caption = captions[variant][lang];
---

<div class={`flex flex-col items-center gap-3 select-none ${className}`}>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 160 120"
    class="w-40 h-auto animate-breathe"
    role="img"
    aria-label={caption}
  >
    <!-- Background circle -->
    <circle cx="80" cy="60" r="55" fill="rgba(30,58,138,0.15)" stroke="rgba(30,58,138,0.3)" stroke-width="1"/>

    <!-- Engineer (left) -->
    <g transform="translate(20, 30)">
      <!-- Hard hat -->
      <ellipse cx="25" cy="16" rx="18" ry="6" fill="#EA580C"/>
      <rect x="8" y="16" width="34" height="4" rx="2" fill="#C2410C"/>
      <!-- Head -->
      <circle cx="25" cy="28" r="12" fill="#FBBF24"/>
      <!-- Eyes -->
      <circle cx="21" cy="26" r="2" fill="#1E3A8A"/>
      <circle cx="29" cy="26" r="2" fill="#1E3A8A"/>
      <!-- Smile -->
      <path d="M21 32 Q25 36 29 32" stroke="#1E3A8A" stroke-width="1.5" fill="none" stroke-linecap="round"/>
      <!-- Body (overalls) -->
      <rect x="15" y="42" width="20" height="24" rx="4" fill="#1E3A8A"/>
      <!-- Arms -->
      <rect x="5" y="44" width="8" height="16" rx="4" fill="#1E3A8A"/>
      <rect x="35" y="44" width="8" height="16" rx="4" fill="#1E3A8A"/>
      <!-- Tool in hand -->
      <rect x="40" y="52" width="14" height="3" rx="1.5" fill="#9CA3AF"/>
    </g>

    <!-- Designer (center) -->
    <g transform="translate(58, 20)">
      <!-- Beret -->
      <ellipse cx="22" cy="14" rx="16" ry="8" fill="#8B5CF6"/>
      <circle cx="32" cy="10" r="4" fill="#7C3AED"/>
      <!-- Head -->
      <circle cx="22" cy="26" r="13" fill="#FCD34D"/>
      <!-- Eyes -->
      <circle cx="17" cy="23" r="2.5" fill="#4C1D95"/>
      <circle cx="27" cy="23" r="2.5" fill="#4C1D95"/>
      <!-- Smile -->
      <path d="M17 30 Q22 35 27 30" stroke="#4C1D95" stroke-width="1.5" fill="none" stroke-linecap="round"/>
      <!-- Body (creative shirt) -->
      <rect x="12" y="41" width="20" height="26" rx="5" fill="#8B5CF6"/>
      <!-- Laptop/tablet -->
      <rect x="2" y="52" width="22" height="15" rx="3" fill="#E5E7EB" stroke="#D1D5DB" stroke-width="1"/>
      <rect x="4" y="54" width="18" height="9" rx="1.5" fill="#3B82F6"/>
    </g>

    <!-- Site Manager (right) -->
    <g transform="translate(100, 28)">
      <!-- Helmet -->
      <ellipse cx="22" cy="15" rx="17" ry="7" fill="#F59E0B"/>
      <rect x="6" y="15" width="32" height="5" rx="2" fill="#D97706"/>
      <!-- Head -->
      <circle cx="22" cy="28" r="12" fill="#FBBF24"/>
      <!-- Eyes -->
      <circle cx="18" cy="26" r="2" fill="#1F2937"/>
      <circle cx="26" cy="26" r="2" fill="#1F2937"/>
      <!-- Moustache -->
      <path d="M16 31 Q22 34 28 31" stroke="#92400E" stroke-width="2" fill="none" stroke-linecap="round"/>
      <!-- Body (hi-vis vest) -->
      <rect x="12" y="42" width="20" height="24" rx="4" fill="#F59E0B"/>
      <rect x="12" y="48" width="20" height="3" fill="#1E3A8A"/>
      <rect x="12" y="54" width="20" height="3" fill="#1E3A8A"/>
      <!-- Clipboard -->
      <rect x="28" y="44" width="14" height="18" rx="2" fill="white" stroke="#D1D5DB" stroke-width="1"/>
      <rect x="30" y="47" width="10" height="1.5" rx="0.75" fill="#9CA3AF"/>
      <rect x="30" y="50" width="8"  height="1.5" rx="0.75" fill="#9CA3AF"/>
      <rect x="30" y="53" width="10" height="1.5" rx="0.75" fill="#9CA3AF"/>
    </g>

    <!-- Stars decoration -->
    <text x="72" y="16" font-size="10" fill="#F59E0B" opacity="0.8">★</text>
    <text x="140" y="50" font-size="8"  fill="#8B5CF6" opacity="0.6">★</text>
    <text x="10"  y="90" font-size="9"  fill="#EA580C" opacity="0.7">★</text>
  </svg>

  <p class="text-sm text-gray-400 text-center max-w-[180px] leading-snug">{caption}</p>
</div>
