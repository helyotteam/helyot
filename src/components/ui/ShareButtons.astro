---
/**
 * SHARE — article sharing row.
 *
 * The previous version was hardcoded English ("Share:") on a page that ships in
 * two languages, used the retired glass-card styling, and had no WhatsApp —
 * which is the channel people on Cyprus actually forward things in.
 */
import { type Lang } from '../../i18n/ui';

interface Props { url: string; title: string; lang?: Lang; class?: string; }
const { url, title, lang = 'en', class: className = '' } = Astro.props;
const en = lang === 'en';

const u = encodeURIComponent(url);
const t = encodeURIComponent(title);

const links = [
  { k: 'whatsapp', label: 'WhatsApp', href: `https://wa.me/?text=${t}%20${u}`,
    d: 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12 0C5.373 0 0 5.373 0 12c0 2.125.555 4.122 1.528 5.855L0 24l6.335-1.652A11.954 11.954 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z' },
  { k: 'telegram', label: 'Telegram', href: `https://t.me/share/url?url=${u}&text=${t}`,
    d: 'M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z' },
  { k: 'facebook', label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
    d: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z' },
  { k: 'x', label: 'X', href: `https://twitter.com/intent/tweet?url=${u}&text=${t}`,
    d: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z' },
];

const c = en
  ? { share: 'Share this', copy: 'Copy link', copied: 'Link copied' }
  : { share: 'Поделиться', copy: 'Скопировать ссылку', copied: 'Ссылка скопирована' };
---

<div class={`sh ${className}`}>
  <span class="sh-key">{c.share}</span>
  <div class="sh-row">
    {links.map(l => (
      <a href={l.href} target="_blank" rel="noopener noreferrer" class="sh-btn" aria-label={l.label}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={l.d}/></svg>
      </a>
    ))}
    <button type="button" class="sh-btn sh-copy" data-url={url} data-copied={c.copied} aria-label={c.copy}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/>
      </svg>
    </button>
    <span class="sh-toast" id="sh-toast" role="status" aria-live="polite"></span>
  </div>
</div>

<script is:inline>
(function () {
  document.querySelectorAll('.sh-copy').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var toast = btn.parentElement.querySelector('.sh-toast');
      navigator.clipboard?.writeText(btn.dataset.url);
      if (!toast) return;
      toast.textContent = btn.dataset.copied;
      toast.classList.add('on');
      setTimeout(function () { toast.classList.remove('on'); }, 2200);
    });
  });
})();
</script>

<style>
.sh { display: flex; align-items: center; gap: 1.1rem; flex-wrap: wrap; }
.sh-key {
  font-family: 'Jost Variable', system-ui, sans-serif;
  font-size: 0.84rem; text-transform: lowercase; letter-spacing: .04em; color: #8288A5;
}
.sh-row { display: flex; align-items: center; gap: .5rem; }
.sh-btn {
  display: grid; place-items: center;
  width: 40px; height: 40px; border-radius: 4px;
  border: 1px solid rgba(255,255,255,.12); background: transparent;
  color: #8288A5; cursor: pointer;
  transition: color .18s, border-color .18s, background .18s;
}
.sh-btn:hover { color: #E8B86D; border-color: rgba(232,184,109,.45); background: rgba(232,184,109,.06); }
.sh-btn:focus-visible { outline: 2px solid #E8B86D; outline-offset: 2px; }
.sh-toast {
  font-size: 0.78rem; color: #E8B86D; opacity: 0;
  transition: opacity .2s ease; pointer-events: none;
}
.sh-toast.on { opacity: 1; }
@media (prefers-reduced-motion: reduce) { .sh-btn, .sh-toast { transition: none; } }
</style>
