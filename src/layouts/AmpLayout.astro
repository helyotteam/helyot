---
interface Props {
  title:         string;
  description?:  string;
  publishedDate: string;
  ogImage?:      string;
  canonicalUrl:  string;
  siteName:      string;
}

const { title, description, publishedDate, ogImage, canonicalUrl, siteName } = Astro.props;
const siteBase = 'https://helyot.com';
const ogImageAbs = ogImage?.startsWith('http') ? ogImage : ogImage ? `${siteBase}/${ogImage.replace(/^\//, '')}` : `${siteBase}/images/og/og-default.jpg`;
---

<!doctype html>
<html ⚡ lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,minimum-scale=1,initial-scale=1" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title} | {siteName}</title>
    <meta name="description" content={description} />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImageAbs} />
    <meta property="og:type"        content="article" />
    <meta property="og:url"         content={canonicalUrl} />
    <meta property="article:published_time" content={publishedDate} />

    <script async src="https://cdn.ampproject.org/v0.js"></script>

    <style amp-boilerplate>body{-webkit-animation:-amp-start 8s steps(1,end) 0s 1 normal both;animation:-amp-start 8s steps(1,end) 0s 1 normal both}@-webkit-keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}@keyframes -amp-start{from{visibility:hidden}to{visibility:visible}}</style>
    <noscript><style amp-boilerplate>body{-webkit-animation:none;animation:none}</style></noscript>

    <style amp-custom>
      *{box-sizing:border-box;margin:0;padding:0}
      body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#0f172a;color:#e5e7eb;line-height:1.7}
      header{background:linear-gradient(135deg,#1e3a8a,#ea580c);padding:1rem 1.5rem}
      header a{color:#fff;text-decoration:none;font-weight:700;font-size:1.1rem}
      main{max-width:720px;margin:0 auto;padding:2.5rem 1.25rem}
      h1{font-size:1.75rem;font-weight:800;line-height:1.3;margin-bottom:.5rem;color:#fff}
      .meta{color:#9ca3af;font-size:0.84rem;margin-bottom:2rem}
      h2{font-size:1.35rem;font-weight:700;color:#fff;margin:2rem 0 .75rem}
      h3{font-size:1.1rem;font-weight:600;color:#e5e7eb;margin:1.5rem 0 .5rem}
      p{margin-bottom:1rem;color:#d1d5db}
      ul,ol{padding-left:1.5rem;margin-bottom:1rem}
      li{margin-bottom:.35rem;color:#d1d5db}
      strong{color:#fff;font-weight:600}
      a{color:#fb923c;text-decoration:underline}
      table{width:100%;border-collapse:collapse;margin-bottom:1.5rem;font-size:0.9rem}
      th{background:rgba(255,255,255,.08);text-align:left;padding:.6rem 1rem;font-weight:600;color:#fff;border:1px solid rgba(255,255,255,.1)}
      td{padding:.6rem 1rem;border:1px solid rgba(255,255,255,.1);color:#d1d5db}
      .cta{background:rgba(234,88,12,.15);border:1px solid rgba(234,88,12,.3);border-radius:1rem;padding:1.5rem;text-align:center;margin-top:3rem}
      .cta a{display:inline-block;background:#EA580C;color:#fff;padding:.75rem 2rem;border-radius:.75rem;text-decoration:none;font-weight:600;margin-top:.75rem}
      footer{background:#020617;color:#6b7280;padding:2rem 1.25rem;text-align:center;font-size:0.78rem;margin-top:3rem}
      footer a{color:#9ca3af;text-decoration:none}
    </style>
  </head>
  <body>
    <header>
      <a href="/">{siteName}</a>
    </header>
    <main>
      {ogImage && (
        <amp-img
          src={ogImageAbs}
          alt={title}
          width="720"
          height="400"
          layout="responsive"
          style="border-radius:1rem;overflow:hidden;margin-bottom:1.5rem"
        ></amp-img>
      )}
      <h1>{title}</h1>
      <p class="meta">Published {publishedDate}</p>
      <slot />
    </main>
    <footer>
      <p>© {new Date().getFullYear()} {siteName}</p>
      <p style="margin-top:.5rem"><a href="/en/privacy">Privacy Policy</a></p>
    </footer>
  </body>
</html>
