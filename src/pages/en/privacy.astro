---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/shared/Header.astro';
import Footer from '../../components/shared/Footer.astro';
import PageHero from '../../components/shared/PageHero.astro';
import CookieConsent from '../../components/ui/CookieConsent.astro';
import { t } from '../../i18n/ui';
const lang = 'en';
const tr = (k) => t(lang, k);
---
<BaseLayout lang={lang} title="Privacy Policy" description="How Helyot collects, uses and protects personal data, and how to exercise your GDPR rights." noindex>
  <Header lang={lang} />
  <main>
    <PageHero lang={lang} eyebrow="Legal" title="Privacy Policy"
      subtitle="Last updated: 1 January 2025"
      breadcrumb={[{label:'Home',href:'/'},{label:'Privacy',href:'/en/privacy'}]} />
    <section class="py-20 bg-[#08080E]">
      <div class="container-narrow">
        <div class="card p-10">
          <div class="prose-article space-y-8">
            <section>
              <h2>1. Who We Are</h2>
              <p><strong>Helyot</strong> operates helyot.com. We are a licensed renovation and construction company based in Limassol, Cyprus. For data enquiries: <a href={`mailto:${tr('site.dataEmail')}`}>{tr('site.dataEmail')}</a></p>
            </section>
            <section>
              <h2>2. Data We Collect</h2>
              <ul>
                <li><strong>Contact data</strong> — name, phone, email provided via forms</li>
                <li><strong>Usage data</strong> — pages visited, time on site (only with your consent via Google Analytics 4)</li>
                <li><strong>Technical data</strong> — anonymised IP address, browser type and device</li>
                <li><strong>Cookie data</strong> — see Section 5 below</li>
              </ul>
            </section>
            <section>
              <h2>3. How We Use Data</h2>
              <ul>
                <li>To respond to enquiries and provide renovation services</li>
                <li>To improve our website and user experience</li>
                <li>To send service-related communications (not unsolicited marketing)</li>
                <li>To comply with Cyprus and EU law</li>
              </ul>
            </section>
            <section>
              <h2>4. Who We Share Data With</h2>
              <ul>
                <li><strong>Google Analytics 4</strong> — anonymised analytics (only with your consent)</li>
                <li><strong>Netlify</strong> — our hosting provider, which processes form submissions</li>
                <li><strong>No marketing brokers</strong> — we do not sell your data</li>
              </ul>
            </section>
            <section>
              <h2>5. Cookies</h2>
              <p><strong>Necessary</strong> cookies are always active. <strong>Analytics</strong> (GA4) and <strong>Marketing</strong> cookies are enabled only after your explicit consent. Your preferences are stored for 365 days and can be changed at any time via the cookie banner.</p>
            </section>
            <section>
              <h2>6. Data Retention</h2>
              <p>Contact enquiry data is retained for up to 3 years. Analytics data is retained for 14 months per Google Analytics default settings.</p>
            </section>
            <section>
              <h2>7. Your GDPR Rights</h2>
              <ul>
                <li>Right to <strong>access</strong> your personal data</li>
                <li>Right to <strong>rectification</strong> of inaccurate data</li>
                <li>Right to <strong>erasure</strong> ("right to be forgotten")</li>
                <li>Right to <strong>object</strong> to processing</li>
                <li>Right to <strong>data portability</strong></li>
                <li>Right to <strong>withdraw consent</strong> at any time</li>
              </ul>
              <p>To exercise any right, email <a href={`mailto:${tr('site.dataEmail')}`}>{tr('site.dataEmail')}</a>. We respond within 30 days.</p>
            </section>
            <section>
              <h2>8. International Transfers</h2>
              <p>Google Analytics may transfer data to the USA under Standard Contractual Clauses (SCCs) per GDPR Article 46.</p>
            </section>
            <section>
              <h2>9. Changes to This Policy</h2>
              <p>Significant changes will be communicated via a notice on our homepage. The date at the top of this page reflects the latest revision.</p>
            </section>
            <section>
              <h2>10. Contact</h2>
              <p>Data controller: Helyot, Limassol, Cyprus.<br />
              Email: <a href={`mailto:${tr('site.dataEmail')}`}>{tr('site.dataEmail')}</a><br />
              Phone: <a href={`tel:${tr('site.phone').replace(/\s/g,'')}`}>{tr('site.phone')}</a></p>
            </section>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer lang={lang} />
  <CookieConsent lang={lang} />
</BaseLayout>
