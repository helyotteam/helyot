---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/shared/Header.astro';
import Footer from '../../components/shared/Footer.astro';
import ProcessPage from '../../components/pages/ProcessPage.astro';
import CookieConsent from '../../components/ui/CookieConsent.astro';
import FloatingContactBar from '../../components/ui/FloatingContactBar.astro';

const lang = 'en';
---

<BaseLayout lang={lang}
  title="How We Work — The Helyot Renovation Process | Cyprus"
  description="Six stages from free site visit to 5-year warranty handover: what you receive at each one, when you pay, and how long real projects take. Helyot, Cyprus.">
  <Header lang={lang} />
  <main style="background:#08080E;color:#F0F0F6;overflow-x:hidden;">
    <ProcessPage lang={lang} />
  </main>
  <Footer lang={lang} />
  <CookieConsent lang={lang} />
  <FloatingContactBar lang={lang} />
</BaseLayout>
