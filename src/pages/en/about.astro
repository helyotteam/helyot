---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/shared/Header.astro';
import Footer from '../../components/shared/Footer.astro';
import CineHero from '../../components/shared/CineHero.astro';
import CookieConsent from '../../components/ui/CookieConsent.astro';
import FloatingContactBar from '../../components/ui/FloatingContactBar.astro';
import BookingForm from '../../components/sections/BookingForm.astro';

const lang = 'en';

const team = [
  { initials:'AM', name:'Alexander M.',  role:'Founder & Director',        exp:'15yr', spec:['Strategy','Client Relations'],        photo:undefined, g:'linear-gradient(135deg,#1a0f00,#4a2a10)',    accent:'rgba(232,184,109,.25)' },
  { initials:'ML', name:'Maria L.',      role:'Lead Interior Designer',     exp:'8yr',  spec:['Interior Concepts','Material Sourcing'],photo:undefined,      g:'linear-gradient(135deg,#050814,#0d1f45)',    accent:'rgba(100,160,255,.2)'  },
  { initials:'DP', name:'Dimitri P.',    role:'Head of Construction',       exp:'12yr', spec:['Project Management','Structural'],     photo:undefined,    g:'linear-gradient(135deg,#080a10,#151a28)',    accent:'rgba(200,200,220,.15)' },
  { initials:'EK', name:'Elena K.',      role:'Senior Project Manager',     exp:'6yr',  spec:['Scheduling','Quality Control'],        photo:undefined,      g:'linear-gradient(135deg,#051208,#0d2a14)',    accent:'rgba(100,220,120,.18)' },
  { initials:'NA', name:'Nikos A.',      role:'Chief Electrician (CERA)',   exp:'9yr',  spec:['CERA Licensed','Smart Systems'],       photo:undefined,      g:'linear-gradient(135deg,#040810,#082035)',    accent:'rgba(100,180,255,.2)'  },
  { initials:'AS', name:'Anna S.',       role:'Client Experience Lead',     exp:'5yr',  spec:['Onboarding','After-Sales'],            photo:undefined,       g:'linear-gradient(135deg,#180810,#3a1025)',    accent:'rgba(220,100,160,.18)' },
  { initials:'PB', name:'Pavel B.',      role:'Master Tiler & Waterproofer',exp:'11yr', spec:['Large Format','Mosaic','Hammam'],      photo:undefined,      g:'linear-gradient(135deg,#0a0810,#1e1430)',    accent:'rgba(160,100,220,.18)' },
  { initials:'LV', name:'Lena V.',       role:'Interior Design Coordinator', exp:'4yr', spec:['Space Planning','Material Schedules','Client Briefs'],    photo:undefined,       g:'linear-gradient(135deg,#100a08,#2a1a12)',    accent:'rgba(232,184,109,.2)'  },
];

const milestones = [
  { period:'Early 2022', title:'Helyot founded',                        desc:'Alexander M. and Dimitri P. establish Helyot with a founding team of 8 in-house specialists covering construction, electrical, and interior design.' },
  { period:'Late 2022',  title:'First 100 completed projects',          desc:'100 renovations delivered in year one. Zero disputes, zero unpaid invoices. Word-of-mouth becomes the primary source of new clients.' },
  { period:'Q2 2023',    title:'Design & planning service',             desc:'Full interior design service added to every project — material schedules, lighting plans and layout reviews before a single wall is touched.' },
  { period:'Q4 2023',    title:'Full in-house team of 35 specialists',  desc:'All trades fully in-house: plastering, electrical, plumbing, tiling, carpentry. One point of accountability, one quality standard.' },
  { period:'Q1 2024',    title:'Energy renovation certified',           desc:'Certified by Cyprus Energy Service. 40+ clients helped to claim €10,000+ each in EU energy-efficiency subsidies.' },
  { period:'Q4 2024',    title:'500+ projects delivered',                desc:'500+ completed renovations. 4.9★ across 47 written client testimonials. The longest structural warranty in Limassol.' },
];

const fleet = [
  { icon:'🚐', label:'Company Vans',       count:'×4', desc:'Fully equipped Mercedes Sprinters with company branding and tool storage.' },
  { icon:'🏗️', label:'Scissor Lifts',     count:'×2', desc:'For safe, efficient work on high ceilings and exterior facades.' },
  { icon:'🔧', label:'Power Tool Sets',    count:'×8', desc:'Bosch Professional grade — one full set per active project.' },
  { icon:'🪣', label:'Mixing Equipment',   count:'×3', desc:'Professional cement mixers and plastering machines for faster output.' },
  { icon:'📐', label:'Laser Level Systems',count:'×6', desc:'Leica precision instruments — guaranteeing perfectly level finishes.' },
  { icon:'🔬', label:'Thermal Cameras',   count:'×2', desc:'Fluke thermal imaging for energy audits and hidden defect detection.' },
];

const clients = [
  {
    name:'Maria & Sergei K.',  area:'Germasogeia',  type:'2BR Apartment',   sqm:95,  year:2024,
    quote:'The day we walked in after handover, my husband cried. We had lived in that apartment for 7 years and never imagined it could look like this.',
    result:'+58% Airbnb income', detail:'Placed #3 in Germasogeia on Booking.com within 2 weeks of listing.',
    img:'/images/projects/germasogeia-apt.webp',
    g:'radial-gradient(ellipse at 40% 60%,rgba(232,184,109,.4) 0%,transparent 55%),linear-gradient(140deg,#0f0800,#2a1500,#0f0800)',
    icon:'🏠',
  },
  {
    name:'Dmitri V.',           area:'Agios Tychonas',type:'Villa Renovation', sqm:320, year:2023,
    quote:'The villa sold 3 days after listing at the full asking price. The estate agent told me it was the fastest sale she had seen in Agios Tychonas that year.',
    result:'+32% market value', detail:'Valued €340K above pre-renovation appraisal by independent surveyor.',
    img:'/images/projects/agios-villa.webp',
    g:'radial-gradient(ellipse at 50% 70%,rgba(100,160,255,.2) 0%,transparent 55%),linear-gradient(140deg,#050810,#0a1830,#050810)',
    icon:'🏡',
  },
  {
    name:'George P.',           area:'City Centre',   type:'Tech Office',     sqm:240, year:2023,
    quote:'Completed in exactly 6 weeks as promised. Staff moved in on Monday morning. Zero snagging items. I have managed 4 office fit-outs across Europe — this was the most professional.',
    result:'On Day 42, as agreed', detail:'40 desks operational. Zero business disruption. Under budget by €2,100.',
    img:'/images/projects/city-office.webp',
    g:'radial-gradient(ellipse at 65% 35%,rgba(110,90,230,.22) 0%,transparent 55%),linear-gradient(140deg,#060610,#121230,#060610)',
    icon:'🏢',
  },
];

const certs = [
  { num:'01', title:'Licensed General Contractor',               issuer:'Cyprus Department of Labour and Social Insurance',    ref:'Lic. No. CY-CONS-2022-0847',   status:'Active — No expiry' },
  { num:'02', title:'CERA Certified — Electrical Installations', issuer:'Electrical Authority of Cyprus (CERA)',               ref:'Reg. No. CERA/E/2022-334',     status:'Valid through Dec 2026' },
  { num:'03', title:'Professional Indemnity Insurance',          issuer:'Generali Insurance Cyprus Ltd.',                      ref:'Policy No. GN-PI-2024-77421',  status:'Active — Renewed annually' },
  { num:'04', title:'Public Liability Insurance',                issuer:'Generali Insurance Cyprus Ltd.',                      ref:'Policy No. GN-PL-2024-77422',  status:'Active — €2M per incident' },
  { num:'05', title:'Energy Auditor Certification',              issuer:'Cyprus Energy Service (CES)',                         ref:'Cert. No. CES/EA/2022-0091',   status:'Valid through Mar 2027' },
  { num:'06', title:'Fixed-Price Contract Standard',             issuer:'Legally binding — Cyprus Contract Law Cap. 149',     ref:'No variations without written approval', status:'All projects' },
];

const values = [
  { n:'01', title:'We own our mistakes',       desc:'If something is wrong, we fix it — at our cost, within 10 working days. No arguments, no delay.' },
  { n:'02', title:'One price, always',          desc:'The figure you sign is the figure you pay. Every extra requires your written approval before we proceed.' },
  { n:'03', title:'Craft is our competitive edge',desc:'We are not the cheapest. We compete on quality, consistency and the reputation that comes from 500+ satisfied clients.' },
  { n:'04', title:'The team that designs builds', desc:'Our designers and craftspeople work side by side. No translation errors. No "that\'s not what I meant".' },
  { n:'05', title:'Transparency over comfort',   desc:'If a timeline is at risk, you hear about it from us — immediately, with a plan. We never hide bad news.' },
  { n:'06', title:'Local knowledge is real value',desc:'15+ years of renovation expertise means we know every building regulation, every material supplier, every planning officer.' },
];
---
<BaseLayout lang={lang} title="About Helyot — Meet the Team | Limassol Renovation" description="Meet the 35-person team behind Helyot — Limassol's most trusted renovation company. Our story, our values, our people.">
<style>
:root{--expo:cubic-bezier(0.16,1,0.3,1);--gold:#E8B86D;}

/* Scroll reveal — state set via JS so fallback = always visible */
.ar,.ar-sc,.ar-l,.ar-r { /* initial state set by JS, not CSS */ }

/* ── Team portrait ── */
.portrait{border-radius:4px;aspect-ratio:1;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;transition:transform .4s var(--expo),box-shadow .4s ease;}
.portrait:hover{transform:translateY(-4px);}
.portrait-init{font-family:'Spectral',Georgia,serif;font-weight:300;font-size:2rem;z-index:1;position:relative;}
.portrait::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 30% 30%,rgba(255,255,255,.08),transparent 60%);}
.portrait::after{content:'';position:absolute;bottom:0;left:0;right:0;height:40%;background:linear-gradient(to top,rgba(0,0,0,.4),transparent);}
/* Subtle hover glow */
.team-card:hover .portrait{box-shadow:0 0 0 2px var(--portrait-accent);}

/* ── Timeline snake ── */

/* ── Comparison table ── */
.cmp-sec{ background:#06060A; border-top:1px solid rgba(255,255,255,.07); padding:5rem 0; }
.cmp-head{ max-width:60ch; margin-bottom:3rem; }
.cmp-h2{ margin:1rem 0 1rem; font-size:clamp(1.8rem,3.2vw,2.6rem); }
.cmp-lead{ font-size:.9rem; line-height:1.8; color:#8E91AB; max-width: 58ch; }
.cmp-table{ display:flex; flex-direction:column; }
.cmp-row{
  display:grid; grid-template-columns:1fr 1.35fr 1.35fr; gap:2rem;
  padding:1.4rem 0; border-top:1px solid rgba(255,255,255,.08); align-items:start;
}
.cmp-row:last-child{ border-bottom:1px solid rgba(255,255,255,.08); }
.cmp-row--head{ border-top:none; padding-bottom:.7rem; }
.cmp-row--head .cmp-them,
.cmp-row--head .cmp-us{
  font-family:'Jost Variable',system-ui,sans-serif; font-size:.72rem;
  letter-spacing:.2em; text-transform:lowercase;
}
.cmp-row--head .cmp-them{ color:#8288A5; }
.cmp-row--head .cmp-us{ color:#E8B86D; }
.cmp-topic{
  font-family:'Spectral',Georgia,serif; font-size:1.02rem; color:#E4E4EE; line-height:1.3;
}
.cmp-them{ font-size:0.84rem; line-height:1.7; color:#8288A5; max-width: 46ch; }
.cmp-us{
  font-size:0.84rem; line-height:1.7; color:#B8B8CC;
  display:flex; gap:.6rem; align-items:flex-start; max-width: 46ch;
}
.cmp-us svg{ flex-shrink:0; margin-top:.22rem; }

@media (max-width:860px){
  .cmp-sec{ padding:3.5rem 0; }
  .cmp-row{ grid-template-columns:1fr; gap:.6rem; padding:1.2rem 0; }
  .cmp-row--head{ display:none; }
  .cmp-them::before{ content:'usually — '; color:#8288A5; }
  .cmp-us::after{ content:''; }
}
.tl-srow{display:grid;grid-template-columns:1fr 64px 1fr;align-items:flex-start;}
.tl-card{
  grid-column:1; grid-row:1;
  border-top:1px solid rgba(255,255,255,.1);
  padding:1.2rem 0 2.6rem; text-align:right;
}
.tl-srow:nth-child(odd) .tl-card{ grid-column:3; text-align:left; }
.tl-period{
  display:block; font-family:'Jost Variable',system-ui,sans-serif;
  font-size:0.72rem; letter-spacing:.2em; text-transform:lowercase;
  color:#E8B86D; margin-bottom:.5rem;
}
.tl-title{
  font-family:'Spectral',Georgia,serif; font-weight:400; font-size:1.1rem;
  color:#F0F0F6; margin-bottom:.4rem; line-height:1.3;
}
.tl-desc{ font-size:.84rem; color:#8E91AB; line-height:1.7; max-width: 56ch; }
.tl-mark{ grid-column:2; grid-row:1; position:relative; display:flex; justify-content:center; padding-top:1.15rem; z-index:2; }
.tl-connector{
  position:absolute; top:1.35rem; height:1px; width:32px; right:50%;
  background:linear-gradient(to left,transparent,rgba(232,184,109,.4));
}
.tl-srow:nth-child(odd) .tl-connector{ right:auto; left:50%; background:linear-gradient(to right,transparent,rgba(232,184,109,.4)); }
.tl-dot{
  width:9px; height:9px; border-radius:50%; border:1px solid #E8B86D;
  background:#08080E; box-shadow:0 0 0 5px rgba(232,184,109,.07);
}

/* ── Fleet — editorial, borderless (no card box) ── */
.fleet-card{background:transparent;border:none;border-top:1px solid rgba(255,255,255,.08);border-radius:0;padding:1.5rem 0 0;transition:none;}

/* ── Client — showcase, borderless (image keeps rounding) ── */
.client-card{border-radius:0;overflow:visible;background:transparent;border:none;transition:transform .4s var(--expo);}
.client-card:hover{transform:translateY(-4px);}
.client-card > div:first-child{border-radius:4px;overflow:hidden;border:1px solid rgba(255,255,255,.08);}

/* ── Cert badge ── */
.cert-row:hover{background:rgba(255,255,255,.025);}

/* ── Value — editorial numbered row (no card box) ── */
.val-card{background:transparent;border:none;border-top:1px solid rgba(255,255,255,.08);border-radius:0;padding:1.75rem 0 0;transition:none;}

/* ── Manifesto text ── */
.manifesto-word{display:inline;opacity:.25;transition:opacity .4s ease;}
.manifesto-word.lit{opacity:1;}

/* ── Number odometer ── */
@keyframes countUp{from{transform:translateY(100%);opacity:0}to{transform:none;opacity:1}}

  @media(max-width:767px){
    #about-hero-grid{grid-template-columns:1fr!important;}
    .portrait{width:100%!important;}
    #team-grid{grid-template-columns:repeat(2,1fr)!important;}
    #clients-grid{grid-template-columns:1fr!important;}
    #values-grid{grid-template-columns:1fr!important;}
    #certs-grid{grid-template-columns:1fr!important;}
    #tl-wrap .tl-srow{grid-template-columns:38px 1fr!important;}
    #tl-wrap .tl-card,
    #tl-wrap .tl-srow:nth-child(odd) .tl-card{ grid-column:2!important; text-align:left!important; }
    #tl-wrap .tl-mark{ grid-column:1!important; }
    #tl-wrap .tl-connector{ display:none!important; }
    #steps-grid{grid-template-columns:1fr!important;}
    #tl-spine{display:none!important;}
  }

/* Certificate rows: the fixed 11rem status column overflowed a phone screen. */
@media (max-width: 700px) {
  .cert-row { grid-template-columns: 2.25rem 1fr !important; gap: .4rem .9rem !important; padding: 1rem .2rem !important; }
  .cert-row > :last-child { grid-column: 2; text-align: left !important; }
}

/* Mobile legibility floor — 9–11px labels are unreadable on a phone. */
@media (max-width: 700px) {
  .tl-period { font-size: 0.78rem !important;   span[style*='.63rem'] { font-size: 0.78rem !important; }
}
  .cert-row span, .cert-row p { font-size: .78rem !important; }
}
</style>

<Header lang={lang}/>
<main style="background:#08080E;color:#F0F0F6;overflow-x:hidden;">

<CineHero
  lang={lang}
  photo="/images/projects/agios-villa.webp"
  index="Helyot · Cyprus"
  eyebrow="About the company"
  titleHtml={`35 specialists. One contract.<br/><em>Your price never changes.</em>`}
  subtitle="Every person who works on your property is directly employed by Helyot — no agencies, no subcontractors, no strangers. The same team that designs your renovation builds it, and backs it with a 5-year structural warranty."
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'About' }]}
  cta={{ label: 'Meet the team', href: '#team' }}
  ctaSecondary={{ label: 'Start a project', href: '#booking' }}
/>

<!-- Credentials — pure typography, one row per licence -->
<section style="background:#0A0A12;border-bottom:1px solid rgba(255,255,255,.06);padding:4rem 0;">
  <div class="container-wide">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem;padding-bottom:1rem;border-bottom:1px solid rgba(255,255,255,.08);flex-wrap:wrap;gap:1rem;">
      <p class="cine-label"><span class="cine-label__index">Legal standing · Cyprus</span>Licensed & insured</p>
      <div style="display:flex;align-items:center;gap:.45rem;">
        <div style="width:5px;height:5px;border-radius:50%;background:#22c55e;box-shadow:0 0 7px rgba(34,197,94,.5);"></div>
        <span style="font-size:.72rem;color:#22c55e;font-weight:500;">All active</span>
      </div>
    </div>
    {[
      { title:'Licensed General Contractor',               auth:'Cyprus Dept. of Labour' },
      { title:'CERA Certified Electrical Installations',   auth:'Electrical Authority of Cyprus' },
      { title:'Professional Indemnity Insurance',          auth:'Generali Insurance Cyprus' },
      { title:'Public Liability — €2M per incident',       auth:'Generali Insurance Cyprus' },
      { title:'Energy Auditor Certified',                  auth:'Cyprus Energy Service' },
      { title:'Fixed-Price Contracts',                     auth:'Cyprus Contract Law Cap. 149' },
    ].map((row) => (
      <div data-reveal style="display:flex;align-items:baseline;justify-content:space-between;gap:1rem;padding:1rem 0;border-top:1px solid rgba(255,255,255,.06);">
        <p style="font-size:.95rem;color:#B8B8CC;font-weight:400;line-height:1.3;flex:1;font-family:'Spectral',Georgia,serif;">{row.title}</p>
        <p style="font-size:.72rem;color:#8288A5;white-space:nowrap;flex-shrink:0;text-align:right;letter-spacing:.03em;">{row.auth}</p>
      </div>
    ))}
    <p style="margin-top:1.5rem;font-size:0.72rem;color:#8288A5;letter-spacing:.03em;">Documentation available on request · Limassol office</p>
  </div>
</section>


<!-- ══ §2 MANIFESTO ═══════════════════════════════════════════════════════ -->
<section style="background:#06060A;border-top:1px solid rgba(255,255,255,.07);padding:3rem 0;">
  <div style="max-width:820px;margin:0 auto;padding:0 2rem;">
    <p style="font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.22em;color:var(--gold);margin-bottom:1.75rem;" class="ar">WHY WE EXIST</p>

    <!-- Quote block -->
    <blockquote class="ar" style="margin:0;position:relative;padding-left:1.5rem;border-left:2px solid rgba(232,184,109,.25);">
      <!-- Decorative opening mark -->
      <span aria-hidden="true" style="position:absolute;top:-.75rem;left:-.25rem;font-family:Georgia,serif;font-size:5rem;line-height:1;color:rgba(232,184,109,.1);pointer-events:none;user-select:none;">&ldquo;</span>
      <p style="position:relative;font-family:'Spectral',Georgia,serif;font-style:italic;font-weight:500;font-size:clamp(.95rem,1.7vw,1.2rem);letter-spacing:-.005em;line-height:1.7;color:#8288A5;">
        I watched too many homeowners in Limassol lose money to contractors who promised a fixed price, then revised the invoice twice a month. We built Helyot around one rule: the price you sign is the price you pay. No asterisks, no provisionals, no surprises. Every trade in-house. Full accountability from the first meeting to the last day of your 5-year warranty.
      </p>
    </blockquote>

    <!-- Attribution -->
    <div class="ar" style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid rgba(255,255,255,.05);display:flex;align-items:center;gap:.875rem;">
      <div style="width:2rem;height:2rem;border-radius:4px;background:rgba(232,184,109,.07);border:1px solid rgba(232,184,109,.15);display:flex;align-items:center;justify-content:center;font-family:'Spectral',Georgia,serif;font-weight:300;font-size:.72rem;color:var(--gold);flex-shrink:0;">AM</div>
      <div>
        <p style="font-weight:600;font-size:0.78rem;color:#B0B0C8;">Alexander M.</p>
        <p style="font-size:0.72rem;color:#8288A5;">Founder, Helyot · Limassol</p>
      </div>
    </div>
  </div>
</section>


<!-- ══ §3 TIMELINE ════════════════════════════════════════════════════════ -->
<section style="background:#08080E;border-top:1px solid rgba(255,255,255,.07);padding:5rem 0;">
  <div style="max-width:1280px;margin:0 auto;padding:0 2rem;">
    <div class="ar" style="text-align:center;margin-bottom:4.5rem;">
      <p style="font-size:0.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.18em;color:var(--gold);margin-bottom:.5rem;">OUR STORY</p>
      <h2 style="font-family:'Spectral',Georgia,serif;font-weight:300;font-size:clamp(1.9rem,3.6vw,2.7rem);letter-spacing:-.025em;">Founded 2022. 500+ projects. Always on time.</h2>
    </div>

    <!-- Snake/zigzag timeline -->
    <div id="tl-wrap" style="position:relative;max-width:860px;margin:0 auto;">
      <!-- Vertical spine through center of 64px column -->
      <div id="tl-spine" style="position:absolute;left:50%;top:32px;bottom:48px;width:1px;background:linear-gradient(to bottom,rgba(232,184,109,.6),rgba(255,255,255,.1) 8%,rgba(255,255,255,.1) 92%,transparent);transform:translateX(-50%);pointer-events:none;" aria-hidden="true"></div>

      {milestones.map((m, i) => (
        <div class="ar tl-srow" data-delay={String(i * 80)}>
          {/* One card only — the side is chosen in CSS. Rendering both and
              hiding one duplicated every milestone for search engines and
              screen readers. */}
          <div class="tl-card">
            <span class="tl-period">{m.period}</span>
            <p class="tl-title">{m.title}</p>
            <p class="tl-desc">{m.desc}</p>
          </div>
          <div class="tl-mark" aria-hidden="true">
            <span class="tl-connector"></span>
            <span class="tl-dot"></span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>


<!-- ══ §4 TEAM ════════════════════════════════════════════════════════════ -->
<section id="team" style="background:#06060A;border-top:1px solid rgba(255,255,255,.07);padding:5rem 0;">
  <div style="max-width:1280px;margin:0 auto;padding:0 2rem;">
    <div class="ar" style="text-align:center;margin-bottom:3.5rem;">
      <p style="font-size:0.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.18em;color:var(--gold);margin-bottom:.5rem;">THE PEOPLE</p>
      <h2 style="font-family:'Spectral',Georgia,serif;font-weight:300;font-size:clamp(1.9rem,3.6vw,2.7rem);letter-spacing:-.025em;margin-bottom:.75rem;">The people who will work on your home.</h2>
      <p style="color:#8288A5;max-width:520px;margin:0 auto;">Every person listed here is on Helyot's payroll. One team, one standard — every specialist directly employed and accountable to you.</p>
    </div>

    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem;" id="team-grid">
      {team.map((m, i) => (
        <div class="team-card ar-sc" data-delay={String(i*70)} style={`--portrait-accent:${m.accent};`}>
          <!-- Portrait -->
          <div class="portrait" style={`background:${m.g};margin-bottom:1.25rem;box-shadow:0 4px 20px rgba(0,0,0,.4);`}>
            {m.photo
              ? <img src={m.photo} alt={m.name} width="240" height="240" loading="lazy"
                     style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top;"/>
              : <span class="portrait-init" style={`color:${m.accent.replace('.','0.').replace('rgba','rgba').slice(0,-1).replace(/,[^,]+$/, ',0.9)')};`}>{m.initials}</span>
            }
          </div>
          <!-- Info -->
          <p style="font-family:'Spectral',Georgia,serif;font-weight:400;font-size:.95rem;color:#F0F0F6;margin-bottom:.2rem;">{m.name}</p>
          <p style="font-size:0.72rem;color:var(--gold);margin-bottom:.25rem;">{m.role}</p>
