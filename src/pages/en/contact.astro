---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/shared/Header.astro';
import Footer from '../../components/shared/Footer.astro';
import CineHero from '../../components/shared/CineHero.astro';
import CookieConsent from '../../components/ui/CookieConsent.astro';
import FloatingContactBar from '../../components/ui/FloatingContactBar.astro';
import ProjectEnquiryForm from '../../components/sections/ProjectEnquiryForm.astro';
import { t } from '../../i18n/ui';

const lang = 'en';
const tr = (k: string) => t(lang, k as any);
/* Sourced from i18n so contact details can never drift page-to-page. */
const phone    = tr('site.phone');
const phoneRaw = tr('site.whatsapp');
const email    = tr('site.email');
const address  = 'Gladstonos 120, 3032 Limassol, Cyprus';
const hours    = ['Mon–Fri: 08:00–18:00', 'Saturday: 09:00–14:00', 'Sunday: Closed'];
---

<BaseLayout lang={lang}
  title="Contact Helyot — Limassol Renovation"
  description="Contact Helyot renovation in Limassol. Phone, WhatsApp, email and office address. Free site visit within 48 hours.">

<Header lang={lang}/>
<main style="background:#08080E;color:#F0F0F6;overflow-x:hidden;">

<CineHero
  lang={lang}
  compact={true}
  index="Get in touch"
  eyebrow="Contact"
  titleHtml={`We reply within <em>15 minutes.</em>`}
  subtitle="Call, WhatsApp or email — we're available Monday–Saturday. Free site visit within 48 hours, no obligation."
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Contact' }]}
/>

<!-- ══ MAIN CONTENT ═══════════════════════════════════════════════════════ -->
<section style="padding:3.5rem 0 5rem;">
  <div style="max-width:1280px;margin:0 auto;padding:0 2rem;">
    <div id="ct-grid" style="display:grid;grid-template-columns:1fr 1.5fr;gap:2.5rem;align-items:start;">

      <!-- ─── LEFT COLUMN ──────────────────────────────────────────── -->
      <div style="display:flex;flex-direction:column;gap:1.5rem;">

        <!-- Direct contacts -->
        <div style="border-top:1px solid rgba(255,255,255,.12);padding:1.4rem 0 0;">
          <p style="font-size:.6rem;font-weight:600;text-transform:uppercase;letter-spacing:.18em;color:#8288A5;margin-bottom:1.25rem;">DIRECT CONTACTS</p>

          <!-- Phone -->
          <a href={`tel:${phoneRaw}`} style="display:flex;align-items:center;gap:1rem;padding:.875rem 0;border-bottom:1px solid rgba(255,255,255,.05);text-decoration:none;transition:opacity .15s;" onmouseover="this.style.opacity='.75'" onmouseout="this.style.opacity='1'">
            <div style="width:2.25rem;height:2.25rem;border-radius:4px;background:rgba(232,184,109,.1);border:1px solid rgba(232,184,109,.2);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="#E8B86D" aria-hidden="true"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
            </div>
            <div>
              <p style="font-size:0.72rem;color:#8288A5;margin:0 0 .1rem;">Phone</p>
              <p style="font-size:0.95rem;font-weight:600;color:#F0F0F6;margin:0;">{phone}</p>
            </div>
          </a>

          <!-- WhatsApp -->
          <a href={`https://wa.me/${phoneRaw.replace('+','')}`} target="_blank" rel="noopener noreferrer" style="display:flex;align-items:center;gap:1rem;padding:.875rem 0;border-bottom:1px solid rgba(255,255,255,.05);text-decoration:none;transition:opacity .15s;" onmouseover="this.style.opacity='.75'" onmouseout="this.style.opacity='1'">
            <div style="width:2.25rem;height:2.25rem;border-radius:4px;background:rgba(34,197,94,.08);border:1px solid rgba(34,197,94,.2);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="#22c55e" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.125.555 4.122 1.528 5.855L0 24l6.335-1.652A11.954 11.954 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.003-1.375l-.36-.214-3.727.977.994-3.637-.235-.374A9.818 9.818 0 1112 21.818z"/></svg>
            </div>
            <div>
              <p style="font-size:0.72rem;color:#8288A5;margin:0 0 .1rem;">WhatsApp</p>
              <p style="font-size:0.95rem;font-weight:600;color:#F0F0F6;margin:0;">{phone}</p>
            </div>
          </a>

          <!-- Email -->
          <a href={`mailto:${email}`} style="display:flex;align-items:center;gap:1rem;padding:.875rem 0;text-decoration:none;transition:opacity .15s;" onmouseover="this.style.opacity='.75'" onmouseout="this.style.opacity='1'">
            <div style="width:2.25rem;height:2.25rem;border-radius:4px;background:rgba(100,140,240,.08);border:1px solid rgba(100,140,240,.2);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#7CACF8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div>
              <p style="font-size:0.72rem;color:#8288A5;margin:0 0 .1rem;">Email</p>
              <p style="font-size:0.95rem;font-weight:600;color:#F0F0F6;margin:0;">{email}</p>
            </div>
          </a>
        </div>

        <!-- Working hours -->
        <div style="border-top:1px solid rgba(255,255,255,.12);padding:1.4rem 0 0;">
          <p style="font-size:.6rem;font-weight:600;text-transform:uppercase;letter-spacing:.18em;color:#8288A5;margin-bottom:1.125rem;">WORKING HOURS</p>
          <div style="display:flex;flex-direction:column;gap:.5rem;">
            {hours.map((h, i) => (
              <div style={`display:flex;align-items:center;justify-content:space-between;gap:1rem;${i < hours.length-1 ? 'padding-bottom:.5rem;border-bottom:1px solid rgba(255,255,255,.04);' : ''}`}>
                <span style={`font-size:0.9rem;${h.includes('Closed') ? 'color:#8288A5;' : 'color:#B8B8CC;font-weight:500;'}`}>{h.split(':')[0]}</span>
                <span style={`font-size:0.9rem;${h.includes('Closed') ? 'color:#8288A5;' : 'color:#F0F0F6;font-weight:600;'}`}>{h.includes('Closed') ? 'Closed' : h.split(': ')[1]}</span>
              </div>
            ))}
          </div>
          <div style="margin-top:1.125rem;padding-top:1rem;border-top:1px solid rgba(255,255,255,.05);display:flex;align-items:center;gap:.5rem;">
            <div style="width:6px;height:6px;border-radius:50%;background:#22c55e;box-shadow:0 0 6px rgba(34,197,94,.6);flex-shrink:0;"></div>
            <span style="font-size:0.72rem;color:#22c55e;font-weight:500;">Responding now — typical reply in 12 min</span>
          </div>
        </div>

        <!-- Social media -->
        <div style="border-top:1px solid rgba(255,255,255,.12);padding:1.4rem 0 0;">
          <p style="font-size:.6rem;font-weight:600;text-transform:uppercase;letter-spacing:.18em;color:#8288A5;margin-bottom:1.125rem;">FOLLOW US</p>
          <div style="display:flex;flex-direction:column;gap:.75rem;">

            <!-- Instagram -->
            <a href={tr('site.instagram')} target="_blank" rel="noopener noreferrer"
               style="display:flex;align-items:center;gap:.875rem;text-decoration:none;transition:opacity .15s;" onmouseover="this.style.opacity='.75'" onmouseout="this.style.opacity='1'">
              <div style="width:2rem;height:2rem;border-radius:4px;background:linear-gradient(135deg,#833ab4,#fd1d1d,#fcb045);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              </div>
              <div>
                <p style="font-size:0.72rem;font-weight:600;color:#B8B8CC;margin:0;">@helyot.cy</p>
                <p style="font-size:0.72rem;color:#8288A5;margin:0;">Instagram</p>
              </div>
            </a>

            <!-- Facebook -->
            <a href={tr('site.facebook')} target="_blank" rel="noopener noreferrer"
               style="display:flex;align-items:center;gap:.875rem;text-decoration:none;transition:opacity .15s;" onmouseover="this.style.opacity='.75'" onmouseout="this.style.opacity='1'">
              <div style="width:2rem;height:2rem;border-radius:4px;background:#1877F2;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </div>
              <div>
                <p style="font-size:0.72rem;font-weight:600;color:#B8B8CC;margin:0;">Helyot</p>
                <p style="font-size:0.72rem;color:#8288A5;margin:0;">Facebook</p>
              </div>
            </a>

            <!-- LinkedIn -->
            <a href={tr('site.linkedin')} target="_blank" rel="noopener noreferrer"
               style="display:flex;align-items:center;gap:.875rem;text-decoration:none;transition:opacity .15s;" onmouseover="this.style.opacity='.75'" onmouseout="this.style.opacity='1'">
              <div style="width:2rem;height:2rem;border-radius:4px;background:#0A66C2;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </div>
              <div>
                <p style="font-size:0.72rem;font-weight:600;color:#B8B8CC;margin:0;">Helyot Ltd.</p>
                <p style="font-size:0.72rem;color:#8288A5;margin:0;">LinkedIn</p>
              </div>
            </a>

          </div>
        </div>

        <!-- Legal / LLC registration -->
        <div style="border-top:1px solid rgba(255,255,255,.12);padding:1.4rem 0 0;">
          <p style="font-size:.6rem;font-weight:600;text-transform:uppercase;letter-spacing:.18em;color:#8288A5;margin-bottom:1.125rem;">LEGAL ENTITY</p>
          <div style="display:flex;flex-direction:column;gap:.625rem;">
            {[
              { label:'Company',            value:'Helyot Ltd.' },
              { label:'Incorporated',       value:'January 2022' },
              { label:'Jurisdiction',       value:'Republic of Cyprus' },
            ].map((row, i) => (
              <div style={`display:flex;justify-content:space-between;gap:1rem;${i > 0 ? 'padding-top:.5rem;border-top:1px solid rgba(255,255,255,.04);' : ''}`}>
                <span style="font-size:0.72rem;color:#8288A5;">{row.label}</span>
                <span style="font-size:0.72rem;font-weight:600;color:#B8B8CC;text-align:right;">{row.value}</span>
              </div>
            ))}
          </div>
          <p style="font-size:.65rem;color:#8288A5;margin-top:1rem;padding-top:.875rem;border-top:1px solid rgba(255,255,255,.04);line-height:1.5;">
            Registration documents available on request. All licences and insurances active.
          </p>
        </div>

      </div>

      <!-- ─── RIGHT COLUMN ─────────────────────────────────────────── -->
      <div style="display:flex;flex-direction:column;gap:1.5rem;">

        <!-- Map -->
        <div style="background:#0D0D1A;border:1px solid rgba(255,255,255,.08);border-radius:4px;overflow:hidden;">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13238.765!2d33.0354!3d34.6841!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14e733208d1d5b3d%3A0x3bd19c553f0afc34!2sLimassol%2C+Cyprus!5e0!3m2!1sen!2s!4v1620000000000!5m2!1sen!2s"
            width="100%"
            height="340"
            style="display:block;border:none;filter:invert(90%) hue-rotate(180deg);"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
            title="Helyot office location — Limassol, Cyprus"
          ></iframe>
        </div>

        <!-- Address + directions -->
        <div style="border-top:1px solid rgba(255,255,255,.12);padding:1.4rem 0 0;">
          <p style="font-size:.6rem;font-weight:600;text-transform:uppercase;letter-spacing:.18em;color:#8288A5;margin-bottom:1.25rem;">OFFICE ADDRESS</p>

          <div style="display:flex;gap:1rem;margin-bottom:1.5rem;">
            <div style="width:2.25rem;height:2.25rem;border-radius:4px;background:rgba(232,184,109,.1);border:1px solid rgba(232,184,109,.2);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:.1rem;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#E8B86D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <p style="font-size:0.95rem;font-weight:600;color:#F0F0F6;margin:0 0 .3rem;">{address}</p>
              <a href="https://maps.google.com/?q=Gladstonos+120+Limassol+Cyprus" target="_blank" rel="noopener noreferrer"
                 style="font-size:.78rem;color:#E8B86D;text-decoration:none;display:inline-flex;align-items:center;gap:.3rem;transition:opacity .15s;" onmouseover="this.style.opacity='.75'" onmouseout="this.style.opacity='1'">
                Open in Google Maps
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
            </div>
          </div>

          <!-- Directions -->
          <div style="border-top:1px solid rgba(255,255,255,.06);padding-top:1.25rem;">
            <p style="font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:#8288A5;margin-bottom:.875rem;">HOW TO GET THERE</p>
            <div style="display:flex;flex-direction:column;gap:.75rem;">
              <div style="display:flex;gap:.875rem;">
                <div style="width:1.5rem;height:1.5rem;border-radius:4px;background:rgba(255,255,255,.05);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:.1rem;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#8288A5" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10l2 1M13 16H9m4 0h3m3 0h1v-4.586a1 1 0 00-.293-.707l-3.414-3.414A1 1 0 0015.586 7H13"/></svg>
                </div>
                <p style="font-size:0.84rem;color:#9090A8;line-height:1.6;margin:0;"><strong style="color:#B8B8CC;">By car:</strong> From the A1 highway take the Limassol Old Town exit, follow Gladstonos Street. Parking available on-street and in the municipal car park 200m away.</p>
              </div>
              <div style="display:flex;gap:.875rem;">
                <div style="width:1.5rem;height:1.5rem;border-radius:4px;background:rgba(255,255,255,.05);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:.1rem;">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#8288A5" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                </div>
                <p style="font-size:0.84rem;color:#9090A8;line-height:1.6;margin:0;"><strong style="color:#B8B8CC;">By taxi / rideshare:</strong> Ask for Gladstonos 120, Limassol. 10 minutes from Limassol Marina.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick CTA -->
        <div style="background:linear-gradient(135deg,rgba(232,184,109,.08) 0%,rgba(232,184,109,.03) 100%);border:1px solid rgba(232,184,109,.18);border-radius:4px;padding:1.75rem;display:flex;align-items:center;justify-content:space-between;gap:1.5rem;flex-wrap:wrap;">
          <div>
            <p style="font-family:'Spectral',Georgia,serif;font-weight:400;font-size:1.02rem;color:#F0F0F6;margin:0 0 .3rem;">Ready to start your project?</p>
            <p style="font-size:0.84rem;color:#8288A5;margin:0;">Free site visit within 48 hours. Fixed price guaranteed.</p>
          </div>
          <a href="#booking"
             style="display:inline-flex;align-items:center;gap:.4rem;background:transparent;border:1.5px solid #E8B86D;color:#E8B86D;font-family:'Spectral',Georgia,serif;font-weight:400;font-size:0.9rem;padding:.875rem 1.5rem;border-radius:4px;text-decoration:none;white-space:nowrap;box-shadow:0 4px 18px rgba(232,184,109,.25);transition:background .15s,transform .15s;" onmouseover="this.style.background='#E8B86D';this.style.color='#121219';this.style.transform='translateY(-1px)'" onmouseout="this.style.background='#E8B86D';this.style.color='#121219';this.style.transform=''">
            Book free visit
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

      </div>
    </div>
  </div>
</section>

<ProjectEnquiryForm lang={lang} />

</main>
<Footer lang={lang}/>
<CookieConsent lang={lang}/>
<FloatingContactBar lang={lang}/>
</BaseLayout>

<script is:inline>
(function(){
  function fix(){
    var g = document.getElementById('ct-grid');
    if(g) g.style.gridTemplateColumns = window.innerWidth < 900 ? '1fr' : '1fr 1.5fr';
  }
  fix(); window.addEventListener('resize', fix);
})();
</script>

<style>
/* Mobile legibility floor — 9–11px labels are unreadable on a phone. */
@media (max-width: 700px) {
  p[style*="font-size:.6rem"] { font-size: 0.72rem !important; }
}
</style>
