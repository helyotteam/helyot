const milestones = [
  { period:'Начало 2022',  title:'Основание Helyot',              desc:'Александр М. и Дмитрий П. основывают Helyot с командой из 8 штатных специалистов — строители, электрики, дизайнеры.' },
  { period:'Конец 2022',   title:'Первые 100 сданных объектов',   desc:'100 ремонтов в первый год. Ноль споров, ноль неоплаченных счетов. Сарафанное радио становится главным источником клиентов.' },
  { period:'Q2 2023',      title:'Дизайн-сопровождение каждого проекта', desc:'Полная дизайн-концепция стала стандартом для каждого проекта — планы, материалы, свет — до начала работ.' },
  { period:'Q4 2023',      title:'35 специалистов в штате',       desc:'Все работы полностью своими силами: штукатуры, электрики, сантехники, плиточники, столяры. Одна точка ответственности.' },
  { period:'Q1 2024',      title:'Сертификация по энергосбережению',desc:'Сертифицированы Cyprus Energy Service. 40+ клиентов получили субсидии ЕС свыше €10 000 каждый.' },
  { period:'Q4 2024',      title:'500+ сданных проектов',          desc:'500+ завершённых ремонтов. 4.9★ от 47 подтверждённых отзывов Google. Самая длинная гарантия на конструктив в Лимасоле.' },
