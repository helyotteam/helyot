---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/shared/Header.astro';
import Footer from '../../components/shared/Footer.astro';
import CineHero from '../../components/shared/CineHero.astro';
import CookieConsent from '../../components/ui/CookieConsent.astro';
import FloatingContactBar from '../../components/ui/FloatingContactBar.astro';
import BookingForm from '../../components/sections/BookingForm.astro';

const lang = 'ru';

const team = [
  { initials:'AM', name:'Александр М.', role:'Основатель и директор',          exp:'15 лет', spec:['Стратегия','Работа с клиентами'],     g:'linear-gradient(135deg,#1a0f00,#4a2a10)', accent:'rgba(232,184,109,.25)' },
