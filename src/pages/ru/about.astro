<script is:inline>
(function() {
  var EXPO = 'cubic-bezier(0.16,1,0.3,1)';
  function initReveal() {
    var items = document.querySelectorAll('.ar,.ar-sc,.ar-l,.ar-r');
    items.forEach(function(el) {
      var t = el.classList.contains('ar-sc') ? 'scale(0.95)' : 'translateY(24px)';
      el.style.opacity='0'; el.style.transform=t;
      el.style.transition='opacity .7s '+EXPO+', transform .7s '+EXPO;
    });
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (!entry.isIntersecting) return;
        var el = entry.target;
        var delay = parseInt(el.dataset.delay || '0');
        setTimeout(function() { el.style.opacity='1'; el.style.transform='none'; }, delay);
        io.unobserve(el);
      });
    }, { threshold: 0.05 });
    items.forEach(function(el) { io.observe(el); });
  }
  function fixGrids() {
    var w = window.innerWidth;
    var hg = document.getElementById('about-hero-grid');
    if (hg) hg.style.gridTemplateColumns = w < 900 ? '1fr' : '1fr 1fr';
    var tg = document.getElementById('team-grid');
    if (tg) tg.style.gridTemplateColumns = w < 640 ? 'repeat(2,1fr)' : w < 900 ? 'repeat(3,1fr)' : 'repeat(4,1fr)';
    var cg = document.getElementById('clients-grid');
    if (cg) cg.style.gridTemplateColumns = w < 640 ? '1fr' : w < 900 ? 'repeat(2,1fr)' : 'repeat(3,1fr)';
    var sg = document.getElementById('steps-grid');
    if (sg) sg.style.gridTemplateColumns = w < 640 ? '1fr' : w < 900 ? 'repeat(2,1fr)' : 'repeat(4,1fr)';
    var vg = document.getElementById('values-grid');
    if (vg) vg.style.gridTemplateColumns = w < 640 ? '1fr' : w < 900 ? 'repeat(2,1fr)' : 'repeat(3,1fr)';
    var spine = document.getElementById('tl-spine');
    /* Стороны таймлайна теперь в CSS — переключать нечего. */
  }
  if (document.readyState==='loading') {
    document.addEventListener('DOMContentLoaded',function(){initReveal();fixGrids();});
  } else { initReveal(); fixGrids(); }
  window.addEventListener('resize', fixGrids);
})();
</script>
