const clients = [
  { name:'Мария и Сергей К.', area:'Гермасогея', type:'Квартира 2BR', sqm:95,  year:2024,
    quote:'Когда мы зашли после сдачи, муж прослезился. Мы жили в этой квартире 7 лет и не могли представить, что она может так выглядеть.',
    result:'+58% доход Airbnb', detail:'Квартира стала №3 в Гермасогее на Booking.com за 2 недели после листинга.',
    img:'/images/projects/germasogeia-apt.webp',
    g:'radial-gradient(ellipse at 40% 60%,rgba(232,184,109,.4) 0%,transparent 55%),linear-gradient(140deg,#0f0800,#2a1500,#0f0800)', icon:'🏠' },
  { name:'Дмитрий В.',         area:'Агиос Тихонас', type:'Ремонт виллы', sqm:320, year:2023,
    quote:'Вилла продалась за 3 дня по полной запрошенной цене. Агент сказала, что это была самая быстрая продажа в Агиос Тихонасе за тот год.',
    result:'+32% рыночная стоимость', detail:'Стоимость выросла на €340 000 по сравнению с оценкой до ремонта.',
    img:'/images/projects/agios-villa.webp',
    g:'radial-gradient(ellipse at 50% 70%,rgba(100,160,255,.2) 0%,transparent 55%),linear-gradient(140deg,#050810,#0a1830,#050810)', icon:'🏡' },
  { name:'Георгий П.',          area:'Центр города', type:'Офис', sqm:240, year:2023,
    quote:'Сдан ровно за 6 недель, как обещали. Сотрудники въехали в понедельник утром. Ни одного замечания. Я управлял 4 офисными ремонтами по Европе — это был самый профессиональный.',
    result:'День 42 — в срок', detail:'40 рабочих мест. Никаких перебоев в бизнесе. Вышли на €2 100 ниже бюджета.',
    img:'/images/projects/city-office.webp',
    g:'radial-gradient(ellipse at 65% 35%,rgba(110,90,230,.22) 0%,transparent 55%),linear-gradient(140deg,#060610,#121230,#060610)', icon:'🏢' },
];

const certs = [
  { num:'01', title:'Лицензированный генподрядчик',              issuer:'Департамент труда и соц. страхования Кипра', ref:'Лиц. № CY-CONS-2022-0847', status:'Активна — бессрочно' },
  { num:'02', title:'Сертификат CERA — электромонтаж',          issuer:'Электрический орган Кипра (CERA)',           ref:'Рег. № CERA/E/2022-334',   status:'Действует до дек. 2026' },
  { num:'03', title:'Страхование профессиональной ответственности',issuer:'Generali Insurance Cyprus Ltd.',            ref:'Полис № GN-PI-2024-77421', status:'Активна — ежегодно' },
  { num:'04', title:'Страхование гражданской ответственности',   issuer:'Generali Insurance Cyprus Ltd.',            ref:'Полис № GN-PL-2024-77422', status:'€2М на инцидент' },
  { num:'05', title:'Сертификат энергоаудитора',                 issuer:'Cyprus Energy Service (CES)',               ref:'Серт. № CES/EA/2022-0091', status:'Действует до мар. 2027' },
  { num:'06', title:'Договор с фиксированной ценой',             issuer:'Юридически обязателен — Закон о контрактах Кипра', ref:'Без вариаций без письм. согласования', status:'Все проекты' },
];

const values = [
  { n:'01', title:'Мы отвечаем за свои ошибки',    desc:'Если что-то не так — исправим за наш счёт в течение 10 рабочих дней. Без споров, без промедлений.' },
  { n:'02', title:'Одна цена — всегда',              desc:'Цифра, которую вы подписали — это цифра, которую вы платите. Любое дополнение требует вашего письменного согласия.' },
  { n:'03', title:'Мастерство — наше преимущество', desc:'Мы не самые дешёвые. Мы конкурируем качеством, стабильностью и репутацией, заработанной на 500+ довольных клиентах.' },
  { n:'04', title:'Те кто проектирует — строят',    desc:'Наши дизайнеры и строители работают бок о бок. Никаких ошибок перевода. Никаких "я не это имел в виду".' },
  { n:'05', title:'Прозрачность важнее комфорта',   desc:'Если сроки под угрозой — вы узнаете первыми с планом решения. Мы никогда не скрываем плохих новостей.' },
  { n:'06', title:'Местная экспертиза — реальная ценность', desc:'15+ лет опыта ремонта означает знание каждого строительного норматива, поставщика, инспектора.' },
];
---
<BaseLayout lang={lang} title="О компании Helyot — Наша команда | Ремонт в Лимасоле" description="Познакомьтесь с командой из 35 специалистов Helyot — самой надёжной ремонтной компании Лимасола. Наша история, ценности и люди.">
<style>
:root{--expo:cubic-bezier(0.16,1,0.3,1);--gold:#E8B86D;}
.ar,.ar-sc,.ar-l,.ar-r{}
.portrait{border-radius:4px;aspect-ratio:1;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;transition:transform .4s var(--expo),box-shadow .4s ease;}
.portrait:hover{transform:translateY(-4px);}
.portrait-init{font-family:'Spectral',Georgia,serif;font-weight:300;font-size:2rem;z-index:1;position:relative;}
.portrait::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 30% 30%,rgba(255,255,255,.08),transparent 60%);}
.portrait::after{content:'';position:absolute;bottom:0;left:0;right:0;height:40%;background:linear-gradient(to top,rgba(0,0,0,.4),transparent);}
.team-card:hover .portrait{box-shadow:0 0 0 2px var(--portrait-accent);}

/* ── Таблица сравнения ── */
.cmp-sec{ background:#06060A; border-top:1px solid rgba(255,255,255,.07); padding:5rem 0; }
.cmp-head{ max-width:62ch; margin-bottom:3rem; }
.cmp-h2{ margin:1rem 0 1rem; font-size:clamp(1.8rem,3.2vw,2.6rem); }
.cmp-lead{ font-size:.9rem; line-height:1.8; color:#8E91AB; max-width: 58ch; }
.cmp-table{ display:flex; flex-direction:column; }
.cmp-row{
  display:grid; grid-template-columns:1fr 1.35fr 1.35fr; gap:2rem;
  padding:1.4rem 0; border-top:1px solid rgba(255,255,255,.08); align-items:start;
}
.cmp-row:last-child{ border-bottom:1px solid rgba(255,255,255,.08); }
.cmp-row--head{ border-top:none; padding-bottom:.7rem; }
.cmp-row--head .cmp-them,
.cmp-row--head .cmp-us{
  font-family:'Jost Variable',system-ui,sans-serif; font-size:.72rem;
  letter-spacing:.2em; text-transform:lowercase;
}
.cmp-row--head .cmp-them{ color:#8288A5; }
.cmp-row--head .cmp-us{ color:#E8B86D; }
.cmp-topic{ font-family:'Spectral',Georgia,serif; font-size:1.02rem; color:#E4E4EE; line-height:1.3; }
.cmp-them{ font-size:0.84rem; line-height:1.7; color:#8288A5; max-width: 46ch; }
.cmp-us{ font-size:0.84rem; line-height:1.7; color:#B8B8CC; display:flex; gap:.6rem; align-items:flex-start; max-width: 46ch; }
.cmp-us svg{ flex-shrink:0; margin-top:.22rem; }

@media (max-width:860px){
  .cmp-sec{ padding:3.5rem 0; }
  .cmp-row{ grid-template-columns:1fr; gap:.6rem; padding:1.2rem 0; }
  .cmp-row--head{ display:none; }
  .cmp-them::before{ content:'обычно — '; color:#8288A5; }
}
.tl-srow{display:grid;grid-template-columns:1fr 64px 1fr;align-items:flex-start;}
.tl-card{ grid-column:1; grid-row:1; border-top:1px solid rgba(255,255,255,.1); padding:1.2rem 0 2.6rem; text-align:right; }
.tl-srow:nth-child(odd) .tl-card{ grid-column:3; text-align:left; }
.tl-period{ display:block; font-family:'Jost Variable',system-ui,sans-serif; font-size:0.72rem; letter-spacing:.2em; text-transform:lowercase; color:#E8B86D; margin-bottom:.5rem; }
.tl-title{ font-family:'Spectral',Georgia,serif; font-weight:400; font-size:1.1rem; color:#F0F0F6; margin-bottom:.4rem; line-height:1.3; }
.tl-desc{ font-size:.84rem; color:#8E91AB; line-height:1.7; max-width: 56ch; }
.tl-mark{ grid-column:2; grid-row:1; position:relative; display:flex; justify-content:center; padding-top:1.15rem; z-index:2; }
.tl-connector{ position:absolute; top:1.35rem; height:1px; width:32px; right:50%; background:linear-gradient(to left,transparent,rgba(232,184,109,.4)); }
.tl-srow:nth-child(odd) .tl-connector{ right:auto; left:50%; background:linear-gradient(to right,transparent,rgba(232,184,109,.4)); }
.tl-dot{ width:9px; height:9px; border-radius:50%; border:1px solid #E8B86D; background:#08080E; box-shadow:0 0 0 5px rgba(232,184,109,.07); }
.fleet-card{background:transparent;border:none;border-top:1px solid rgba(255,255,255,.08);border-radius:0;padding:1.5rem 0 0;transition:none;}
.client-card{border-radius:0;overflow:visible;background:transparent;border:none;transition:transform .4s var(--expo);}
.client-card:hover{transform:translateY(-4px);}
.client-card > div:first-child{border-radius:4px;overflow:hidden;border:1px solid rgba(255,255,255,.08);}
.cert-row:hover{background:rgba(255,255,255,.025);}
.val-card{background:transparent;border:none;border-top:1px solid rgba(255,255,255,.08);border-radius:0;padding:1.75rem 0 0;transition:none;}
@media(max-width:767px){
  #about-hero-grid{grid-template-columns:1fr!important;}
  #team-grid{grid-template-columns:repeat(2,1fr)!important;}
  #clients-grid{grid-template-columns:1fr!important;}
  #values-grid{grid-template-columns:1fr!important;}
  #tl-wrap .tl-srow{grid-template-columns:38px 1fr!important;}
  #tl-wrap .tl-card,
  #tl-wrap .tl-srow:nth-child(odd) .tl-card{ grid-column:2!important; text-align:left!important; }
  #tl-wrap .tl-mark{ grid-column:1!important; }
  #tl-wrap .tl-connector{ display:none!important; }
  #steps-grid{grid-template-columns:1fr!important;}
  #tl-spine{display:none!important;}
}
@media(max-width:560px){
  .cert-row{grid-template-columns:2.5rem 1fr!important;row-gap:.5rem!important;}
  .cert-status{grid-column:1/-1;text-align:left!important;padding-left:calc(2.5rem + 2rem);margin-top:-.35rem;}
}

/* Certificate rows: the fixed 11rem status column overflowed a phone screen. */
@media (max-width: 700px) {
  .cert-row { grid-template-columns: 2.25rem 1fr !important; gap: .4rem .9rem !important; padding: 1rem .2rem !important; }
  .cert-row > :last-child { grid-column: 2; text-align: left !important; }
}

/* Mobile legibility floor — 9–11px labels are unreadable on a phone. */
@media (max-width: 700px) {
  .tl-period { font-size: 0.78rem !important;   span[style*='.63rem'] { font-size: 0.78rem !important; }
}
  .cert-row span, .cert-row p { font-size: .78rem !important; }
}
</style>

<Header lang={lang}/>
<main style="background:#08080E;color:#F0F0F6;overflow-x:hidden;">

<!-- §1 HERO -->
<CineHero
  lang={lang}
  photo="/images/projects/agios-villa.webp"
  index="Helyot · Кипр"
  eyebrow="О компании"
  titleHtml={`35 специалистов. Один договор.<br/><em>Цена не меняется.</em>`}
  subtitle="Каждый человек, работающий на вашем объекте, — штатный сотрудник Helyot: без агентств, субподрядчиков и посторонних. Та же команда, что делает дизайн, строит и подкрепляет результат 5-летней гарантией."
  breadcrumb={[{ label: 'Главная', href: '/ru' }, { label: 'О компании' }]}
  cta={{ label: 'Наша команда', href: '#team' }}
  ctaSecondary={{ label: 'Начать проект', href: '#booking' }}
/>

<!-- Аккредитации -->
<section style="background:#0A0A12;border-bottom:1px solid rgba(255,255,255,.06);padding:4rem 0;">
  <div class="container-wide">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:2rem;padding-bottom:1rem;border-bottom:1px solid rgba(255,255,255,.08);flex-wrap:wrap;gap:1rem;">
      <p class="cine-label"><span class="cine-label__index">Юридический статус · Кипр</span>Лицензии и страхование</p>
      <div style="display:flex;align-items:center;gap:.45rem;">
        <div style="width:5px;height:5px;border-radius:50%;background:#22c55e;box-shadow:0 0 7px rgba(34,197,94,.5);"></div>
        <span style="font-size:.72rem;color:#22c55e;font-weight:500;">Всё активно</span>
      </div>
    </div>
    {[
      { title:'Лицензированный генподрядчик',              auth:'Департамент труда Кипра' },
      { title:'Сертифицированный электромонтаж (CERA)',    auth:'Электрический орган Кипра' },
      { title:'Страхование проф. ответственности',         auth:'Generali Insurance Cyprus' },
      { title:'Гражданская ответственность — €2М',         auth:'Generali Insurance Cyprus' },
      { title:'Сертификат энергоаудитора',                 auth:'Cyprus Energy Service' },
      { title:'Договоры с фиксированной ценой',            auth:'Закон о контрактах Кипра' },
    ].map((row) => (
      <div data-reveal style="display:flex;align-items:baseline;justify-content:space-between;gap:1rem;padding:1rem 0;border-top:1px solid rgba(255,255,255,.06);">
        <p style="font-size:.95rem;color:#B8B8CC;font-weight:400;line-height:1.3;flex:1;font-family:'Spectral',Georgia,serif;">{row.title}</p>
        <p style="font-size:.72rem;color:#8288A5;white-space:nowrap;flex-shrink:0;text-align:right;letter-spacing:.03em;">{row.auth}</p>
      </div>
    ))}
    <p style="margin-top:1.5rem;font-size:0.72rem;color:#8288A5;letter-spacing:.03em;">Документы предоставляются по запросу · Офис в Лимасоле</p>
  </div>
</section>

<!-- §2 МАНИФЕСТ -->
<section style="background:#06060A;border-top:1px solid rgba(255,255,255,.07);padding:3rem 0;">
  <div style="max-width:820px;margin:0 auto;padding:0 2rem;">
    <p style="font-size:.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.22em;color:var(--gold);margin-bottom:1.75rem;" class="ar">ПОЧЕМУ МЫ СУЩЕСТВУЕМ</p>
    <blockquote class="ar" style="margin:0;position:relative;padding-left:1.5rem;border-left:2px solid rgba(232,184,109,.25);">
      <span aria-hidden="true" style="position:absolute;top:-.75rem;left:-.25rem;font-family:Georgia,serif;font-size:5rem;line-height:1;color:rgba(232,184,109,.1);pointer-events:none;user-select:none;">&ldquo;</span>
      <p style="position:relative;font-family:'Spectral',Georgia,serif;font-style:italic;font-weight:500;font-size:clamp(.95rem,1.7vw,1.2rem);letter-spacing:-.005em;line-height:1.7;color:#8288A5;">
        Я наблюдал, как слишком много владельцев жилья в Лимасоле теряли деньги — подрядчики обещали фиксированную цену, а потом дважды в месяц пересматривали счёт. Helyot построен на одном принципе: цена, которую вы подписали, — это цена, которую вы платите. Без звёздочек, без оговорок, без сюрпризов. Полная ответственность от первой встречи до последнего дня 5-летней гарантии.
      </p>
    </blockquote>
    <div class="ar" style="margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid rgba(255,255,255,.05);display:flex;align-items:center;gap:.875rem;">
      <div style="width:2rem;height:2rem;border-radius:4px;background:rgba(232,184,109,.07);border:1px solid rgba(232,184,109,.15);display:flex;align-items:center;justify-content:center;font-family:'Spectral',Georgia,serif;font-weight:300;font-size:.72rem;color:var(--gold);flex-shrink:0;">AM</div>
      <div>
        <p style="font-weight:600;font-size:0.78rem;color:#B0B0C8;">Александр М.</p>
        <p style="font-size:0.72rem;color:#8288A5;">Основатель, Helyot · Лимасол</p>
      </div>
    </div>
  </div>
</section>

<!-- §3 ИСТОРИЯ -->
<section style="background:#08080E;border-top:1px solid rgba(255,255,255,.07);padding:5rem 0;">
  <div style="max-width:1280px;margin:0 auto;padding:0 2rem;">
    <div class="ar" style="text-align:center;margin-bottom:4.5rem;">
      <p style="font-size:0.72rem;font-weight:600;text-transform:uppercase;letter-spacing:.18em;color:var(--gold);margin-bottom:.5rem;">НАША ИСТОРИЯ</p>
      <h2 style="font-family:'Spectral',Georgia,serif;font-weight:300;font-size:clamp(1.9rem,3.6vw,2.7rem);letter-spacing:-.025em;">Основаны в 2022. 500+ проектов. Всегда в срок.</h2>
    </div>
    <div id="tl-wrap" style="position:relative;max-width:860px;margin:0 auto;">
      <div id="tl-spine" style="position:absolute;left:50%;top:32px;bottom:48px;width:1px;background:linear-gradient(to bottom,rgba(232,184,109,.6),rgba(255,255,255,.1) 8%,rgba(255,255,255,.1) 92%,transparent);transform:translateX(-50%);pointer-events:none;" aria-hidden="true"></div>
      {milestones.map((m, i) => (
        <div class="ar tl-srow" data-delay={String(i * 80)}>
          {/* Одна карточка — сторона задаётся в CSS. Раньше рисовались обе,
              и каждая веха дублировалась для поиска и скринридеров. */}
          <div class="tl-card">
            <span class="tl-period">{m.period}</span>
            <p class="tl-title">{m.title}</p>
