---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/shared/Header.astro';
import Footer from '../../../../components/shared/Footer.astro';
import BookingForm from '../../../../components/sections/BookingForm.astro';
import { services } from '../../../../lib/servicesData';
import { matrixLocations, getLocationBySlug } from '../../../../lib/citiesData';
import { priceRowsBySlug, examplesBySlug } from '../../../../lib/pricingData';
import { getLocalAngle } from '../../../../lib/localAngles';
import { getTraitNotes } from '../../../../lib/traitNotes';
import { categoryHero, categoryBand, locationPhoto } from '../../../../lib/servicePhotos';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return services.flatMap(s =>
    matrixLocations.map(l => ({ params: { slug: s.slug, location: l.slug } }))
  );
}

const { slug, location } = Astro.params;
const svc = services.find(s => s.slug === slug)!;
const loc = getLocationBySlug(location!)!;
const lang = 'ru';
const angle = getLocalAngle(location!, svc.category);
/* Composed from the area's traits and this service — a different set of
   lines on almost every pair, where the category angle above is shared. */
const notes = getTraitNotes(svc.slug, loc.traits, 'ru');
const traitCtx = loc.traitContextRu ?? {};
const traitLabel: Record<string, string> = {"coastal": "Побережье", "older-stock": "Старый фонд", "managed": "Управляющая компания", "no-lift": "Без лифта", "hillside": "Склон", "conservation": "Охранная зона", "short-let": "Краткосрочная аренда", "premium": "Премиальный уровень"};

/* Цена с учётом локации — расчётная метка только для услуг за м²
   (округление к €5 — только когда оно не искажает малые ставки) */
const rawPrice = svc.priceUnit === 'sqm' && svc.priceFrom ? svc.priceFrom * loc.priceFactor : null;
const price = rawPrice ? (rawPrice >= 50 ? Math.round(rawPrice / 5) * 5 : Math.round(rawPrice)) : null;
const priceLabel = price ? `от €${price}/м²` : svc.priceLabelRu;

/* ── Блоки цен ── */
const priceRows = priceRowsBySlug[svc.slug] ?? [];
const examples = (svc.priceUnit === 'sqm' && svc.priceFrom) ? (examplesBySlug[svc.slug] ?? []) : [];
const exPrice = (sqm: number) =>
  '€' + (Math.round(sqm * svc.priceFrom! * loc.priceFactor / 50) * 50).toLocaleString('ru-RU');

/* ── Реальные кейсы рядом (портфолио) ── */
/* Названия районов берём из русской коллекции портфолио — иначе фильтр
   не находит ни одного кейса и на страницу попадают английские отзывы. */
const areaMap: Record<string, string[]> = {
  'germasogeia':          ['Гермасогея'],
  'agios-tychonas':       ['Агиос Тихонас'],
  'limassol-marina':      ['Limassol Marina'],
  'limassol-city-centre': ['Центр города'],
  'potamos-germasogeias': ['Гермасогея'],
  'limassol':             ['Гермасогея', 'Агиос Тихонас', 'Limassol Marina', 'Центр города'],
};
const caseAreas = areaMap[loc.slug] ?? [];
const localCases = (await getCollection('portfolio_ru'))
  .filter(c => caseAreas.includes(c.data.area))
  .slice(0, 2);

let secN = 2;
const secPrices = priceRows.length || examples.length ? String(++secN).padStart(2, '0') : '';
const secCases  = localCases.length ? String(++secN).padStart(2, '0') : '';
const secFaq    = String(++secN).padStart(2, '0');

/* Фотографии */
const heroPhoto = categoryHero[svc.category];
const bandPhoto = locationPhoto[loc.slug] ?? categoryBand[svc.category];

const siblingServices = services
  .filter(s => s.slug !== svc.slug && (s.category === svc.category || svc.relatedSlugs.includes(s.slug)))
  .slice(0, 4);
const otherLocations = matrixLocations.filter(l => l.slug !== loc.slug);

/* Лимасол — базовый город: страница /uslugi/<svc> уже нацелена на него, и
   заголовки совпадают. Каноникал ведём на родительскую, чтобы страницы не
   конкурировали за один запрос. */
const canonical = loc.slug === 'limassol'
  ? `https://helyot.com/ru/uslugi/${svc.slug}`
  : undefined;

const title = `${svc.titleRu} ${loc.inRu}`;
const metaDesc = `${svc.titleRu} ${loc.inRu} — ${svc.priceLabelRu}, цена фиксируется в договоре, гарантия 5 лет. Бесплатный выезд за 48 часов.`;

const allFaqs = [...loc.faqsRu, ...svc.faqsRu];
const faqSchema = allFaqs.length ? {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: allFaqs.map(f => ({
    '@type': 'Question', name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: title,
  serviceType: svc.titleRu,
  description: metaDesc,
  areaServed: {
    '@type': loc.type === 'city' ? 'City' : 'Place',
    name: loc.nameEn,
    geo: { '@type': 'GeoCoordinates', latitude: loc.lat, longitude: loc.lng },
  },
  provider: {
    '@type': 'LocalBusiness',
    name: 'Helyot',
    url: 'https://helyot.com',
    telephone: '+357 97 499 231',
    address: { '@type': 'PostalAddress', addressLocality: 'Limassol', addressCountry: 'CY' },
  },
  ...(price ? { offers: { '@type': 'Offer', priceCurrency: 'EUR', price: String(price), unitText: 'за м²' } } : {}),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://helyot.com/ru' },
    { '@type': 'ListItem', position: 2, name: 'Услуги', item: 'https://helyot.com/ru/uslugi' },
    { '@type': 'ListItem', position: 3, name: svc.titleRu, item: `https://helyot.com/ru/uslugi/${svc.slug}` },
    { '@type': 'ListItem', position: 4, name: loc.nameRu },
  ],
};
---

<BaseLayout lang={lang} title={title} description={metaDesc} ogImage={heroPhoto} canonical={canonical} schema={serviceSchema}>
  <Fragment slot="head">
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <Header lang={lang} />
  <main style="background:#08080E;">

    <!-- ══ CINE HERO ═══════════════════════════════════════════ -->
    <section class="loc-hero vignette">
      <div class="loc-hero-bg cine-scene" aria-hidden="true">
        <img src={heroPhoto} alt="" loading="eager" fetchpriority="high" decoding="async"
          width="1600" height="1000" data-kenburns />
      </div>
      <div class="loc-hero-grade" aria-hidden="true"></div>
      <div class="container-wide" style="position:relative;z-index:2;">
        <nav aria-label="Breadcrumb" class="loc-bc">
          <a href="/ru">Главная</a>
          <span class="loc-bc-sep" aria-hidden="true">/</span>
          <span aria-current="page">{svc.titleRu}</span>
        </nav>

        <p class="cine-label" data-reveal>
          <span class="cine-label__index">{loc.type === 'city' ? 'Кипр' : 'Лимасол'}</span>
          {loc.nameRu}
        </p>

        <h1 class="cine-display loc-h1" data-words>
          {svc.titleRu} <em>{loc.inRu}</em>
        </h1>

        <div class="loc-hero-row">
          <p class="loc-sub" data-reveal data-reveal-delay="0.3">{svc.heroSubRu}</p>
          <div class="loc-hero-meta" data-reveal data-reveal-delay="0.45">
            <div class="loc-meta-item">
              <span class="loc-meta-lbl">Ориентир по цене</span>
              <span class="loc-meta-val">{priceLabel}</span>
            </div>
            <div class="loc-meta-item">
              <span class="loc-meta-lbl">Сроки</span>
              <span class="loc-meta-val">{svc.timelineRu}</span>
            </div>
          </div>
        </div>

        <div class="loc-ctas" data-reveal data-reveal-delay="0.6">
          <a href="#booking" class="loc-cta" data-magnetic>Бесплатная смета
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="https://wa.me/35797499231" target="_blank" rel="noopener" class="loc-cta loc-cta--ghost" data-magnetic>WhatsApp</a>
        </div>
      </div>
    </section>

    <!-- ══ LOCAL CONTEXT ═══════════════════════════════════════ -->
    <section class="loc-section">
      <div class="container-wide">
        <div class="loc-split">
          <div>
            <p class="cine-label" data-reveal><span class="cine-label__index">01</span>Район</p>
            <h2 class="loc-h2" data-reveal>Ремонт {loc.inRu}: что важно знать</h2>
            <p class="loc-body" data-reveal>{loc.introRu}</p>
          </div>
          <div>
            <h3 class="loc-h3" data-reveal>Что мы проверяем первым делом {loc.inRu}</h3>
            <ul class="loc-issues" data-stagger-group>
              {loc.issuesRu.map(issue => (
                <li data-stagger-item>
                  <span class="loc-issue-tick" aria-hidden="true">
                    <svg width="11" height="11" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="#E8B86D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  {issue}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ FULL-BLEED SCENE ════════════════════════════════════ -->
    <div class="loc-band cine-scene" aria-hidden="true">
      <img src={bandPhoto} alt="" loading="lazy" decoding="async"
        width="1600" height="900" data-parallax="0.18" />
      <div class="loc-band-caption">
        <span>{loc.nameRu}</span>
        <span class="loc-band-caption__rule"></span>
        <span>{svc.titleRu}</span>
      </div>
    </div>


    <!-- ══ LOCAL DETAIL ════════════════════════════════════════
         What differs about this kind of work in this specific area. Without it
         a service × location page is the service page with the name swapped. -->
    {angle && (
      <section class="loc-section loc-angle-sec">
        <div class="container-wide">
          <div class="loc-split">
            <div>
              <p class="cine-label" data-reveal><span class="cine-label__index">Местная специфика</span>{loc.nameRu}</p>
              <h2 class="loc-h2" data-reveal>{`${svc.titleRu} ${loc.inRu} — что меняется`}</h2>
              <p class="loc-body" data-reveal>{angle.ru}</p>
            </div>
            <div>
              <h3 class="loc-h3" data-reveal>Что обычно добавляется в смету здесь</h3>
              <ul class="loc-adds" data-stagger-group>
                {angle.addsRu.map(a => <li data-stagger-item>{a}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </section>
    )}
    <!-- ══ SCOPE ═══════════════════════════════════════════════ -->
    <section class="loc-section">
      <div class="container-wide">
        <p class="cine-label" data-reveal><span class="cine-label__index">02</span>Объём работ</p>
        <h2 class="loc-h2" data-reveal>Что входит в стоимость</h2>
        <div class="loc-inc" data-stagger-group>
          {svc.includesRu.map((item, i) => (
            <div class="loc-inc-item" data-stagger-item>
              <span class="loc-inc-n">{String(i + 1).padStart(2, '0')}</span>
              <span>{item}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ ЦЕНЫ ════════════════════════════════════════════════ -->
    {(priceRows.length > 0 || examples.length > 0) && (
      <section class="loc-section">
        <div class="container-wide">
          <p class="cine-label" data-reveal><span class="cine-label__index">{secPrices}</span>Цены</p>
          <h2 class="loc-h2" data-reveal>{svc.titleRu} {loc.inRu} — цены</h2>
        {angle.factorsRu && (
          <div class="loc-factors" data-reveal>
            <h3 class="loc-h3">Что меняет смету именно здесь</h3>
            <table class="loc-ftable">
              <thead><tr><th>Позиция</th><th>Почему</th><th>К смете</th></tr></thead>
              <tbody>
                {angle.factorsRu.map(f => (
                  <tr><td>{f.what}</td><td>{f.why}</td><td class="loc-fcost">{f.cost}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {notes.length > 0 && (
          <div class="loc-notes" data-stagger-group>
            <h3 class="loc-h3">Что учитываем именно здесь</h3>
            {notes.map(n => (
              <div class="loc-note" data-stagger-item>
                <span class="loc-note-tag">{traitLabel[n.trait] ?? n.trait}</span>
                {traitCtx[n.trait] && <span class="loc-note-ctx">{traitCtx[n.trait]}</span>}
                <p>{n.text}</p>
              </div>
            ))}
          </div>
        )}

          <div class="loc-price-grid">
            {priceRows.length > 0 && (
              <div>
                <h3 class="loc-h3" data-reveal>По видам работ</h3>
                <table class="loc-price-table">
                  <thead>
                    <tr><th>Вид работ</th><th>Цена</th></tr>
                  </thead>
                  <tbody>
                    {priceRows.map(row => (
                      <tr><td>{row.ru}</td><td>{row.priceRu}</td></tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {examples.length > 0 && (
              <div>
                <h3 class="loc-h3" data-reveal>Примеры смет {loc.inRu}</h3>
                <div class="loc-examples" data-stagger-group>
                  {examples.map((ex, i) => (
                    <div class="loc-example" data-stagger-item>
                      <span class="loc-example-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                      <span class="loc-example-obj">{ex.ru}</span>
                      <span class="loc-example-price"><small>от</small> {exPrice(ex.sqm)}</span>
                    </div>
                  ))}
                </div>
                <p class="loc-price-note">
                  Оценка по базовой ставке {priceLabel}. Письменная смета фиксируется
                  после бесплатного выезда — и больше не меняется.
                </p>
              </div>
            )}
          </div>
          {priceRows.length > 0 && (
            <p class="loc-price-note" style="margin-top:1.4rem;">
              Базовые ставки для Республики Кипр: работа + стандартные материалы,
              вывоз мусора включён. Скрытых доплат не бывает.
            </p>
          )}
        </div>
      </section>
    )}

    <!-- ══ РЕАЛЬНЫЕ ОБЪЕКТЫ РЯДОМ ══════════════════════════════ -->
    {localCases.length > 0 && (
      <section class="loc-section">
        <div class="container-wide">
          <p class="cine-label" data-reveal><span class="cine-label__index">{secCases}</span>Сдано рядом</p>
          <h2 class="loc-h2" data-reveal>Наши реальные проекты {loc.type === 'district' ? 'в этом районе' : loc.inRu}</h2>
          <div class="loc-cases" data-stagger-group>
            {localCases.map(c => (
              <a href={`/ru/portfolio/${c.slug}`} class="loc-case" data-stagger-item>
                <div class="loc-case-img cine-scene">
                  <img src={c.data.coverImage} alt={c.data.title} loading="lazy" width="640" height="420" />
                </div>
                <div class="loc-case-body">
                  <span class="loc-case-meta">{c.data.area} · {c.data.sqm} м² · {c.data.year}</span>
                  <h3 class="loc-case-title">{c.data.title}</h3>
                  {c.data.testimonial && (
                    <blockquote class="loc-case-quote">
                      «{c.data.testimonial.text}»
                      <cite>— {c.data.testimonial.author}</cite>
                    </blockquote>
                  )}
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ══ FAQ ═════════════════════════════════════════════════ -->
    <section class="loc-section">
      <div class="container-wide" style="max-width:760px;">
        <p class="cine-label" data-reveal><span class="cine-label__index">{secFaq}</span>Вопросы</p>
        <h2 class="loc-h2" data-reveal>{svc.titleRu} {loc.inRu} — частые вопросы</h2>
        <div class="loc-faq">
          {allFaqs.map(faq => (
            <details class="loc-faq-item">
              <summary>{faq.q}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ INTERLINKS ══════════════════════════════════════════ -->
    <section class="loc-section" style="border-bottom:none;">
      <div class="container-wide">
        <p class="loc-parent-link" data-reveal>
          Технология, процесс и полный объём работ — на основной странице услуги
          <a href={`/ru/uslugi/${svc.slug}`}>{svc.titleRu}</a>.
        </p>
        <div class="loc-links-grid">
          <div>
            <h3 class="loc-h3" data-reveal>Другие услуги {loc.inRu}</h3>
            <ul class="loc-links">
              {siblingServices.map(s => (
                <li><a href={`/ru/uslugi/${s.slug}/${loc.slug}`}>{s.titleRu} {loc.inRu}</a></li>
              ))}
              <li><a href={`/ru/remont/${loc.slug}`} style="color:#E8B86D;">Все услуги и цены {loc.inRu} →</a></li>
            </ul>
          </div>
          <div>
            <h3 class="loc-h3" data-reveal>{svc.titleRu} в других локациях</h3>
            <ul class="loc-links">
              {otherLocations.map(l => (
                <li><a href={`/ru/uslugi/${svc.slug}/${l.slug}`}>{l.nameRu}</a></li>
              ))}
            </ul>
          </div>
        </div>
        <p class="loc-service-area">
          Helyot работает на всей подконтрольной правительству территории Республики Кипр —
          Лимасол, Пафос, Ларнака, Никосия и свободный район Фамагусты (Айя-Напа, Протарас,
          Паралимни). Проекты на оккупированных северных территориях мы не выполняем.
        </p>
      </div>
    </section>

    <BookingForm lang={lang} />
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
.loc-hero {
  position: relative;
  padding: 9.5rem 0 4.5rem;
  border-bottom: 1px solid rgba(255,255,255,.07);
  background: #08080E;
  overflow: hidden;
}
.loc-hero-bg { position: absolute; inset: 0; z-index: 0; }
.loc-hero-bg img {
  width: 100%; height: 100%; object-fit: cover; object-position: center 40%;
}
.loc-hero-grade {
  position: absolute; inset: 0; z-index: 1;
  background:
    radial-gradient(ellipse 90% 70% at 80% -10%, rgba(232,184,109,.10) 0%, transparent 60%),
    linear-gradient(180deg, transparent 55%, rgba(8,8,14,.88) 100%),
    linear-gradient(100deg,
      rgba(8,8,14,.92) 0%,
      rgba(8,8,14,.78) 45%,
      rgba(8,8,14,.45) 75%,
      rgba(8,8,14,.22) 100%);
}

.loc-band {
  position: relative;
  height: clamp(300px, 48vh, 520px);
  border-bottom: 1px solid rgba(255,255,255,.07);
}
.loc-band img {
  width: 100%; height: 100%; object-fit: cover;
}
.loc-band::after {
  content: '';
  position: absolute; inset: 0; pointer-events: none;
  background: linear-gradient(180deg, rgba(8,8,14,.55) 0%, rgba(8,8,14,.08) 45%, rgba(8,8,14,.62) 100%);
}
.loc-band-caption {
  position: absolute; left: 0; right: 0; bottom: 1.6rem; z-index: 1;
  display: flex; align-items: center; justify-content: center; gap: 1.1rem;
  font-size: .64rem; letter-spacing: .3em; text-transform: uppercase; color: rgba(240,240,246,.85);
  text-shadow: 0 1px 12px rgba(4,4,8,.8);
}
.loc-band-caption__rule { width: 3rem; height: 1px; background: rgba(232,184,109,.7); }
/* Small and pinned above the headline block, matching every other hero */
.loc-bc {
  position: absolute;
  top: -5.2rem; left: 0;
  display: flex; align-items: center; gap: .3rem;
  font-family: 'Jost Variable', system-ui, sans-serif;
  font-size: 0.72rem; letter-spacing: .02em; color: #8288A5;
  flex-wrap: wrap;
}
.loc-bc a { color: #8288A5; text-decoration: none; transition: color .15s; }
.loc-bc a:hover { color: #9DA0B8; }
.loc-bc [aria-current="page"] { color: #8288A5; }
.loc-bc-sep { color: #8288A5; }
.loc-h1 { max-width: 20ch; margin: 1.4rem 0 2rem; text-shadow: 0 2px 32px rgba(4,4,8,.75); }
.loc-hero-row {
  display: flex; justify-content: space-between; align-items: flex-end;
  gap: 3rem; flex-wrap: wrap; margin-bottom: 2.2rem;
}
.loc-sub { font-size: .95rem; line-height: 1.75; color: #B8B8CC; max-width: 52ch; margin: 0; text-shadow: 0 1px 16px rgba(4,4,8,.8); }
.loc-hero-meta { display: flex; gap: 2.6rem; }
.loc-meta-item { display: flex; flex-direction: column; gap: .35rem; }
.loc-meta-lbl {
  font-size: .64rem; letter-spacing: .22em; text-transform: uppercase; color: #8288A5;
}
.loc-meta-val {
  font-family: 'Spectral', Georgia, serif;
  font-size: 1.25rem; font-weight: 500; color: #F0F0F6;
}
.loc-ctas { display: flex; gap: 1rem; flex-wrap: wrap; }
.loc-cta {
  display: inline-flex; align-items: center; gap: .55rem;
  padding: .95rem 2rem; border-radius:3px;
