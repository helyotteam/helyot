# Зависимости — ставятся из package-lock.json
node_modules/

# Сборка — Netlify собирает сам из исходников
dist/
.astro/
.netlify/

# Переменные окружения. Задаются в Netlify → Environment variables.
# .env.example коммитится как шаблон — см. отрицание ниже.
.env
.env.*
!.env.example

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Временное
.tmp/
.tmpcc/
*.log
npm-debug.log*

# Локальные разрешения Claude Code (машинозависимые).
# .claude/launch.json и settings.json коммитятся — они общие для проекта.
.claude/settings.local.json

# Редакторы
.vscode/
.idea/
*.swp
