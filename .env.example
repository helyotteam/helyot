# Helyot — deploy environment variables
# Copy to .env (local) or set in Netlify → Site settings → Environment variables.

# Google Analytics 4 property ID. Leave empty to disable analytics entirely.
# Format: G-XXXXXXXXXX. Analytics loads only after cookie consent (GDPR).
PUBLIC_GA_ID=

# Lead delivery (Netlify function send-lead) — set these in Netlify env, not here in git.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
