---
import { t, type Lang } from '../../i18n/ui';
interface Props { lang: Lang; limit?: number; }
const { lang, limit = 9 } = Astro.props;
const tr = (k: string) => t(lang, k as any);

const items = [
  { src: '/images/gallery/apartment-after-1.webp',  before: '/images/gallery/apartment-before-1.webp', type: 'apartment', labelEn: '2BR Apartment · Germasogeia',       labelRu: 'Квартира 2+1 · Гермасогея', sqm: 95  },
  { src: '/images/gallery/bathroom-after-1.webp',   before: '/images/gallery/bathroom-before-1.webp',  type: 'bathroom',  labelEn: 'Master Bath · City Centre',         labelRu: 'Ванная · Центр города',      sqm: 8   },
  { src: '/images/gallery/kitchen-after-1.webp',    before: '/images/gallery/kitchen-before-1.webp',   type: 'kitchen',   labelEn: 'Modern Kitchen · Agios Tychonas',   labelRu: 'Кухня · Агиос Тихонас',     sqm: 14  },
  { src: '/images/gallery/villa-after-1.webp',      before: '/images/gallery/villa-before-1.webp',     type: 'villa',     labelEn: 'Villa Renovation · Potamos',        labelRu: 'Вилла · Потамос',            sqm: 280 },
  { src: '/images/gallery/office-after-1.webp',     before: '/images/gallery/office-before-1.webp',    type: 'office',    labelEn: 'Tech Office · City Centre',         labelRu: 'Офис · Центр города',        sqm: 240 },
  { src: '/images/gallery/apartment-after-2.webp',  before: '/images/gallery/apartment-before-2.webp', type: 'apartment', labelEn: 'Penthouse · Marina',                labelRu: 'Пентхаус · Марина',          sqm: 180 },
  { src: '/images/gallery/bathroom-after-2.webp',   before: '/images/gallery/bathroom-before-2.webp',  type: 'bathroom',  labelEn: 'Spa Bathroom · Germasogeia',        labelRu: 'Ванная спа · Гермасогея',    sqm: 10  },
  { src: '/images/gallery/kitchen-after-2.webp',    before: '/images/gallery/kitchen-before-2.webp',   type: 'kitchen',   labelEn: 'Gourmet Kitchen · Potamos',         labelRu: 'Кухня гурман · Потамос',     sqm: 18  },
  { src: '/images/gallery/villa-after-2.webp',      before: '/images/gallery/villa-before-2.webp',     type: 'villa',     labelEn: 'Hillside Villa · Agios Tychonas',   labelRu: 'Вилла · Агиос Тихонас',     sqm: 320 },
].slice(0, limit);

const filters = [
  { key: 'all',       label: tr('gallery.all') },
  { key: 'apartment', label: tr('gallery.apartment') },
  { key: 'villa',     label: tr('gallery.villa') },
  { key: 'office',    label: tr('gallery.office') },
  { key: 'kitchen',   label: tr('gallery.kitchen') },
  { key: 'bathroom',  label: tr('gallery.bathroom') },
];
---

<section id="gallery" style="background:#0E1320;border-top:1px solid rgba(255,255,255,.07);" class="py-24">
  <div class="container-wide">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10 reveal">
      <div>
        <p class="section-label mb-3">{lang==='en'?'OUR WORK':'НАШИ РАБОТЫ'}</p>
        <h2 class="font-display font-bold text-[#F5F6FA]"
            style="font-size:clamp(1.8rem,3.5vw,2.5rem);letter-spacing:-0.02em;">
          {tr('gallery.title')}
        </h2>
        <p class="text-[#A9AFC0] mt-2">{tr('gallery.sub')}</p>
      </div>
      <a href="/en/gallery" class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#E8B86D] hover:gap-3 transition-all group hidden md:inline-flex">
        {lang==='en'?'View full gallery':'Вся галерея'}
        <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </a>
    </div>

    <!-- Filter tabs -->
    <div class="flex flex-wrap gap-2 mb-8 reveal" role="group" aria-label="Gallery filter">
      {filters.map((f) => (
        <button
          data-filter={f.key}
          class="gallery-filter text-sm font-medium rounded-[9px] px-4 py-2 transition-all"
          style={f.key==='all'
            ? 'background:transparent;border:1.5px solid #E8B86D;color:#E8B86D;'
            : 'background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.10);color:#9AA1B5;'}
          aria-pressed={f.key==='all'?'true':'false'}
        >
          {f.label}
        </button>
      ))}
    </div>

    <!-- Grid -->
    <div id="gallery-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {items.map((item, i) => (
        <div
          class="gallery-item group cursor-pointer reveal"
          data-type={item.type}
          style={`animation-delay:${i*0.05}s;background:#161C2C;border:1px solid rgba(255,255,255,.08);border-radius:20px;overflow:hidden;transition:border-color 0.3s,transform 0.3s,box-shadow 0.3s;`}
        >
          <div class="relative aspect-[4/3] overflow-hidden">
            <img src={item.src}    alt={lang==='en'?item.labelEn:item.labelRu} width="600" height="450" loading="lazy"
                 class="absolute inset-0 w-full h-full object-cover transition-all duration-500 group-hover:opacity-0 group-hover:scale-105" />
            <img src={item.before} alt={`${lang==='en'?item.labelEn:item.labelRu} — before`} width="600" height="450" loading="lazy"
                 class="absolute inset-0 w-full h-full object-cover transition-all duration-500 opacity-0 group-hover:opacity-100" />
            <!-- Labels -->
            <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-xs font-bold group-hover:opacity-0 transition-opacity"
                  style="background:rgba(232,184,109,0.9);color:#121219;">AFTER</span>
            <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-xs font-bold opacity-0 group-hover:opacity-100 transition-opacity"
                  style="background:rgba(255,255,255,0.12);color:white;backdrop-filter:blur(4px);">BEFORE</span>
          </div>
          <div class="p-4 flex items-center justify-between">
            <div>
              <p class="font-semibold text-[#F5F6FA] text-sm">{lang==='en'?item.labelEn:item.labelRu}</p>
              <p class="text-[#9AA1B5] text-xs mt-0.5">{item.sqm} m²</p>
            </div>
            <span class="text-xs px-2.5 py-1 rounded-full capitalize"
                  style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);color:#9AA1B5;">
              {item.type}
            </span>
          </div>
        </div>
      ))}
    </div>

    <div class="text-center mt-8 md:hidden reveal">
      <a href="/en/gallery" class="btn-outline text-sm">{lang==='en'?'View full gallery':'Вся галерея'}</a>
    </div>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.gallery-filter');
  const items = document.querySelectorAll<HTMLDivElement>('.gallery-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'all';
      filterBtns.forEach((b) => {
        b.setAttribute('aria-pressed','false');
        b.style.background = 'rgba(255,255,255,.04)';
        b.style.border     = '1px solid rgba(255,255,255,.10)';
        b.style.color      = '#9AA1B5';
      });
      btn.setAttribute('aria-pressed','true');
      btn.style.background = '#E8B86D';
      btn.style.border     = 'none';
      btn.style.color      = '#1C1917';
      items.forEach((item) => {
        const show = filter === 'all' || item.dataset.type === filter;
        item.style.display = show ? '' : 'none';
      });
    });
  });
</script>
