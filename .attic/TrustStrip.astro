---
import { type Lang } from '../../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const en = lang === 'en';

const cells = en ? [
  { countTo: 50, suffix: '+', label: 'projects completed', title: 'Fixed price.\nIn writing.', body: 'Agreed before a wall comes down — stays that way to the final invoice.' },
  { countTo: 15, suffix: '+', label: 'years in Limassol', title: 'One team.\nEvery day.',   body: 'The same five or six people start to finish. Walk in unannounced.' },
  { countTo: 48, suffix: 'h', label: 'warranty response', title: 'On site\nin 48 hours.',  body: 'Something fails after handover? Technician on site. No call-out fee.' }
] : [
  { countTo: 50, suffix: '+', label: 'проектов сдано',    title: 'Фиксированная\nцена. Письменно.', body: 'Согласована до начала работ — не меняется до финального счёта.' },
  { countTo: 15, suffix: '+', label: 'лет в Лимасоле',   title: 'Одна команда.\nКаждый день.',    body: 'Одни и те же пять-шесть человек. Зайдите без предупреждения.' },
  { countTo: 48, suffix: 'ч', label: 'гарантийный выезд', title: 'На объекте\nза 48 часов.',     body: 'Что-то вышло из строя? Техник на месте. Без платы за выезд.' }
];
---

<!-- Animations only — all layout uses inline styles to guarantee application -->
<style>
  .tc-rule {
    height: 2px;
    width: 2.5rem;
    background: linear-gradient(to right, #3D6E50, rgba(61,110,80,0));
    transform: scaleX(0);
    transform-origin: left center;
    margin: 1.75rem 0 1.5rem;
  }
  /* Reveal class added by JS — Emil: translateY + opacity, ease-out, no scale(0) */
  .tc-cell {
    opacity: 0;
    transform: translateY(14px);
  }
  .tc-cell.vis {
    opacity: 1;
    transform: translateY(0);
    transition: opacity .7s cubic-bezier(.16,1,.3,1),
                transform .7s cubic-bezier(.16,1,.3,1);
  }
  .tc-cell.vis .tc-rule {
    transform: scaleX(1);
    transition: transform .55s cubic-bezier(.16,1,.3,1) .3s;
  }
  /* Hover — pointer devices only */
  @media (hover: hover) and (pointer: fine) {
    .tc-cell { transition: background .3s ease; }
    .tc-cell:hover { background: rgba(255,255,255,.025) !important; }
    .tc-cell:hover .tc-num { color: #fff !important; }
    .tc-num { transition: color .25s ease; }
  }
  /* Light theme */
  [data-theme="light"] #trust                { background: #EBE6DF !important; }
  [data-theme="light"] .tc-bento            { background: rgba(28,25,23,.1) !important; }
  [data-theme="light"] .tc-cell             { background: #FFFFFF !important; }
  [data-theme="light"] .tc-cell:hover       { background: #F9F7F5 !important; }
  [data-theme="light"] .tc-ghost            { color: rgba(28,25,23,.04) !important; }
  [data-theme="light"] .tc-num              { color: #1C1917 !important; }
  [data-theme="light"] .tc-label            { color: #78716C !important; }
  [data-theme="light"] .tc-title            { color: #1C1917 !important; }
  [data-theme="light"] .tc-body             { color: #44403C !important; }
  [data-theme="light"] .tc-eyebrow          { color: #3D6E50 !important; }
  [data-theme="light"] .tc-cell.vis .tc-rule { background: linear-gradient(to right, #3D6E50, rgba(61,110,80,0)) !important; }
  /* Dot grid — invert for light */
  [data-theme="light"] #trust [style*="radial-gradient(circle,rgba(255,255,255,.018)"] {
    background-image: radial-gradient(circle, rgba(28,25,23,.022) 1px, transparent 1px) !important;
  }
  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .tc-cell, .tc-cell.vis { opacity: 1 !important; transform: none !important; transition: none !important; }
    .tc-rule, .tc-cell.vis .tc-rule { transform: scaleX(1) !important; transition: none !important; }
  }
  /* Mobile */
  @media (max-width: 767px) {
    .tc-eyebrow { font-size: .58rem !important; }
    .tc-section-title { font-size: clamp(1.6rem, 6vw, 2rem) !important; }
  }
</style>

<section id="trust" style="position:relative;background:#07070F;border-top:1px solid rgba(255,255,255,.06);overflow:hidden;">

  <!-- Dot-grid texture -->
  <div aria-hidden="true" style="position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,.018) 1px,transparent 1px);background-size:44px 44px;pointer-events:none;z-index:0;"></div>
  <!-- Sage green bottom bloom -->
  <div aria-hidden="true" style="position:absolute;bottom:-20%;left:50%;transform:translateX(-50%);width:1000px;height:500px;border-radius:50%;background:radial-gradient(ellipse,rgba(61,110,80,.09) 0%,transparent 68%);pointer-events:none;z-index:0;"></div>

  <div class="container-wide" style="position:relative;z-index:1;padding-top:5rem;padding-bottom:5.5rem;">

    <!-- Header -->
    <div class="tc-cell" data-tc="hdr" style="opacity:0;transform:translateY(14px);margin-bottom:3.5rem;">
      <p class="tc-eyebrow" style="font-size:.58rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:#3D6E50;margin:0 0 1rem;">
        {en ? 'OUR COMMITMENT' : 'НАША ГАРАНТИЯ'}
      </p>
      <h2 class="tc-section-title" style="font-family:'Playfair Display',font-family:'Spectral',Georgia,serif;font-size:clamp(2rem,3.5vw,2.8rem);font-weight:700;letter-spacing:-.03em;line-height:1.18;color:#F0F0F6;margin:0;">
        {en
          ? <><span>Three things</span><br/><em style="font-style:italic;color:rgba(255,255,255,.4);">we put in writing.</em></>
          : <><span>Три пункта,</span><br/><em style="font-style:italic;color:rgba(255,255,255,.4);">которые мы фиксируем письменно.</em></>
        }
      </h2>
    </div>

    <!-- Bento grid -->
    <div class="tc-bento" id="tc-bento"
         style="display:grid;grid-template-columns:3fr 2fr;grid-template-rows:1fr 1fr;gap:1.5px;background:rgba(255,255,255,.07);border-radius:20px;overflow:hidden;">

      <!-- Cell 0 — LARGE (spans both rows) -->
      <div class="tc-cell" data-tc="0" data-count-to={cells[0].countTo} data-suffix={cells[0].suffix}
           style="grid-row:1/3;grid-column:1;background:#0A0A15;padding:3rem 3rem 3rem;position:relative;overflow:hidden;opacity:0;transform:translateY(14px);display:flex;flex-direction:column;justify-content:flex-end;min-height:340px;">
        <!-- Ghost number -->
        <span class="tc-ghost" aria-hidden="true"
              style="position:absolute;top:-1rem;right:-1rem;font-family:'Playfair Display',Georgia,serif;font-size:clamp(9rem,20vw,16rem);font-weight:900;font-style:italic;line-height:1;color:rgba(255,255,255,.03);pointer-events:none;user-select:none;letter-spacing:-.05em;">
          {cells[0].countTo}
        </span>
        <!-- Content -->
        <div style="position:relative;z-index:1;">
          <span class="tc-num" style="display:block;font-family:'Playfair Display',Georgia,serif;font-size:clamp(4.5rem,10vw,8rem);font-weight:700;font-style:italic;line-height:1;letter-spacing:-.05em;color:#F0F0F6;" data-counter="0">
            0{cells[0].suffix}
          </span>
          <p class="tc-label" style="font-size:.6rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#7878A0;margin:.5rem 0 0;">
            {cells[0].label}
          </p>
          <div class="tc-rule"></div>
          <h3 class="tc-title" style="font-family:'Playfair Display',font-family:'Spectral',Georgia,serif;font-size:clamp(1.1rem,2vw,1.4rem);font-weight:700;letter-spacing:-.02em;line-height:1.3;color:#F0F0F6;margin:0 0 .875rem;white-space:pre-line;">
            {cells[0].title}
          </h3>
          <p class="tc-body" style="font-size:.875rem;color:#7878A0;line-height:1.7;margin:0;max-width:30ch;">
            {cells[0].body}
          </p>
        </div>
      </div>

      <!-- Cell 1 — small top right -->
      <div class="tc-cell" data-tc="1" data-count-to={cells[1].countTo} data-suffix={cells[1].suffix}
           style="grid-row:1;grid-column:2;background:#0C0C18;padding:2.25rem 2.25rem 2rem;position:relative;overflow:hidden;opacity:0;transform:translateY(14px);">
        <span class="tc-ghost" aria-hidden="true"
              style="position:absolute;top:-.5rem;right:-.5rem;font-family:'Playfair Display',Georgia,serif;font-size:clamp(5rem,12vw,9rem);font-weight:900;font-style:italic;line-height:1;color:rgba(255,255,255,.03);pointer-events:none;user-select:none;letter-spacing:-.05em;">
          {cells[1].countTo}
        </span>
        <div style="position:relative;z-index:1;">
          <span class="tc-num" style="display:block;font-family:'Playfair Display',Georgia,serif;font-size:clamp(3rem,6vw,4.5rem);font-weight:700;font-style:italic;line-height:1;letter-spacing:-.05em;color:#F0F0F6;" data-counter="1">
            0{cells[1].suffix}
          </span>
          <p class="tc-label" style="font-size:.6rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#7878A0;margin:.4rem 0 0;">
            {cells[1].label}
          </p>
          <div class="tc-rule"></div>
          <h3 class="tc-title" style="font-family:'Playfair Display',font-family:'Spectral',Georgia,serif;font-size:clamp(.95rem,1.5vw,1.1rem);font-weight:700;letter-spacing:-.015em;line-height:1.3;color:#F0F0F6;margin:0 0 .625rem;white-space:pre-line;">
            {cells[1].title}
          </h3>
          <p class="tc-body" style="font-size:.82rem;color:#7878A0;line-height:1.7;margin:0;">
            {cells[1].body}
          </p>
        </div>
      </div>

      <!-- Cell 2 — small bottom right -->
      <div class="tc-cell" data-tc="2" data-count-to={cells[2].countTo} data-suffix={cells[2].suffix}
           style="grid-row:2;grid-column:2;background:#090914;padding:2.25rem 2.25rem 2rem;position:relative;overflow:hidden;border-top:1.5px solid rgba(255,255,255,.07);opacity:0;transform:translateY(14px);">
        <span class="tc-ghost" aria-hidden="true"
              style="position:absolute;top:-.5rem;right:-.5rem;font-family:'Playfair Display',Georgia,serif;font-size:clamp(5rem,12vw,9rem);font-weight:900;font-style:italic;line-height:1;color:rgba(255,255,255,.03);pointer-events:none;user-select:none;letter-spacing:-.05em;">
          {cells[2].countTo}
        </span>
        <div style="position:relative;z-index:1;">
          <span class="tc-num" style="display:block;font-family:'Playfair Display',Georgia,serif;font-size:clamp(3rem,6vw,4.5rem);font-weight:700;font-style:italic;line-height:1;letter-spacing:-.05em;color:#F0F0F6;" data-counter="2">
            0{cells[2].suffix}
          </span>
          <p class="tc-label" style="font-size:.6rem;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#7878A0;margin:.4rem 0 0;">
            {cells[2].label}
          </p>
          <div class="tc-rule"></div>
          <h3 class="tc-title" style="font-family:'Playfair Display',font-family:'Spectral',Georgia,serif;font-size:clamp(.95rem,1.5vw,1.1rem);font-weight:700;letter-spacing:-.015em;line-height:1.3;color:#F0F0F6;margin:0 0 .625rem;white-space:pre-line;">
            {cells[2].title}
          </h3>
          <p class="tc-body" style="font-size:.82rem;color:#7878A0;line-height:1.7;margin:0;">
            {cells[2].body}
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<script is:inline>
(function () {
  function easeOutExpo(t) { return t === 1 ? 1 : 1 - Math.pow(2, -10 * t); }

  function countUp(numEl, target, suffix, duration) {
    var start = null;
    function step(ts) {
      if (!start) start = ts;
      var p = Math.min((ts - start) / duration, 1);
      numEl.textContent = Math.round(easeOutExpo(p) * target) + suffix;
      if (p < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  /* Responsive bento grid */
  function fixBento() {
    var b = document.getElementById('tc-bento');
    if (!b) return;
    var w = window.innerWidth;
    if (w < 640) {
      b.style.gridTemplateColumns = '1fr';
      b.style.gridTemplateRows = 'auto';
      /* reset cell row/col spans */
      var cells = b.querySelectorAll('.tc-cell[data-tc]');
      cells.forEach(function(c) {
        c.style.gridRow = 'auto';
        c.style.gridColumn = 'auto';
        c.style.minHeight = 'auto';
      });
    } else {
      b.style.gridTemplateColumns = '3fr 2fr';
      b.style.gridTemplateRows = '1fr 1fr';
      var large = b.querySelector('[data-tc="0"]');
      if (large) { large.style.gridRow = '1/3'; large.style.gridColumn = '1'; large.style.minHeight = '340px'; }
      var sm1 = b.querySelector('[data-tc="1"]');
      if (sm1) { sm1.style.gridRow = '1'; sm1.style.gridColumn = '2'; }
      var sm2 = b.querySelector('[data-tc="2"]');
      if (sm2) { sm2.style.gridRow = '2'; sm2.style.gridColumn = '2'; }
    }
  }
  fixBento();
  window.addEventListener('resize', fixBento);

  /* Reveal + count-up on scroll */
  var allCells = Array.from(document.querySelectorAll('[data-tc]'));

  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (!entry.isIntersecting) return;
      var el = entry.target;
      var idx = el.getAttribute('data-tc');
      var delay = idx === 'hdr' ? 0 : (parseInt(idx, 10) + 1) * 60; /* stagger 60ms */

      setTimeout(function () {
        el.classList.add('vis');
        /* Count-up for stat cells */
        var countTo = el.getAttribute('data-count-to');
        if (countTo) {
          var numEl = el.querySelector('[data-counter]');
          if (numEl) countUp(numEl, parseInt(countTo, 10), el.getAttribute('data-suffix') || '', 1200);
        }
      }, delay);

      io.unobserve(el);
    });
  }, { threshold: 0.08 });

  allCells.forEach(function (c) { io.observe(c); });
})();
</script>
