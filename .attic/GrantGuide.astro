---
import { t, type Lang } from '../../i18n/ui';
import Button from '../ui/Button.astro';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const tr = (k: string) => t(lang, k as any);

const points = lang === 'en' ? [
  { icon: '€', title: 'Up to €10,000', desc: 'Maximum individual grant for energy renovation under the Cyprus SAVE scheme.' },
  { icon: '☀️', title: 'Solar Panels', desc: 'Up to 40% subsidy for photovoltaic installation through EAC and the Energy Service.' },
  { icon: '🌡️', title: 'Heat Pumps', desc: '30–50% grant for air-to-water or ground-source heat pump installations.' },
  { icon: '🏠', title: 'Insulation', desc: 'Roof, wall and floor insulation can be partially covered under the SAVE programme.' },
] : [
  { icon: '€', title: 'До €10 000', desc: 'Максимальный индивидуальный грант на энергетический ремонт по программе SAVE Кипра.' },
  { icon: '☀️', title: 'Солнечные панели', desc: 'До 40% субсидии на установку фотовольтаики через EAC и Службу энергетики.' },
  { icon: '🌡️', title: 'Тепловые насосы', desc: '30–50% грант на установку воздушно-водяных или геотермальных тепловых насосов.' },
  { icon: '🏠', title: 'Утепление', desc: 'Утепление кровли, стен и пола частично покрывается по программе SAVE.' },
];
---

<section id="grants" class="py-24 bg-gradient-to-b from-brand-900/20 to-gray-950">
  <div class="container-wide">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="reveal">
        <span class="section-eyebrow">{lang === 'en' ? 'EU-backed grants' : 'Субсидии ЕС'}</span>
        <h2 class="section-title">{tr('grant.title')}</h2>
        <p class="text-gray-400 mb-8">{tr('grant.sub')}</p>
        <Button href={lang === 'ru' ? '/ru/uslugi/energy-modernization' : '/en/services/energy-modernization'} size="lg">
          {tr('grant.cta')}
        </Button>
      </div>

      <div class="grid grid-cols-2 gap-4 reveal" style="animation-delay: 0.15s">
        {points.map((p, i) => (
          <div class="glass-card-brand p-6 reveal" style={`animation-delay: ${i * 0.1}s`}>
            <div class="text-3xl font-bold text-brand-300 mb-3">{p.icon}</div>
            <h3 class="font-display font-bold text-white mb-2 text-sm">{p.title}</h3>
            <p class="text-gray-400 text-xs leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
