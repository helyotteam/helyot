---
import { t, type Lang } from '../../i18n/ui';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const tr = (k: string) => t(lang, k as any);
const e = lang === 'en';

/* ── The questions clients actually ask before signing ───────────────── */
const questions = e ? [
  { q:'Will the price change once work begins?',
    a:'No. It’s fixed in writing before a single wall comes down — and it stays that way through to the final invoice.' },
  { q:'Whose hands are actually on my project?',
    a:'You’ll know their faces by the end of week one — because it’s the same five or six people every day, not a rotating cast of borrowed crews. Walk onto your site any morning, unannounced, and you’ll recognise everyone standing in it.' },
  { q:'What happens if something fails after handover?',
    a:'A technician is on site within 48 hours of your message — no callout fee, no “we’ll need to check with the supplier first.” That’s the difference between a warranty that exists on paper and one with an actual phone number behind it.' },
  { q:'How long before someone actually picks up?',
    a:'About fifteen minutes, seven days a week. Not “within 1–3 business days” — that’s someone else’s voicemail.' },
  { q:'Who deals with permits and approvals?',
    a:'We do, start to finish. You’ll never stand in a queue at the municipality on our account.' },
] : [
  { q:'Изменится ли цена после начала работ?',
    a:'Нет. Она фиксируется письменно до того, как снесена первая стена — и остаётся такой до финального счёта.' },
  { q:'Кто на самом деле работает на моём объекте?',
    a:'Вы запомните их в лицо уже к концу первой недели — потому что это одни и те же пять-шесть человек каждый день, а не сменные бригады со стороны. Зайдите на объект в любое утро без предупреждения — и узнаете каждого, кто там работает.' },
  { q:'А если что-то выйдет из строя после сдачи?',
    a:'Техник будет на месте в течение 48 часов после вашего сообщения — без платы за выезд и без «нужно уточнить у поставщика». Вот разница между гарантией на бумаге и гарантией, за которой стоит реальный номер телефона.' },
  { q:'Сколько ждать, если я позвоню?',
    a:'Около пятнадцати минут, семь дней в неделю. Не «в течение 1–3 рабочих дней» — это автоответчик у других.' },
  { q:'Кто занимается разрешениями и согласованиями?',
    a:'Мы — от начала до конца. Вам не придётся стоять в очереди в муниципалитете из-за нас.' },
];

/* ── Real results — compact infographic (no cards) ────────────────────── */
const results = e ? [
  { icon:'trend',    stat:'+32%',    label:'value increase — Agios Tychonas Villa' },
  { icon:'home',     stat:'+58%',    label:'Airbnb income — Germasogeia Apartment' },
  { icon:'calendar', stat:'Day 42',  label:'delivered on schedule — City Centre HQ' },
] : [
  { icon:'trend',    stat:'+32%',    label:'рост стоимости — вилла Агиос Тихонас' },
  { icon:'home',     stat:'+58%',    label:'доход Airbnb — квартира Гермасогея' },
  { icon:'calendar', stat:'День 42', label:'сдан точно в срок — офис в центре города' },
];

/* ── Result icons (feather-style, inner markup only) ──────────────────── */
const resultIcons: Record<string,string> = {
  trend:    '<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>',
  home:     '<path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
  calendar: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="M9 16l2 2 4-4"/>',
};

/* ── Core guarantees ─────────────────────────────────────────────────── */
const guarantees = e ? [
  { num:'50+',  label:'Projects completed' },
  { num:'15+',  label:'Years experience' },
  { num:'5 yr', label:'Structural warranty' },
  { num:'98%',  label:'On-time delivery' },
  { num:'35',   label:'In-house specialists' },
  { num:'4.9★', label:'Google rating' },
] : [
  { num:'50+',   label:'Проектов сдано' },
  { num:'15+',   label:'Лет опыта' },
  { num:'5 лет', label:'Гарантия конструктив' },
  { num:'98%',   label:'Сдача в срок' },
  { num:'35',    label:'Штатных специалистов' },
  { num:'4.9★',  label:'Рейтинг Google' },
];
---

<!-- ══ §A: STATS STRIP ══════════════════════════════════════════════════ -->
<section style="background:#0E1320;border-top:1px solid rgba(255,255,255,.07);">
  <div class="container-wide">
    <div class="guar-strip" id="wy-stats">
      {guarantees.map((s,i) => (
        <div class="wy-fade guar-item" data-wyi={i}>
          <span class="guar-num">{s.num}</span>
          <span class="guar-label">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ══ §B: MAIN WHY HELYOT SECTION ══════════════════════════════════════ -->
<section style="position:relative;background:#0E1320;border-top:1px solid rgba(255,255,255,.07);border-bottom:1px solid rgba(255,255,255,.07);overflow:hidden;" id="why" class="py-20">

  <!-- Abstract atmosphere — no photo: layered colour blooms + fine dot-grid texture -->
  <div aria-hidden="true" style="position:absolute;inset:0;background:
      radial-gradient(ellipse 50% 45% at 12% 8%,  rgba(232,184,109,.08) 0%, transparent 62%),
      radial-gradient(ellipse 55% 50% at 92% 86%, rgba(232,184,109,.05) 0%, transparent 60%);
      pointer-events:none;"></div>
  <div aria-hidden="true" style="position:absolute;inset:0;background-image:radial-gradient(circle, rgba(255,255,255,.025) 1px, transparent 1px);background-size:40px 40px;pointer-events:none;"></div>

  <!-- Ghost question mark — graphic accent behind the Q&A column -->
  <p aria-hidden="true" style="position:absolute;top:-3.5rem;right:2%;margin:0;font-family:Spectral,Georgia,system-ui,sans-serif;font-weight:800;font-size:clamp(18rem,30vw,28rem);line-height:1;color:rgba(255,255,255,.03);letter-spacing:-.06em;pointer-events:none;user-select:none;">?</p>

  <!-- Gold bloom — bottom left warmth -->
  <div aria-hidden="true" class="wy-blob" style="position:absolute;bottom:-12%;left:-6%;width:640px;height:640px;border-radius:50%;background:radial-gradient(ellipse,rgba(232,184,109,.12) 0%,transparent 60%);pointer-events:none;"></div>

  <!-- Top + bottom fades -->
  <div aria-hidden="true" style="position:absolute;top:0;left:0;right:0;height:100px;background:linear-gradient(to bottom,#0E1320,transparent);pointer-events:none;"></div>
  <div aria-hidden="true" style="position:absolute;bottom:0;left:0;right:0;height:120px;background:linear-gradient(to top,#0E1320,transparent);pointer-events:none;"></div>

  <div class="container-wide" style="position:relative;z-index:1;">

    <!-- Header + compact Q&A — two-column layout, no cards -->
    <div style="display:grid;grid-template-columns:1fr 1.35fr;gap:3.5rem;align-items:start;margin-bottom:2.5rem;" id="wy-header">

      <!-- Left: intro + results infographic -->
      <div class="wy-fade">
        <p class="section-label mb-4">{e?'WHY HELYOT':'ПОЧЕМУ HELYOT'}</p>
        <h2 class="font-display font-bold text-[#F5F6FA] leading-tight" style="font-size:clamp(1.8rem,3.5vw,2.5rem);letter-spacing:-.025em;margin:0 0 1.25rem;">
          {e ? <>Five questions.<br/><span style="color:#E8B86D;">Five answers you can hold us to.</span></> : <>Пять вопросов.<br/><span style="color:#E8B86D;">Пять ответов, за которые мы отвечаем.</span></>}
        </h2>
        <p class="text-[#A9AFC0] text-base leading-relaxed">
          {e
            ? 'Every renovation conversation in Limassol comes down to the same handful of questions, eventually. Most contractors talk around them. Here is exactly how we answer — in writing, before you sign anything.'
            : 'Любой разговор о ремонте в Лимасоле рано или поздно сводится к одним и тем же вопросам. Большинство подрядчиков уходят от прямого ответа. Вот как отвечаем мы — письменно, до того как вы подпишете договор.'}
        </p>

        <!-- Real results — compact infographic, no cards -->
        <div style="margin-top:2rem;padding-top:1.75rem;border-top:1px solid rgba(255,255,255,.08);">
          <p style="font-size:.75rem;font-weight:700;text-transform:uppercase;letter-spacing:.12em;color:#E8B86D;margin:0 0 1.375rem;">
            {e?'Real results from real projects':'Реальные результаты реальных проектов'}
          </p>
          {results.map((r, i) => (
            <div style={`position:relative;display:flex;gap:1rem;align-items:flex-start;padding-bottom:${i===results.length-1?'0':'1.375rem'};`}>
              {i < results.length - 1 && (
                <div aria-hidden="true" style="position:absolute;left:1.375rem;top:2.75rem;bottom:0;width:1px;background:linear-gradient(to bottom,rgba(232,184,109,.3),rgba(232,184,109,.05));"></div>
              )}
              <div style="position:relative;z-index:1;width:2.75rem;height:2.75rem;border-radius:9px;background:rgba(232,184,109,.08);border:1px solid rgba(232,184,109,.22);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:#E8B86D;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={resultIcons[r.icon]} aria-hidden="true"></svg>
              </div>
              <div>
                <p style="font-family:Spectral,Georgia,serif;font-weight:800;font-size:1.5rem;color:#F5F6FA;line-height:1.1;margin:0;">{r.stat}</p>
                <p style="font-size:.8rem;color:#9AA1B5;line-height:1.5;margin:.25rem 0 0;">{r.label}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: compact Q&A list -->
      <div>
        {questions.map((item, i) => (
          <div class="wy-fade" data-wyd={`${0.06 + i * 0.06}s`}
               style={`padding:${i===0?'0 0 1.1rem':'1.1rem 0'};${i===questions.length-1?'border-bottom:none;':'border-bottom:1px solid rgba(255,255,255,.07);'}`}>
            <p style="font-family:Spectral,Georgia,system-ui,sans-serif;font-weight:600;font-size:1rem;color:#F5F6FA;letter-spacing:-.01em;line-height:1.4;margin:0 0 .4rem;">
              <span style="color:#E8B86D;font-weight:800;font-size:.7rem;letter-spacing:.08em;margin-right:.5rem;">{`0${i + 1}`}</span>{item.q}
            </p>
            <p style="font-size:.85rem;color:#A9AFC0;line-height:1.68;margin:0;">
              <span style="color:#E8B86D;font-weight:700;">Helyot — </span>{item.a}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- ── BOTTOM: CTA + trust statement ───────────────────────────── -->
    <div style="display:flex;align-items:center;justify-content:space-between;gap:2rem;flex-wrap:wrap;padding-top:2.5rem;border-top:1px solid rgba(255,255,255,.08);" id="wy-bottom" class="wy-fade" data-wyd="0.42s">
      <div>
        <p style="font-size:.78rem;color:#9AA1B5;margin-bottom:.35rem;">
          {e?"Got a question we didn’t answer here?":"Остался вопрос, на который мы не ответили?"}
        </p>
        <p style="font-family:Spectral,Georgia,serif;font-weight:700;font-size:1.05rem;color:#F5F6FA;">
          {e?"Ask us directly — we’ll walk you through realistic timelines, material options and pricing before you commit to anything.":"Спросите нас напрямую — разберём реальные сроки, варианты материалов и стоимость, прежде чем вы примете решение."}
        </p>
      </div>
      <a href="#booking" class="btn-gold" style="flex-shrink:0;">
        {tr('misc.freeEstimate')}
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  /* Scroll reveal — JS-driven opacity (Emil: always visible as fallback) */
  (function() {
    const items = document.querySelectorAll<HTMLElement>('.wy-fade');
    items.forEach(el => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(20px)';
    });
    function reveal(el: HTMLElement) {
      const d = el.dataset.wyd ?? '0s';
      setTimeout(() => {
        el.style.opacity = '1';
        el.style.transform = 'none';
      }, parseFloat(d) * 1000);
    }
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        reveal(el);
        io.unobserve(el);
      });
    }, { threshold: 0.06, rootMargin: '0px 0px -40px 0px' });
    items.forEach(el => io.observe(el));

    /* Safety net — fast flings/swipes can make the IntersectionObserver
       skip a threshold crossing, leaving an item permanently invisible
       (and an empty-looking gap on mobile). On every scroll frame, force-
       reveal anything that has already entered the viewport. */
    let ticking = false;
    function sweepVisible() {
      items.forEach(el => {
        if (el.style.opacity === '0') {
          const r = el.getBoundingClientRect();
          if (r.top < window.innerHeight && r.bottom > 0) {
            io.unobserve(el);
            // Caught mid-flight by the safety net — the entrance moment has
            // already passed, so show it instantly rather than re-staggering.
            el.style.opacity = '1';
            el.style.transform = 'none';
          }
        }
      });
      ticking = false;
    }
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(sweepVisible);
    }, { passive: true });

    /* Stagger stats */
    document.querySelectorAll<HTMLElement>('[data-wyi]').forEach((el, i) => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(16px)';
      setTimeout(() => {
        el.style.opacity = '1';
        el.style.transform = 'none';
      }, 200 + i * 70);
    });

    /* Responsive grids */
    function fixWy() {
      const w = window.innerWidth;
      const stats = document.getElementById('wy-stats');
      if (stats) stats.style.gridTemplateColumns = w < 640 ? 'repeat(2,1fr)' : w < 900 ? 'repeat(3,1fr)' : 'repeat(6,1fr)';
      const hdr = document.getElementById('wy-header');
      if (hdr) hdr.style.gridTemplateColumns = w < 900 ? '1fr' : '1fr 1.35fr';
    }
    fixWy(); window.addEventListener('resize', fixWy);
  })();
</script>
