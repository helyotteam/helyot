---
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; }
const strings = t(Astro.props.lang);
const c = strings.contact;
---

<section id="contact" class="py-20 bg-white">
  <div class="max-w-2xl mx-auto px-4">
    <h2 class="text-3xl font-bold text-center mb-3">{c.title}</h2>
    <p class="text-gray-500 text-center mb-10">{c.subtitle}</p>

    <form
      id="contact-form"
      novalidate
      class="space-y-5"
    >
      <!-- Honeypot anti-spam -->
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

      <div>
        <label for="cf-name" class="block text-sm font-medium text-gray-700 mb-1">{c.namePlaceholder}</label>
        <input
          id="cf-name"
          type="text"
          name="name"
          required
          autocomplete="name"
          placeholder={c.namePlaceholder}
          class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand-500"
        />
        <p id="cf-name-err" class="hidden text-red-500 text-xs mt-1">{c.validation.name}</p>
      </div>

      <div>
        <label for="cf-email" class="block text-sm font-medium text-gray-700 mb-1">{c.emailPlaceholder}</label>
        <input
          id="cf-email"
          type="email"
          name="email"
          autocomplete="email"
          placeholder={c.emailPlaceholder}
          class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand-500"
        />
        <p id="cf-email-err" class="hidden text-red-500 text-xs mt-1">{c.validation.email}</p>
      </div>

      <div>
        <label for="cf-phone" class="block text-sm font-medium text-gray-700 mb-1">{c.phonePlaceholder}</label>
        <input
          id="cf-phone"
          type="tel"
          name="phone"
          required
          autocomplete="tel"
          placeholder="+357 97 499 231"
          class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand-500"
        />
        <p id="cf-phone-err" class="hidden text-red-500 text-xs mt-1">{c.validation.phone}</p>
      </div>

      <div>
        <label for="cf-message" class="block text-sm font-medium text-gray-700 mb-1">{c.messagePlaceholder}</label>
        <textarea
          id="cf-message"
          name="message"
          rows="4"
          placeholder={c.messagePlaceholder}
          class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-brand-500 resize-none"
        ></textarea>
      </div>

      <div id="cf-success" class="hidden bg-green-50 border border-green-300 text-green-800 rounded-lg px-5 py-4 text-sm font-medium text-center">
        {c.success}
      </div>

      <button
        type="submit"
        id="cf-submit"
        class="w-full bg-brand-500 hover:bg-brand-600 text-white font-semibold py-4 rounded-xl transition-colors text-lg"
      >
        {c.submit}
      </button>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (!form) throw new Error('contact-form not found');

  function validateEmail(v: string) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.trim());
  }
  function validatePhone(v: string) {
    return /^\+?[\d\s\-()]{7,20}$/.test(v.trim());
  }
  function setError(id: string, show: boolean) {
    document.getElementById(id)?.classList.toggle('hidden', !show);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Honeypot check
    const gotcha = form.querySelector<HTMLInputElement>('[name="_gotcha"]');
    if (gotcha?.value) return;

    const nameEl = form.querySelector<HTMLInputElement>('#cf-name');
    const emailEl = form.querySelector<HTMLInputElement>('#cf-email');
    const phoneEl = form.querySelector<HTMLInputElement>('#cf-phone');

    let valid = true;

    if (!nameEl?.value.trim()) { setError('cf-name-err', true); valid = false; }
    else setError('cf-name-err', false);

    if (emailEl?.value && !validateEmail(emailEl.value)) { setError('cf-email-err', true); valid = false; }
    else setError('cf-email-err', false);

    if (!phoneEl?.value || !validatePhone(phoneEl.value)) { setError('cf-phone-err', true); valid = false; }
    else setError('cf-phone-err', false);

    if (!valid) return;

    const btn = document.getElementById('cf-submit') as HTMLButtonElement;
    btn.disabled = true;

    const payload = Object.fromEntries(new FormData(form));
    delete payload['_gotcha'];

    try {
      const res = await fetch('/.netlify/functions/send-lead', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: 'contact', ...payload }),
      });
      if (!res.ok) throw new Error('Network error');
    } catch {
      // Silently fail — still show success to user
    }

    form.reset();
    btn.disabled = false;
    const success = document.getElementById('cf-success');
    success?.classList.remove('hidden');
    setTimeout(() => success?.classList.add('hidden'), 8000);
  });
</script>
