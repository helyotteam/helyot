---
import { t, getAlternateUrl, type Lang } from '../i18n';
interface Props { lang: Lang; currentPath?: string; }
const { lang, currentPath = '/' } = Astro.props;
const strings = t(lang);
const nav = strings.nav;
const alternateLang: Lang = lang === 'en' ? 'ru' : 'en';
const alternateUrl = getAlternateUrl(Astro.url, alternateLang);
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100 shadow-sm">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex items-center justify-between h-16 gap-4">
      <!-- Logo -->
      <a href={lang === 'ru' ? '/ru' : '/'} class="text-xl font-bold text-gray-900 shrink-0">
        {strings.site.name}
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-gray-600">
        <a href={lang === 'ru' ? '/ru#services' : '/#services'} class="hover:text-brand-600 transition-colors">{nav.services}</a>
        <a href={lang === 'ru' ? '/ru/blog' : '/blog'} class="hover:text-brand-600 transition-colors">{nav.blog}</a>
        <a href="#contact" class="hover:text-brand-600 transition-colors">{nav.contacts}</a>
      </nav>

      <div class="flex items-center gap-3">
        <!-- Language toggle -->
        <a
          href={alternateUrl}
          class="text-xs font-semibold uppercase tracking-wide border border-gray-200 hover:border-brand-400 px-2.5 py-1 rounded-lg text-gray-600 hover:text-brand-600 transition-colors"
          aria-label={alternateLang === 'ru' ? 'Switch to Russian' : 'Switch to English'}
        >
          {alternateLang.toUpperCase()}
        </a>

        <!-- CTA -->
        <a
          href="#booking"
          class="hidden md:inline-flex bg-brand-500 hover:bg-brand-600 text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors"
        >
          {nav.bookCall}
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-lg text-gray-600 hover:text-gray-900 hover:bg-gray-100 transition-colors"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white">
    <nav class="flex flex-col px-4 py-4 gap-4 text-sm font-medium text-gray-700">
      <a href={lang === 'ru' ? '/ru#services' : '/#services'} class="hover:text-brand-600">{nav.services}</a>
      <a href={lang === 'ru' ? '/ru/blog' : '/blog'} class="hover:text-brand-600">{nav.blog}</a>
      <a href="#contact" class="hover:text-brand-600">{nav.contacts}</a>
      <a href="/en/careers" class="hover:text-brand-600">{nav.careers}</a>
      <a
        href="#booking"
        class="inline-flex bg-brand-500 text-white font-semibold px-4 py-2 rounded-lg w-fit"
      >{nav.bookCall}</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
