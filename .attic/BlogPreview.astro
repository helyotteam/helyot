---
import { t, type Lang } from '../../i18n/ui';
import { getBlogPosts } from '../../lib/content';
interface Props { lang: Lang; limit?: number; }
const { lang, limit = 3 } = Astro.props;
const tr = (k: string) => t(lang, k as any);
const posts = (await getBlogPosts(lang)).slice(0, limit);
---

<section style="background:#0E1320;border-top:1px solid rgba(255,255,255,.07);" class="py-24">
  <div class="container-wide">
    <div class="flex items-end justify-between gap-6 mb-12 reveal">
      <div>
        <p class="section-label mb-3">{lang==='en'?'FROM HELYOT':'ОТ HELYOT'}</p>
        <h2 class="font-display font-bold text-[#F5F6FA]"
            style="font-size:clamp(1.8rem,3.5vw,2.5rem);letter-spacing:-0.02em;">{tr('blog.title')}</h2>
      </div>
      <a href={lang==='ru'?'/ru/blog':'/en/blog'}
         class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#E8B86D] hover:gap-3 transition-all group hidden md:inline-flex">
        {tr('blog.allPosts')}
        <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      </a>
    </div>

    {posts.length === 0 ? (
      <p class="text-[#9AA1B5] text-center py-12">{lang==='en'?'Articles coming soon.':'Статьи скоро появятся.'}</p>
    ) : (
      <div class="grid md:grid-cols-3 gap-5">
        {posts.map((post, i) => (
          <a href={lang==='ru'?`/ru/blog/${post.slug}`:`/en/blog/${post.slug}`}
             class="group block no-underline reveal" style={`animation-delay:${i*0.1}s`}>
            <article style="background:#161C2C;border:1px solid rgba(255,255,255,.08);border-radius:20px;overflow:hidden;transition:border-color 0.3s,transform 0.3s,box-shadow 0.3s;"
                     class="group-hover:-translate-y-1 group-hover:border-[rgba(232,184,109,0.4)] h-full flex flex-col">
              <!-- Image or placeholder -->
              <div class="aspect-video overflow-hidden" style="background:rgba(255,255,255,.04);">
                {post.data.ogImage
                  ? <img src={post.data.ogImage} alt={post.data.title} width="600" height="338" loading="lazy"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-80" />
                  : <div class="w-full h-full flex items-center justify-center text-5xl">📝</div>}
              </div>
              <div class="p-6 flex flex-col flex-1">
                <!-- Tags -->
                <div class="flex flex-wrap gap-1.5 mb-3">
                  {post.data.tags?.slice(0,2).map(tag => (
                    <span style="background:rgba(232,184,109,0.08);color:#E8B86D;border:1px solid rgba(232,184,109,0.15);"
                          class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium">{tag}</span>
                  ))}
                </div>
                <h3 class="font-display text-base font-semibold text-[#F5F6FA] mb-2 line-clamp-2 group-hover:text-[#E8B86D] transition-colors leading-snug flex-1">
                  {post.data.title}
                </h3>
                <p class="text-[#A9AFC0] text-xs line-clamp-2 mb-4">{post.data.description}</p>
                <div class="flex items-center justify-between text-xs text-[#9AA1B5]" style="border-top:1px solid rgba(255,255,255,.07);padding-top:0.75rem;">
                  <time datetime={post.data.publishedDate}>{post.data.publishedDate}</time>
                  {post.data.minuteRead && <span>{post.data.minuteRead} {tr('blog.minRead')}</span>}
                </div>
              </div>
            </article>
          </a>
        ))}
      </div>
    )}

    <div class="text-center mt-8 md:hidden reveal">
      <a href={lang==='ru'?'/ru/blog':'/en/blog'} class="btn-outline text-sm">{tr('blog.allPosts')}</a>
    </div>
  </div>
</section>
