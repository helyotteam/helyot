---
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; }
const strings = t(Astro.props.lang);
const ts = strings.testimonials;

function renderStars(rating: number) {
  return Array.from({ length: 5 }, (_, i) =>
    i < rating ? '★' : '☆'
  ).join('');
}

const aggregateRatingSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: strings.site.name,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: ts.averageRating,
    reviewCount: ts.reviewCount,
    bestRating: '5',
    worstRating: '1',
  },
  review: ts.items.map((item) => ({
    '@type': 'Review',
    reviewRating: { '@type': 'Rating', ratingValue: item.rating },
    author: { '@type': 'Person', name: item.name },
    reviewBody: item.text,
    datePublished: item.date,
  })),
};
---

<section id="testimonials" class="py-20 bg-gray-50">
  <script type="application/ld+json" set:html={JSON.stringify(aggregateRatingSchema)} />

  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl font-bold text-center mb-3">{ts.title}</h2>
    <p class="text-gray-500 text-center mb-6">{ts.subtitle}</p>

    <!-- Aggregate rating display -->
    <div class="flex items-center justify-center gap-3 mb-10">
      <span class="text-yellow-400 text-2xl tracking-tight">★★★★★</span>
      <span class="text-2xl font-bold">{ts.averageRating}</span>
      <span class="text-gray-400 text-sm">({ts.reviewCount} reviews)</span>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {ts.items.map((item) => (
        <article class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
          <div class="flex items-center justify-between mb-3">
            <p class="font-semibold text-gray-900">{item.name}</p>
            <span class="text-yellow-400 text-lg" aria-label={`Rating: ${item.rating} out of 5`}>
              {renderStars(item.rating)}
            </span>
          </div>
          <p class="text-gray-600 text-sm leading-relaxed">{item.text}</p>
          <time class="text-gray-400 text-xs mt-3 block" datetime={item.date}>{item.date}</time>
        </article>
      ))}
    </div>

    <div class="text-center mt-10">
      <a
        href={strings.site.googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-white border border-gray-200 hover:border-brand-400 text-gray-700 hover:text-brand-600 font-medium px-6 py-3 rounded-xl shadow-sm transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
        </svg>
        {ts.readAll}
      </a>
    </div>
  </div>
</section>
