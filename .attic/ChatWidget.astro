---
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; }
const strings = t(Astro.props.lang);
const whatsapp = strings.site.whatsapp;
const phone = strings.site.phone;
---

<!-- Visible on md+ screens only -->
<div id="chat-widget" class="hidden md:flex fixed bottom-6 right-6 z-40 flex-col items-end gap-3">
  <!-- WhatsApp button -->
  <a
    href={`https://wa.me/${whatsapp}?text=Hello%2C%20I%27m%20interested%20in%20renovation%20services`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="WhatsApp"
    class="group flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white rounded-full shadow-lg transition-all duration-200 px-4 py-3"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
      <path d="M12 0C5.373 0 0 5.373 0 12c0 2.125.555 4.122 1.528 5.855L0 24l6.335-1.652A11.954 11.954 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.003-1.375l-.36-.214-3.727.977.994-3.637-.235-.374A9.818 9.818 0 1112 21.818z"/>
    </svg>
    <span class="text-sm font-medium">WhatsApp</span>
  </a>

  <!-- Phone button -->
  <a
    href={`tel:${phone.replace(/\s/g, '')}`}
    aria-label={phone}
    class="flex items-center gap-2 bg-brand-500 hover:bg-brand-600 text-white rounded-full shadow-lg transition-all duration-200 px-4 py-3"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 shrink-0" viewBox="0 0 24 24" fill="currentColor">
      <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
    </svg>
    <span class="text-sm font-medium">{phone}</span>
  </a>
</div>
