---
import { t, type Lang } from '../../i18n/ui';
import Button from '../ui/Button.astro';
import { wallColors } from '../../lib/arConfig';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const tr = (k: string) => t(lang, k as any);
---

<section id="ar-color" class="py-24 bg-gray-950/60">
  <div class="container-wide">
    <div class="text-center mb-12 reveal">
      <span class="section-eyebrow">{lang === 'en' ? 'Try before you paint' : 'Примерь перед покраской'}</span>
      <h2 class="section-title">{tr('ar.title')}</h2>
      <p class="section-subtitle mx-auto">{tr('ar.sub')}</p>
    </div>

    <div class="glass-card p-6 md:p-8 max-w-4xl mx-auto reveal" style="animation-delay: 0.1s">
      <div class="grid md:grid-cols-2 gap-8">
        <!-- Upload zone -->
        <div>
          <div
            id="ar-drop-zone"
            class="border-2 border-dashed border-white/20 hover:border-accent-500/50 rounded-2xl p-8 text-center cursor-pointer transition-colors"
          >
            <div id="ar-placeholder">
              <div class="text-4xl mb-3">🖼️</div>
              <p class="text-white font-medium mb-1">{tr('ar.upload')}</p>
              <p class="text-gray-500 text-sm">{tr('ar.or')} (JPG, PNG, WebP, max 10MB)</p>
              <input id="ar-file" type="file" accept="image/jpeg,image/png,image/webp" class="hidden" aria-label={tr('ar.upload')} />
            </div>
          </div>

          <!-- Canvas output -->
          <div id="ar-canvas-wrap" class="hidden mt-4 relative rounded-2xl overflow-hidden">
            <canvas id="ar-canvas" class="w-full block rounded-2xl"></canvas>
            <div class="absolute inset-0 flex items-center justify-center" id="ar-processing" style="display:none!important">
              <div class="glass-card px-4 py-2 text-sm text-white">{tr('misc.loading')}</div>
            </div>
          </div>
        </div>

        <!-- Controls -->
        <div class="space-y-6">
          <!-- Color palette -->
          <div>
            <p class="form-label">{tr('ar.chooseColor')}</p>
            <div class="grid grid-cols-6 gap-2">
              {wallColors.map((color) => (
                <button
                  data-color={JSON.stringify({ r: color.r, g: color.g, b: color.b })}
                  data-name={lang === 'ru' ? color.nameRu : color.nameEn}
                  class="ar-color-btn w-full aspect-square rounded-xl border-2 border-transparent hover:border-white/50
                         hover:scale-110 transition-all focus-visible:ring-2 focus-visible:ring-white"
                  style={`background-color: ${color.hex}`}
                  aria-label={lang === 'ru' ? color.nameRu : color.nameEn}
                  title={lang === 'ru' ? color.nameRu : color.nameEn}
                ></button>
              ))}
            </div>
            <p id="ar-color-name" class="text-gray-400 text-sm mt-2 text-center"></p>
          </div>

          <!-- Intensity slider -->
          <div>
            <label for="ar-intensity" class="form-label">{tr('ar.intensity')}: <span id="ar-intensity-val">60</span>%</label>
            <input
              id="ar-intensity"
              type="range"
              min="10"
              max="90"
              value="60"
              class="w-full accent-accent-500"
            />
          </div>

          <!-- Action buttons -->
          <div class="space-y-3">
            <button
              id="ar-download"
              class="btn-primary w-full justify-center disabled:opacity-40"
              disabled
              aria-label={tr('ar.download')}
            >
              ⬇️ {tr('ar.download')}
            </button>
            <Button href="#booking" class="w-full justify-center" variant="secondary">
              🖌️ {tr('ar.order')}
            </Button>
            <button id="ar-reset" class="btn-ghost w-full justify-center text-gray-400">
              {tr('ar.reset')}
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const dropZone    = document.getElementById('ar-drop-zone') as HTMLDivElement;
  const fileInput   = document.getElementById('ar-file') as HTMLInputElement;
  const canvasWrap  = document.getElementById('ar-canvas-wrap') as HTMLDivElement;
  const canvas      = document.getElementById('ar-canvas') as HTMLCanvasElement;
  const ctx         = canvas?.getContext('2d');
  const intensityEl = document.getElementById('ar-intensity') as HTMLInputElement;
  const intensityVal= document.getElementById('ar-intensity-val');
  const downloadBtn = document.getElementById('ar-download') as HTMLButtonElement;
  const resetBtn    = document.getElementById('ar-reset');
  const colorNameEl = document.getElementById('ar-color-name');

  let originalImageData: ImageData | null = null;
  let selectedColor = { r: 245, g: 245, b: 245 }; // default white
  let intensity = 0.6;

  // Drop zone click
  dropZone?.addEventListener('click', () => fileInput?.click());
  dropZone?.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('border-accent-500/70'); });
  dropZone?.addEventListener('dragleave', () => dropZone.classList.remove('border-accent-500/70'));
  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-accent-500/70');
    const file = e.dataTransfer?.files[0];
    if (file) loadImage(file);
  });

  fileInput?.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) loadImage(file);
  });

  function loadImage(file: File) {
    if (file.size > 10 * 1024 * 1024) { alert('File too large (max 10MB)'); return; }
    const reader = new FileReader();
    reader.onload = (e) => {
      const img = new Image();
      img.onload = () => {
        const MAX = 1200;
        const scale = Math.min(1, MAX / Math.max(img.width, img.height));
        canvas.width  = Math.round(img.width  * scale);
        canvas.height = Math.round(img.height * scale);
        ctx!.drawImage(img, 0, 0, canvas.width, canvas.height);
        originalImageData = ctx!.getImageData(0, 0, canvas.width, canvas.height);
        canvasWrap.classList.remove('hidden');
        dropZone.querySelector('#ar-placeholder')!.innerHTML = `<p class="text-green-400 text-sm">✅ Image loaded. Choose a colour.</p>`;
        applyColor();
      };
      img.src = e.target?.result as string;
    };
    reader.readAsDataURL(file);
  }

  function applyColor() {
    if (!originalImageData || !ctx) return;
    const copy = new ImageData(new Uint8ClampedArray(originalImageData.data), originalImageData.width, originalImageData.height);
    const d = copy.data;
    const { r, g, b } = selectedColor;
    const alpha = intensity;

    for (let i = 0; i < d.length; i += 4) {
      d[i]     = Math.round(d[i]     * (1 - alpha) + r * alpha);
      d[i + 1] = Math.round(d[i + 1] * (1 - alpha) + g * alpha);
      d[i + 2] = Math.round(d[i + 2] * (1 - alpha) + b * alpha);
    }
    ctx.putImageData(copy, 0, 0);
    downloadBtn.disabled = false;
  }

  // Colour buttons
  document.querySelectorAll<HTMLButtonElement>('.ar-color-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.ar-color-btn').forEach((b) => b.classList.remove('ring-2', 'ring-white', 'scale-110'));
      btn.classList.add('ring-2', 'ring-white', 'scale-110');
      selectedColor = JSON.parse(btn.dataset.color ?? '{"r":245,"g":245,"b":245}');
      if (colorNameEl) colorNameEl.textContent = btn.dataset.name ?? '';
      applyColor();
    });
  });

  intensityEl?.addEventListener('input', () => {
    intensity = parseInt(intensityEl.value, 10) / 100;
    if (intensityVal) intensityVal.textContent = intensityEl.value;
    applyColor();
  });

  downloadBtn?.addEventListener('click', () => {
    const link = document.createElement('a');
    link.download = 'wall-color-preview.png';
    link.href = canvas.toDataURL('image/png');
    link.click();
  });

  resetBtn?.addEventListener('click', () => {
    if (!originalImageData || !ctx) return;
    ctx.putImageData(originalImageData, 0, 0);
    downloadBtn.disabled = true;
    if (colorNameEl) colorNameEl.textContent = '';
    document.querySelectorAll('.ar-color-btn').forEach((b) => b.classList.remove('ring-2', 'ring-white', 'scale-110'));
  });
</script>
