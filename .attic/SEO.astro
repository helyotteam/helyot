---
import { t, locales, getAlternatePath, type Lang } from '../../i18n/ui';
import { getCanonical, SITE } from '../../i18n/routing';

interface Props {
  lang:         Lang;
  title:        string;
  description:  string;
  ogImage?:     string;
  ogType?:      string;
  noindex?:     boolean;
  schema?:      object | object[];
}

const {
  lang, title, description,
  ogImage   = '/images/og/og-default.jpg',
  ogType    = 'website',
  noindex   = false,
  schema,
} = Astro.props;

const pageTitle   = `${title} | ${t(lang, 'site.name')}`;
const canonical   = Astro.url.href.split('?')[0].replace(/\/$/, '');
const ogImageAbs  = ogImage.startsWith('http') ? ogImage : `${SITE}/${ogImage.replace(/^\//, '')}`;
const altLang: Lang = lang === 'en' ? 'ru' : 'en';
const altHref   = `${SITE}${getAlternatePath(Astro.url, altLang)}`;
const curHref   = `${SITE}${getAlternatePath(Astro.url, lang)}`;

const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---

<title>{pageTitle}</title>
<meta name="description"       content={description} />
{noindex && <meta name="robots" content="noindex,nofollow" />}

<link rel="canonical"  href={canonical} />
<link rel="alternate"  hreflang={locales[lang].hreflang}    href={curHref} />
<link rel="alternate"  hreflang={locales[altLang].hreflang} href={altHref} />
<link rel="alternate"  hreflang="x-default"                  href={`${SITE}/`} />

<meta property="og:type"              content={ogType} />
<meta property="og:title"             content={pageTitle} />
<meta property="og:description"       content={description} />
<meta property="og:image"             content={ogImageAbs} />
<meta property="og:image:width"       content="1200" />
<meta property="og:image:height"      content="630" />
<meta property="og:url"               content={canonical} />
<meta property="og:site_name"         content={t(lang, 'site.name')} />
<meta property="og:locale"            content={locales[lang].locale} />
<meta property="og:locale:alternate"  content={locales[altLang].locale} />

<meta name="twitter:card"        content="summary_large_image" />
<meta name="twitter:title"       content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image"       content={ogImageAbs} />

{schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
